---
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleLearningControls from '../components/ArticleLearningControls.astro';
import ArticleLearningLinks from '../components/ArticleLearningLinks.astro';
import ApproachComparison from '../components/ApproachComparison.astro';
import EngineeringConnection from '../components/EngineeringConnection.astro';
import JDoodlePractice from '../components/JDoodlePractice.astro';
import KnowledgeCheck from '../components/KnowledgeCheck.astro';
import MoveZeroesTrace from '../components/MoveZeroesTrace.astro';
import PostCard from '../components/PostCard.astro';
import PostBanner from '../components/PostBanner.astro';
import RecursionCallStack from '../components/RecursionCallStack.astro';
import SubsetBacktracking from '../components/SubsetBacktracking.astro';
import { SITE } from '../data/site';
import { ENGINEERING_CONNECTIONS } from '../data/engineeringConnections';
import { ARTICLE_LEARNING_LINKS } from '../data/articleLearningLinks';
import { APPROACH_COMPARISONS } from '../data/approachComparisons';
import { KNOWLEDGE_CHECKS } from '../data/knowledgeChecks';
import { getPracticeProblem } from '../data/practiceProblems';
import { DSA_SECTIONS } from '../data/learningPaths';
import type { Post } from '../lib/posts';
import { estimateReadTime, formatDate, formatDifficulty, getPostSlug, getTopicForPost } from '../lib/posts';
import { getPostBanner } from '../lib/postBanners';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  previous?: Post;
  next?: Post;
  related?: Post[];
  hasContent?: boolean;
}

const {
  post,
  headings,
  previous,
  next,
  related = [],
  hasContent = true,
} = Astro.props;

const topic = getTopicForPost(post);
const dsaSection = topic.slug === 'dsa' && post.data.series
  ? DSA_SECTIONS.find((section) => section.slug === post.data.series)
  : undefined;
const parentHref = dsaSection ? `/dsa/${dsaSection.slug}/` : `/topics/${topic.slug}/`;
const parentLabel = dsaSection?.title ?? topic.shortTitle;
const postSlug = getPostSlug(post);
const interactive = post.data.interactive
  ?? (postSlug === 'recursion-in-java-beginners-guide' ? 'recursion-call-stack' : undefined);
const practiceProblem = getPracticeProblem(postSlug);
const isSubsetsPractice = postSlug === 'subsets-in-java';
const isMoveZeroesPractice = postSlug === 'move-zeroes-to-end';
const engineeringConnection = ENGINEERING_CONNECTIONS[postSlug];
const learningLinks = ARTICLE_LEARNING_LINKS[postSlug];
const knowledgeQuestions = KNOWLEDGE_CHECKS[postSlug];
const approachComparison = APPROACH_COMPARISONS[postSlug];
const sectionHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
// Keep every major section reachable in long guides without crowding the sidebar.
const tocHeadings = sectionHeadings.length > 36
  ? sectionHeadings.filter((heading) => heading.depth === 2)
  : sectionHeadings;
const description = post.data.description || `Practical notes and examples for ${post.data.title}.`;
const articleUrl = `${SITE.url}/posts/${postSlug}/`;
const banner = getPostBanner(post);
const coverImage = banner.custom
  ? await getImage({ src: banner.image, width: 1200, format: 'webp', quality: 85 })
  : undefined;
const socialImage = post.data.image ?? coverImage?.src ?? banner.imageUrl;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  mainEntityOfPage: articleUrl,
  image: new URL(socialImage, Astro.site ?? SITE.url).href,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/about/`,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={socialImage}
  imageAlt={banner.alt}
  type="article"
  bodyClass="article-page"
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <div class="article-shell section-wrap">
    <article class="article-main">
      <Breadcrumbs
        items={[
          { label: 'Atlas', href: '/' },
          { label: parentLabel, href: parentHref },
          { label: post.data.title },
        ]}
      />

      <header class="article-header">
        <div class="article-chip-row">
          <a class={`topic-chip topic-${topic.accent}`} href={parentHref}>
            {topic.number} / {parentLabel}
          </a>
          {post.data.difficulty && (
            <span class={`difficulty difficulty-${post.data.difficulty}`}>{formatDifficulty(post.data.difficulty)}</span>
          )}
          {post.data.contentType && <span class="content-type-chip">{post.data.contentType}</span>}
        </div>
        <h1>{post.data.title}</h1>
        <p>{description}</p>
        <div class="article-byline">
          <img
            class="author-mini"
            src="/images/rahul-avatar.png"
            alt={SITE.author}
            width="38"
            height="38"
          />
          <div>
            <strong>{SITE.author}</strong>
            <span>{formatDate(post.data.date)} · {estimateReadTime(post)} min read</span>
          </div>
          <button type="button" class="share-button" data-copy-link>Copy link</button>
        </div>
        <PostBanner {post} variant="hero" />
        <ArticleLearningControls {post} sectionLabel={parentLabel} />
      </header>

      <div class="article-divider">
        <span>FIELD NOTE / {postSlug.toUpperCase().replaceAll('-', '_')}</span>
        <i></i>
      </div>

      {hasContent ? (
        <div class="article-content">
          {practiceProblem && <JDoodlePractice problem={practiceProblem} />}
          {practiceProblem ? (
            <>
              <details class="practice-solution" data-practice-solution>
                <summary>
                  <span>WHEN YOU ARE READY</span>
                  <strong>Show the explanation and complete solution</strong>
                  <small>Your original article, Java solution, complexity analysis and dry run are preserved here.</small>
                </summary>
                <div class="practice-solution-content">
                  <slot />
                  {isMoveZeroesPractice && <MoveZeroesTrace />}
                  {isSubsetsPractice && <SubsetBacktracking />}
                  {approachComparison && <ApproachComparison comparison={approachComparison} />}
                  {engineeringConnection && <EngineeringConnection {...engineeringConnection} />}
                  {learningLinks && <ArticleLearningLinks links={learningLinks} />}
                </div>
              </details>
              {knowledgeQuestions && <KnowledgeCheck articleSlug={postSlug} questions={knowledgeQuestions} />}
              <nav class="dsa-learning-destinations" aria-label="DSA learning tools">
                {post.data.patterns?.slice(0, 2).map((pattern) => (
                  <a href={`/dsa/patterns/${pattern}/`}>Review {pattern.replaceAll('-', ' ')}</a>
                ))}
                <a href="/dsa/revision/">Open revision cards</a>
              </nav>
            </>
          ) : (
            <>
              <slot />
              {interactive === 'recursion-call-stack' && <RecursionCallStack />}
              {engineeringConnection && <EngineeringConnection {...engineeringConnection} />}
              {learningLinks && <ArticleLearningLinks links={learningLinks} />}
            </>
          )}
        </div>
      ) : (
        <div class="article-empty-state">
          <span>MAP IN PROGRESS</span>
          <h2>This field note is being charted.</h2>
          <p>The original placeholder has been preserved. The full lesson will be developed during the content phase.</p>
          <a class="button button-secondary" href={`/topics/${topic.slug}/`}>Explore {topic.shortTitle}</a>
        </div>
      )}

      <footer class="article-end">
        <div>
          <span>END OF FIELD NOTE</span>
          <p>Found something unclear? Connect with Rahul and help make the map better.</p>
        </div>
        <a href={SITE.linkedin}>Discuss on LinkedIn ↗</a>
      </footer>

      {(previous || next) && (
        <nav class="post-navigation" aria-label="Article navigation">
          {previous ? (
            <a href={`/posts/${getPostSlug(previous)}/`}>
              <span>← Previous note</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : <span></span>}
          {next && (
            <a href={`/posts/${getPostSlug(next)}/`}>
              <span>Next note →</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>

    <aside class="article-aside">
      <div class="toc-card">
        <div class="toc-heading">
          <span>ON THIS MAP</span>
          <span>{String(tocHeadings.length).padStart(2, '0')}</span>
        </div>
        {tocHeadings.length > 0 ? (
          <nav aria-label="Table of contents">
            {tocHeadings.map((heading) => (
              <a class:list={[`toc-depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        ) : (
          <p class="toc-empty">A detailed table of contents will appear as this note grows.</p>
        )}
      </div>
      <div class="aside-note">
        <span>ATLAS PRINCIPLE</span>
        <p>Understand the invariant before memorizing the implementation.</p>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="related-section section-wrap">
      <div class="section-heading section-heading-notes">
        <div>
          <p class="section-index">CONTINUE EXPLORING</p>
          <h2>Related field notes.</h2>
        </div>
      </div>
      <div class="post-grid post-grid-related">
        {related.slice(0, 2).map((item) => <PostCard post={item} />)}
      </div>
    </section>
  )}

  <style>
    .dsa-learning-destinations {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      margin: 1.2rem 0 2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--line);
    }

    .dsa-learning-destinations a {
      padding: .52rem .7rem;
      border: 1px solid var(--line-strong);
      border-radius: .55rem;
      background: var(--surface);
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: .6rem;
      text-transform: capitalize;
    }

    .dsa-learning-destinations a:hover { border-color: var(--indigo); color: var(--indigo); }
    .dsa-learning-destinations a:focus-visible { outline: 3px solid color-mix(in srgb, var(--indigo) 45%, transparent); outline-offset: 2px; }
  </style>

  <script>
    const progress = document.querySelector('[data-reading-progress]');
    const copyLink = document.querySelector('[data-copy-link]');

    const updateProgress = () => {
      const article = document.querySelector('.article-main');
      if (!article || !progress) return;
      const rect = article.getBoundingClientRect();
      const distance = Math.max(1, article.scrollHeight - window.innerHeight);
      const value = Math.min(1, Math.max(0, -rect.top / distance));
      progress.style.transform = `scaleX(${value})`;
    };

    document.querySelectorAll('.article-content pre:not(.recursion-code):not(.subset-code):not(.jdoodle-example-code):not(.trace-code)').forEach((pre) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-button';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.textContent || '');
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 1600);
      });
      pre.appendChild(button);
    });

    copyLink?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(window.location.href);
      copyLink.textContent = 'Copied';
      setTimeout(() => { copyLink.textContent = 'Copy link'; }, 1600);
    });

    const practiceSolution = document.querySelector<HTMLDetailsElement>('[data-practice-solution]');
    const revealAnchoredSolution = () => {
      if (!practiceSolution || !window.location.hash) return;
      const target = document.querySelector(window.location.hash);
      if (target && practiceSolution.contains(target)) practiceSolution.open = true;
    };

    document.querySelectorAll('.toc-card a').forEach((link) => {
      link.addEventListener('click', () => {
        if (practiceSolution) practiceSolution.open = true;
      });
    });

    revealAnchoredSolution();
    window.addEventListener('hashchange', revealAnchoredSolution);

    updateProgress();
    document.addEventListener('scroll', updateProgress, { passive: true });
  </script>
</BaseLayout>
