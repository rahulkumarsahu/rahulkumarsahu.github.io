---
interface Item {
  label: string;
  href?: string;
}

const { items = [] } = Astro.props as { items: Item[] };
const siteOrigin = Astro.site ?? new URL('https://rahulkumarsahu.github.io');
const currentUrl = new URL(Astro.url.pathname, siteOrigin).href;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, siteOrigin).href : currentUrl,
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <i aria-hidden="true">/</i>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
