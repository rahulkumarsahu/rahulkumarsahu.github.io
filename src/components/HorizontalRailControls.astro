---
interface Props {
  targetId: string;
  label: string;
  mobileOnly?: boolean;
}

const { targetId, label, mobileOnly = false } = Astro.props;
---

<div class:list={['rail-controls', { 'rail-controls-mobile': mobileOnly }]} data-rail-controls data-target={targetId} aria-label={`${label} controls`}>
  <button type="button" data-rail-previous aria-controls={targetId} aria-label={`Scroll ${label} backward`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m14.5 5-7 7 7 7" /></svg>
  </button>
  <button type="button" data-rail-next aria-controls={targetId} aria-label={`Scroll ${label} forward`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m9.5 5 7 7-7 7" /></svg>
  </button>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-rail-controls]').forEach((controls) => {
    if (controls.dataset.ready === 'true') return;
    controls.dataset.ready = 'true';

    const rail = document.getElementById(controls.dataset.target || '');
    const previous = controls.querySelector<HTMLButtonElement>('[data-rail-previous]');
    const next = controls.querySelector<HTMLButtonElement>('[data-rail-next]');
    if (!rail || !previous || !next) return;

    const updateControls = () => {
      const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
      previous.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= maxScroll - 2;
    };

    const move = (direction: -1 | 1) => {
      rail.scrollBy({
        left: direction * Math.max(260, rail.clientWidth * .78),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    rail.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls, { passive: true });
    updateControls();
  });
</script>

<style>
  .rail-controls { display: flex; align-items: center; gap: .45rem; }
  .rail-controls button { display: grid; width: 2.75rem; height: 2.75rem; flex: 0 0 auto; place-items: center; border: 1px solid var(--line-strong); border-radius: 2px; background: transparent; color: var(--text); cursor: pointer; }
  .rail-controls button:hover:not(:disabled) { border-color: var(--orange); color: var(--orange); }
  .rail-controls button:focus-visible { outline: 3px solid color-mix(in srgb, var(--orange) 55%, transparent); outline-offset: 2px; }
  .rail-controls button:disabled { cursor: default; opacity: .38; }
  .rail-controls svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  @media (min-width: 851px) { .rail-controls-mobile { display: none; } }
</style>
