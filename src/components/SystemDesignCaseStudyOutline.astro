---
import { SYSTEM_DESIGN_CASE_STUDY_SECTIONS } from '../data/systemDesignCaseStudy';
---

<nav class="case-study-outline" aria-labelledby="case-study-outline-title">
  <div><span>SYSTEM DESIGN CASE STUDY</span><h2 id="case-study-outline-title">A repeatable path from requirements to production</h2><p>Follow the same sequence in every case study so decisions can be compared without hunting for missing context.</p></div>
  <ol>
    {SYSTEM_DESIGN_CASE_STUDY_SECTIONS.map((section) => (
      <li><a href={`#${section.slug}`}><span>{section.number}</span><strong>{section.title}</strong><small>{section.question}</small></a></li>
    ))}
  </ol>
</nav>

<style>
  .case-study-outline { margin: 0 0 2rem; overflow: hidden; border: 1px solid var(--line-strong); border-radius: .85rem; background: var(--surface); }
  .case-study-outline > div { padding: 1rem; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--indigo) 6%, var(--surface-strong)); }
  .case-study-outline > div > span { color: var(--amber); font-family: var(--font-mono); font-size: .52rem; font-weight: 700; letter-spacing: .1em; }
  .case-study-outline h2 { margin: .3rem 0 .35rem; padding: 0; border: 0; font-size: 1.1rem; }
  .case-study-outline p { margin: 0; color: var(--text-soft); font-size: .64rem; line-height: 1.5; }
  .case-study-outline ol { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 0; list-style: none; }
  .case-study-outline li { min-width: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .case-study-outline a { display: grid; height: 100%; grid-template-columns: auto 1fr; gap: .2rem .5rem; padding: .7rem; color: var(--text); text-decoration: none; }
  .case-study-outline a:hover { background: color-mix(in srgb, var(--indigo) 6%, transparent); }
  .case-study-outline a > span { grid-row: 1 / 3; color: var(--indigo); font-family: var(--font-mono); font-size: .5rem; }
  .case-study-outline strong { font-size: .63rem; }
  .case-study-outline small { color: var(--text-faint); font-size: .52rem; line-height: 1.4; }
  .case-study-outline a:focus-visible { outline: 3px solid color-mix(in srgb, var(--indigo) 45%, transparent); outline-offset: -3px; }
  @media (max-width: 760px) { .case-study-outline ol { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 440px) { .case-study-outline ol { grid-template-columns: 1fr; } }
</style>
