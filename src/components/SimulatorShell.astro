---
import ActiveSimulatorControls from './ActiveSimulatorControls.astro';
import SimulatorPrediction from './SimulatorPrediction.astro';

const { id, eyebrow, title, description, activeLearning = false } = Astro.props as {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  activeLearning?: boolean;
};
---

<section
  class:list={['simulator-shell', { 'simulator-shell-active': activeLearning }]}
  id={id}
  data-simulator-root
  aria-labelledby={`${id}-title`}
  aria-describedby={activeLearning ? `${id}-shortcuts` : undefined}
  aria-keyshortcuts={activeLearning ? 'ArrowLeft ArrowRight Home End Space R' : undefined}
  tabindex={activeLearning ? '0' : undefined}
>
  <header class="simulator-header">
    <div><span>{eyebrow}</span><h2 id={`${id}-title`}>{title}</h2></div>
    <p>{description}</p>
  </header>
  <div class="simulator-setup"><slot name="setup" /></div>
  <p class="simulator-error" role="alert" data-simulator-error hidden></p>
  <div class="simulator-grid">
    <div class="simulator-visual"><slot name="visual" /></div>
    <aside class="simulator-state" aria-live="polite"><slot name="state" /></aside>
  </div>
  {activeLearning ? (
    <>
      <SimulatorPrediction {id} />
      <ActiveSimulatorControls {id} />
    </>
  ) : (
    <div class="simulator-controls" aria-label="Simulation controls">
      <button type="button" data-sim-action="previous">Previous</button>
      <button type="button" data-sim-action="next">Next</button>
      <button type="button" data-sim-action="play">Play</button>
      <button type="button" data-sim-action="pause" disabled>Pause</button>
      <button type="button" data-sim-action="reset">Reset</button>
      <span data-sim-position>Step 0 of 0</span>
    </div>
  )}
</section>

<style>
  .simulator-shell { container: simulator / inline-size; margin: 2rem 0; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 3px; background: var(--surface); box-shadow: none; }
  .simulator-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1.35rem 1.4rem; border-bottom: 1px solid var(--line-strong); background: var(--surface-strong); }
  .simulator-header span { color: var(--amber); font-family: var(--font-mono); font-size: .68rem; font-weight: 650; letter-spacing: .04em; text-transform: none; }
  .simulator-header h2 { margin: .35rem 0 0; font-family: var(--font-display); font-size: 1.7rem; }
  .simulator-header p { max-width: 29rem; margin: 0; color: var(--text-soft); font-size: .86rem; line-height: 1.55; text-align: right; }
  .simulator-setup { padding: .9rem 1.2rem; border-bottom: 1px solid var(--line); }
  .simulator-setup :global(.sim-fields) { display: flex; align-items: end; flex-wrap: wrap; gap: .6rem; }
  .simulator-setup :global(label) { display: grid; min-width: 9rem; flex: 1 1 11rem; gap: .25rem; color: var(--text-faint); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .03em; text-transform: none; }
  .simulator-setup :global(input), .simulator-setup :global(select), .simulator-setup :global(button) { min-height: 2.75rem; padding: .55rem .7rem; border: 1px solid var(--line-strong); border-radius: 2px; background: var(--surface-strong); color: var(--text); font: inherit; font-size: .8rem; }
  .simulator-setup :global(button) { flex: 0 0 auto; border-color: var(--indigo); background: var(--indigo); color: white; cursor: pointer; }
  .simulator-error { margin: .8rem 1.2rem 0; padding: .7rem; border: 1px solid #c45b46; background: color-mix(in srgb, #c45b46 8%, var(--surface)); color: var(--text-soft); font-size: .7rem; }
  .simulator-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(15rem, .8fr); min-height: 22rem; }
  .simulator-visual { min-width: 0; padding: 1.4rem; border-right: 1px solid var(--line); background: var(--bg-soft); }
  .simulator-state { min-width: 0; padding: 1.2rem; }
  .simulator-state :global(dl) { display: grid; gap: .75rem; margin: 0; }
  .simulator-state :global(dl div) { display: grid; gap: .22rem; }
  .simulator-state :global(dt) { color: var(--text-faint); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .03em; text-transform: none; }
  .simulator-state :global(dd) { overflow-wrap: anywhere; margin: 0; color: var(--text); font-size: .82rem; line-height: 1.5; }
  .simulator-state :global(code) { color: var(--indigo); white-space: pre-wrap; }
  .simulator-controls { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem; padding: .85rem 1.2rem; border-top: 1px solid var(--line); background: var(--surface-strong); }
  .simulator-controls button { min-height: 2.75rem; padding: .52rem .75rem; border: 1px solid var(--line-strong); border-radius: 2px; background: var(--surface); color: var(--text); font-size: .75rem; font-weight: 650; cursor: pointer; }
  .simulator-controls button:disabled { opacity: .45; cursor: not-allowed; }
  .simulator-controls span { margin-left: auto; color: var(--text-faint); font-family: var(--font-mono); font-size: .56rem; }
  .simulator-shell :global(:is(button, input, select):focus-visible) { outline: 3px solid color-mix(in srgb, var(--indigo) 45%, transparent); outline-offset: 2px; }
  .simulator-shell-active:focus-visible { outline: 3px solid color-mix(in srgb, var(--indigo) 45%, transparent); outline-offset: 3px; }
  @media (max-width: 760px) { .simulator-header { align-items: flex-start; flex-direction: column; } .simulator-header p { max-width: none; text-align: left; } .simulator-grid { grid-template-columns: 1fr; } .simulator-visual { min-height: 18rem; border-right: 0; border-bottom: 1px solid var(--line); } }
  @media (max-width: 440px) { .simulator-controls button { flex: 1 1 calc(33% - .45rem); } .simulator-controls span { width: 100%; margin-left: 0; text-align: center; } }
  @media (prefers-reduced-motion: reduce) { .simulator-shell * { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
</style>
