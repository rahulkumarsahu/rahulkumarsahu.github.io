---
import { LEARNING_GOALS, resolveLearningGoal } from '../data/learningGoals';
import { estimateReadTime, getPostSlug, type Post } from '../lib/posts';
import { formatLearningDuration, getLearningEstimate } from '../lib/learningEstimates';

interface Props {
  posts: Post[];
  topic?: string;
  id?: string;
}

const { posts, topic, id = 'choose-your-goal' } = Astro.props;
const goals = LEARNING_GOALS
  .filter((goal) => !topic || goal.topics.includes(topic))
  .map((goal) => resolveLearningGoal(goal, posts))
  .sort((a, b) => Number(b.available.length > 0) - Number(a.available.length > 0));
---

{goals.length > 0 && (
  <section class="learning-goals section-wrap" id={id} aria-labelledby={`${id}-title`}>
    <div class="goal-heading">
      <div><p class="section-label">Choose a path</p><h2 id={`${id}-title`}>{topic ? 'Start with the part you need.' : 'What are you working toward?'}</h2></div>
      <p>Each path starts with a published lesson. Open the details only when you want the full lesson order.</p>
    </div>
    <div class:list={['goal-grid', { 'goal-grid-single': goals.length === 1 }]}>
      {goals.map(({ goal, available, planned, first }) => {
        const estimate = getLearningEstimate(available);
        return (
          <article class="goal-card" id={`${id}-${goal.id}`} style={`--goal-accent: var(--${goal.accent})`} aria-labelledby={`${id}-${goal.id}-title`} data-learning-goal={goal.id}>
            <div class="goal-card-heading">
              <div><h3 id={`${id}-${goal.id}-title`}>{goal.title}</h3><p>{goal.introduction}</p></div>
            </div>
            <div class="goal-availability">
              <strong>{available.length} available {available.length === 1 ? 'lesson' : 'lessons'}</strong>
              <span>{planned.length} planned</span>
            </div>
            <p class="goal-time">
              {available.length ? (
                <><strong>{formatLearningDuration(estimate.totalMinutesMin)} to {formatLearningDuration(estimate.totalMinutesMax)}</strong> for the published lessons and practice.</>
              ) : 'A completion estimate will appear when lessons are published.'}
            </p>
            {first && (
              <a class="goal-start" href={`/posts/${getPostSlug(first)}/`} data-learning-goal-link={goal.id}>
                <span><small>Recommended first lesson</small><strong>{first.data.title}</strong></span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            <details class="goal-outline">
              <summary>Path details and lesson order</summary>
              <div class="goal-outline-content">
                <dl class="goal-facts">
                  <div><dt>Who this is for</dt><dd>{goal.audience}</dd></div>
                  <div><dt>What you should know first</dt><dd>{goal.prerequisites}</dd></div>
                  <div><dt>What you will be able to do</dt><dd>{goal.outcome}</dd></div>
                </dl>
                <h4>Published and available</h4>
                {available.length ? (
                  <ol class="goal-lessons">
                    {available.map((post) => (
                      <li><a href={`/posts/${getPostSlug(post)}/`} data-learning-goal-link={goal.id}>{post.data.title}</a><small>{estimateReadTime(post)} min read</small></li>
                    ))}
                  </ol>
                ) : <p>The first lesson is being prepared.</p>}
                {planned.length > 0 && (
                  <div class="goal-planned">
                    <h4>Planned lessons</h4>
                    <ul>{planned.map((lesson) => <li>{lesson.title}</li>)}</ul>
                  </div>
                )}
                <p class="goal-estimate-note">The estimate includes reading and practice time for published lessons.</p>
              </div>
            </details>
            <a class="goal-destination" href={goal.destination.href}>{goal.destination.title}<span aria-hidden="true"> →</span></a>
          </article>
        );
      })}
    </div>
  </section>
)}

<script>
  import { setLearningGoal } from '../lib/learningStorage';
  document.querySelectorAll<HTMLElement>('[data-learning-goal-link]').forEach((link) => {
    if (link.dataset.goalTrackingReady === 'true') return;
    link.dataset.goalTrackingReady = 'true';
    link.addEventListener('click', () => {
      const goal = link.dataset.learningGoalLink;
      if (goal) setLearningGoal(goal);
    });
  });
</script>

<style>
  .learning-goals { padding-block: 3.25rem 1rem; scroll-margin-top: 1rem; }
  .goal-heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .goal-heading h2 { margin: .4rem 0 0; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.15; }
  .goal-heading > p { max-width: 29rem; margin: 0; color: var(--text-soft); font-size: 1rem; line-height: 1.65; }
  .goal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 1.25rem; }
  .goal-grid-single { grid-template-columns: 1fr; }
  .goal-card { min-width: 0; padding: 1.3rem; border: 1px solid var(--line-strong); border-top: 3px solid var(--goal-accent); border-radius: .85rem; background: var(--surface); scroll-margin-top: 7rem; }
  .goal-card-heading { display: flex; align-items: start; }
  .goal-card h3 { margin: 0; font-size: clamp(1.2rem, 2vw, 1.55rem); line-height: 1.3; }
  .goal-card-heading p { margin: .45rem 0 0; color: var(--text-soft); font-size: .95rem; line-height: 1.55; }
  .goal-facts { display: grid; gap: .9rem; margin: .4rem 0 1.2rem; }
  .goal-facts dt { margin-bottom: .18rem; color: var(--text); font-size: .9rem; font-weight: 650; }
  .goal-facts dd { margin: 0; color: var(--text-soft); font-size: .9rem; line-height: 1.6; }
  .goal-availability { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1rem; font-size: .9rem; }
  .goal-availability strong { color: var(--text); }
  .goal-availability span { color: var(--text-soft); }
  .goal-time { margin: .45rem 0 .9rem; color: var(--text-soft); font-size: .86rem; line-height: 1.55; }
  .goal-time strong { color: var(--text); }
  .goal-start { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 4.25rem; padding: .8rem 1rem; border: 1px solid var(--goal-accent); border-radius: .65rem; background: color-mix(in srgb, var(--goal-accent) 9%, var(--surface-strong)); }
  .goal-start > span:first-child { display: grid; gap: .25rem; }
  .goal-start small { color: var(--text-soft); font-size: .78rem; }
  .goal-start strong { font-size: 1rem; line-height: 1.45; }
  .goal-start > span:last-child { color: var(--goal-accent); font-size: 1.4rem; }
  .goal-start:hover { background: color-mix(in srgb, var(--goal-accent) 17%, var(--surface-strong)); }
  .goal-outline { margin-top: 1rem; border-top: 1px solid var(--line); }
  .goal-outline summary { display: flex; min-height: 2.75rem; align-items: center; padding-block: .75rem; color: var(--text); cursor: pointer; font-size: .92rem; }
  .goal-outline h4 { margin: .8rem 0 .5rem; font-size: .92rem; }
  .goal-lessons, .goal-planned ul { margin: .6rem 0 1.2rem; padding-left: 1.3rem; }
  .goal-lessons li { margin-block: .6rem; padding-left: .25rem; font-size: .9rem; }
  .goal-lessons a { text-decoration: underline; text-underline-offset: .18em; }
  .goal-lessons a:hover { color: var(--goal-accent); }
  .goal-lessons small { display: block; color: var(--text-soft); font-size: .75rem; }
  .goal-planned { padding-top: .75rem; border-top: 1px solid var(--line); color: var(--text-soft); }
  .goal-planned p, .goal-planned li { font-size: .85rem; }
  .goal-planned li { margin-block: .4rem; }
  .goal-estimate-note { color: var(--text-soft); font-size: .82rem; }
  .goal-destination { display: inline-flex; min-height: 2.75rem; align-items: center; padding-block: .65rem; color: var(--text); font-size: 1rem; font-weight: 600; text-decoration: underline; text-underline-offset: .2em; }
  .goal-destination:hover { color: var(--text); }
  .goal-card :is(a, summary):focus-visible { outline: 3px solid var(--goal-accent); outline-offset: 4px; }
  @media (min-width: 900px) {
    .goal-grid-single .goal-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  }
  @media (max-width: 850px) { .goal-heading { flex-direction: column; align-items: start; } .goal-heading > p { max-width: none; } .goal-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .learning-goals { padding-top: 2.5rem; } .goal-card { padding: 1rem; } }
</style>
