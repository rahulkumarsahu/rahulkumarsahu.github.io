---
import { URL_SHORTENER_LAB_SCENARIOS, URL_SHORTENER_LAB_STAGES } from '../data/urlShortenerLab';
---

<section class="design-lab" id="url-shortener-design-lab" data-design-lab aria-labelledby="design-lab-title">
  <header class="lab-header">
    <div>
      <p class="section-index">INTERACTIVE WORKSHOP / 12 DECISIONS</p>
      <h2 id="design-lab-title">Build the architecture one decision at a time.</h2>
      <p>Choose an option, inspect its benefit and cost, then watch the system grow. There is no hidden perfect diagram. The reasoning is the lesson.</p>
    </div>
    <div class="lab-progress" aria-live="polite">
      <strong data-lab-progress-label>0 of 12 decisions complete</strong>
      <div role="progressbar" aria-label="System design lab progress" aria-valuemin="0" aria-valuemax="12" aria-valuenow="0" data-lab-progress-track><i data-lab-progress-bar></i></div>
      <small>Saved only in this browser</small>
    </div>
  </header>

  <div class="lab-layout">
    <nav class="stage-rail" aria-label="URL shortener design stages">
      <span class="stage-rail-label">DESIGN STAGES</span>
      <ol>
        {URL_SHORTENER_LAB_STAGES.map((stage, index) => (
          <li>
            <button type="button" data-stage-button data-stage-index={index} aria-controls={`lab-stage-${stage.id}`} disabled={index > 0}>
              <span>{stage.number}</span>
              <strong>{stage.title}</strong>
              <small data-stage-status>{index === 0 ? 'Current' : 'Locked'}</small>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <div class="lab-workspace">
      {URL_SHORTENER_LAB_STAGES.map((stage, index) => (
        <section id={`lab-stage-${stage.id}`} class="lab-stage" data-stage-panel data-stage-index={index} hidden={index !== 0} aria-labelledby={`lab-stage-title-${stage.id}`}>
          <header class="stage-heading">
            <span>STAGE {stage.number} OF 12</span>
            <h3 id={`lab-stage-title-${stage.id}`} tabindex="-1">{stage.title}</h3>
            <p>{stage.objective}</p>
          </header>

          <fieldset class="decision-set">
            <legend>{stage.prompt}</legend>
            <div class="decision-grid">
              {stage.decisions.map((decision) => (
                <label class="decision-card" data-decision-card>
                  <input type="radio" name={`decision-${stage.id}`} value={decision.id} data-stage-decision data-stage-id={stage.id} />
                  <span class="decision-control" aria-hidden="true"></span>
                  <span class="decision-copy">
                    <strong>{decision.title}</strong>
                    <span>{decision.description}</span>
                    {decision.recommended && <small>RECOMMENDED STARTING POINT</small>}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="decision-impact" data-decision-impact hidden aria-live="polite">
            <div><span>BENEFIT</span><p data-impact-benefit></p></div>
            <div><span>COST</span><p data-impact-cost></p></div>
            <div><span>ARCHITECTURE EFFECT</span><p data-impact-effect></p></div>
          </div>

          {stage.id === 'estimation' && (
            <section class="capacity-estimator" data-capacity-estimator aria-labelledby="capacity-title">
              <div class="estimator-heading"><div><span>CAPACITY WORKSHEET</span><h4 id="capacity-title">Turn assumptions into numbers.</h4></div><p>Adjust the inputs. These estimates guide decisions; they are not traffic guarantees.</p></div>
              <div class="estimator-inputs">
                <label>New links per day<input type="number" min="1" max="1000000000" step="1" value="10000000" data-estimate-input="writes" /></label>
                <label>Redirects per new link<input type="number" min="1" max="10000" step="1" value="100" data-estimate-input="ratio" /></label>
                <label>Bytes per stored link<input type="number" min="100" max="10000" step="50" value="500" data-estimate-input="bytes" /></label>
                <label>Peak multiplier<input type="number" min="1" max="50" step="1" value="5" data-estimate-input="peak" /></label>
              </div>
              <p class="estimator-error" data-estimator-error role="alert" hidden></p>
              <dl class="estimate-results" aria-live="polite">
                <div><dt>Average writes</dt><dd data-estimate-result="write-rps">116/sec</dd></div>
                <div><dt>Average redirects</dt><dd data-estimate-result="read-rps">11,574/sec</dd></div>
                <div><dt>Peak redirects</dt><dd data-estimate-result="peak-rps">57,870/sec</dd></div>
                <div><dt>Storage per year</dt><dd data-estimate-result="storage">1.66 TiB</dd></div>
              </dl>
            </section>
          )}

          <aside class="stage-checkpoint"><span>ENGINEERING CHECKPOINT</span><p>{stage.checkpoint}</p></aside>
        </section>
      ))}

      <div class="stage-actions">
        <button type="button" data-stage-previous>Previous stage</button>
        <span data-stage-position>Stage 1 of 12</span>
        <button type="button" class="primary" data-stage-next disabled>Choose an option to continue</button>
      </div>
      <p class="lab-announcement" data-lab-announcement aria-live="polite"></p>
    </div>

    <aside class="architecture-panel" aria-labelledby="architecture-map-title">
      <div class="architecture-panel-heading"><span>EVOLVING ARCHITECTURE</span><h3 id="architecture-map-title">Current request path</h3></div>
      <div class="architecture-map" data-architecture-map role="img" aria-label="The URL shortener architecture grows as design stages are completed.">
        <div class="architecture-node is-active" data-architecture-node="client"><strong>Client</strong><small>Active</small></div>
        <i aria-hidden="true">↓</i>
        <div class="architecture-node" data-architecture-node="edge"><strong>API edge</strong><small>Planned</small></div>
        <i aria-hidden="true">↓</i>
        <div class="architecture-node" data-architecture-node="rate-limiter"><strong>Rate limiter</strong><small>Planned</small></div>
        <i aria-hidden="true">↓</i>
        <div class="architecture-node" data-architecture-node="load-balancer"><strong>Load balancer</strong><small>Planned</small></div>
        <i aria-hidden="true">↓</i>
        <div class="architecture-node" data-architecture-node="application"><strong>Application pool</strong><small>Planned</small></div>
        <i aria-hidden="true">↓</i>
        <div class="architecture-branch">
          <div class="architecture-node" data-architecture-node="cache"><strong>Redis cache</strong><small>Planned</small></div>
          <span aria-hidden="true">↔</span>
          <div class="architecture-node" data-architecture-node="database"><strong>Primary store</strong><small>Planned</small></div>
          <span aria-hidden="true">→</span>
          <div class="architecture-node" data-architecture-node="replica"><strong>Read replicas</strong><small>Planned</small></div>
        </div>
        <i aria-hidden="true">↓</i>
        <div class="architecture-node" data-architecture-node="observability"><strong>Observability</strong><small>Planned</small></div>
      </div>
      <div class="architecture-decisions">
        <span>DECISIONS IN THE DESIGN</span>
        <ol data-architecture-decisions><li>Choose the first requirement scope to begin.</li></ol>
      </div>
    </aside>
  </div>

  <section class="failure-lab" id="failure-scenarios" aria-labelledby="failure-lab-title">
    <div class="failure-heading">
      <div><p class="section-index">FAILURE DRILLS / 05</p><h2 id="failure-lab-title">Now disturb the system.</h2></div>
      <p>A diagram is only a hypothesis until you ask what happens when a dependency slows down, disappears or receives unexpected load.</p>
    </div>
    <div class="scenario-tabs" role="tablist" aria-label="Failure scenarios">
      {URL_SHORTENER_LAB_SCENARIOS.map((scenario, index) => <button type="button" role="tab" id={`scenario-tab-${scenario.id}`} aria-controls={`scenario-panel-${scenario.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-scenario-tab data-scenario-index={index}>{scenario.title}</button>)}
    </div>
    {URL_SHORTENER_LAB_SCENARIOS.map((scenario, index) => (
      <section class="scenario-panel" role="tabpanel" id={`scenario-panel-${scenario.id}`} aria-labelledby={`scenario-tab-${scenario.id}`} data-scenario-panel data-scenario-index={index} hidden={index !== 0}>
        <div class="scenario-context"><div><span>TRIGGER</span><p>{scenario.trigger}</p></div><div><span>WHAT CHANGES FIRST</span><p>{scenario.observe}</p></div></div>
        <fieldset class="scenario-decisions">
          <legend>How should the system respond?</legend>
          {scenario.responses.map((response) => (
            <label data-scenario-response-card>
              <input type="radio" name={`scenario-${scenario.id}`} value={response.id} data-scenario-response data-scenario-id={scenario.id} />
              <span><strong>{response.title}</strong><small>{response.description}</small>{response.recommended && <i>RECOMMENDED</i>}</span>
            </label>
          ))}
        </fieldset>
        <div class="scenario-impact" data-scenario-impact hidden aria-live="polite"><div><span>BENEFIT</span><p data-scenario-benefit></p></div><div><span>COST</span><p data-scenario-cost></p></div><div><span>EFFECT ON THE DESIGN</span><p data-scenario-effect></p></div></div>
      </section>
    ))}
  </section>

  <footer class="lab-footer">
    <div><strong data-lab-summary>Make your first decision to begin.</strong><span>You can change any decision later and compare the consequences.</span></div>
    <details><summary>Reset this lab</summary><p>This clears only your URL shortener design choices and estimates.</p><button type="button" data-lab-reset>Clear lab progress</button></details>
  </footer>
</section>

<script>
  import { URL_SHORTENER_LAB_SCENARIOS, URL_SHORTENER_LAB_STAGES } from '../data/urlShortenerLab';
  import { KEYS, readRecord, writeRecord } from '../lib/learningStorage';

  type LabValue = string | number;

  document.querySelectorAll<HTMLElement>('[data-design-lab]').forEach((root) => {
    if (root.dataset.labReady === 'true') return;
    root.dataset.labReady = 'true';

    const stageButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage-button]'));
    const stagePanels = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const previous = root.querySelector<HTMLButtonElement>('[data-stage-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-stage-next]');
    const position = root.querySelector<HTMLElement>('[data-stage-position]');
    const announcement = root.querySelector<HTMLElement>('[data-lab-announcement]');
    let saved = readRecord<LabValue>(KEYS.urlShortenerLab);
    let currentStage = Math.max(0, Math.min(URL_SHORTENER_LAB_STAGES.length - 1, Number(saved['meta:current-stage']) || 0));

    const choiceFor = (stageId: string) => String(saved[`stage:${stageId}`] || '');
    const completedCount = () => URL_SHORTENER_LAB_STAGES.filter((stage) => choiceFor(stage.id)).length;
    const firstIncomplete = () => {
      const index = URL_SHORTENER_LAB_STAGES.findIndex((stage) => !choiceFor(stage.id));
      return index < 0 ? URL_SHORTENER_LAB_STAGES.length - 1 : index;
    };
    const reachedIndex = () => Math.min(URL_SHORTENER_LAB_STAGES.length - 1, firstIncomplete());
    const persist = () => writeRecord(KEYS.urlShortenerLab, saved);
    const announce = (message: string) => { if (announcement) announcement.textContent = message; };

    const renderImpact = (panel: HTMLElement, stageIndex: number) => {
      const stage = URL_SHORTENER_LAB_STAGES[stageIndex];
      const decision = stage.decisions.find((item) => item.id === choiceFor(stage.id));
      const impact = panel.querySelector<HTMLElement>('[data-decision-impact]');
      if (!impact) return;
      impact.hidden = !decision;
      if (!decision) return;
      const values: Record<string, string> = {
        '[data-impact-benefit]': decision.benefit,
        '[data-impact-cost]': decision.cost,
        '[data-impact-effect]': decision.effect,
      };
      Object.entries(values).forEach(([selector, value]) => { const target = impact.querySelector<HTMLElement>(selector); if (target) target.textContent = value; });
    };

    const architectureThresholds: Record<string, number> = { client: 0, edge: 3, 'rate-limiter': 7, 'load-balancer': 5, application: 5, database: 4, cache: 6, replica: 8, observability: 10 };
    const renderArchitecture = () => {
      const complete = completedCount();
      root.querySelectorAll<HTMLElement>('[data-architecture-node]').forEach((node) => {
        const id = node.dataset.architectureNode || '';
        const active = complete > (architectureThresholds[id] ?? 99) || id === 'client';
        node.classList.toggle('is-active', active);
        node.classList.remove('is-affected', 'is-protected');
        const status = node.querySelector('small');
        if (status) status.textContent = active ? 'In the design' : 'Planned';
      });
      const list = root.querySelector<HTMLOListElement>('[data-architecture-decisions]');
      if (list) {
        list.replaceChildren();
        URL_SHORTENER_LAB_STAGES.forEach((stage) => {
          const decision = stage.decisions.find((item) => item.id === choiceFor(stage.id));
          if (!decision) return;
          const item = document.createElement('li');
          const label = document.createElement('span'); label.textContent = stage.title;
          const value = document.createElement('strong'); value.textContent = decision.title;
          item.append(label, value); list.appendChild(item);
        });
        if (!list.children.length) { const item = document.createElement('li'); item.textContent = 'Choose the first requirement scope to begin.'; list.appendChild(item); }
      }
    };

    const renderProgress = () => {
      const complete = completedCount();
      const label = root.querySelector<HTMLElement>('[data-lab-progress-label]');
      const bar = root.querySelector<HTMLElement>('[data-lab-progress-bar]');
      const track = root.querySelector<HTMLElement>('[data-lab-progress-track]');
      const summary = root.querySelector<HTMLElement>('[data-lab-summary]');
      if (label) label.textContent = `${complete} of ${URL_SHORTENER_LAB_STAGES.length} decisions complete`;
      if (bar) bar.style.setProperty('--lab-progress', `${complete / URL_SHORTENER_LAB_STAGES.length * 100}%`);
      if (track) track.setAttribute('aria-valuenow', String(complete));
      if (summary) summary.textContent = complete === URL_SHORTENER_LAB_STAGES.length ? 'Your first production design is complete. Test it with the failure drills.' : `${URL_SHORTENER_LAB_STAGES.length - complete} design decisions remain.`;
    };

    const renderStage = (focus = false) => {
      currentStage = Math.min(currentStage, reachedIndex());
      saved['meta:current-stage'] = currentStage;
      persist();
      stagePanels.forEach((panel, index) => {
        panel.hidden = index !== currentStage;
        if (index === currentStage) renderImpact(panel, index);
      });
      stageButtons.forEach((button, index) => {
        const stage = URL_SHORTENER_LAB_STAGES[index];
        const selected = Boolean(choiceFor(stage.id));
        const reached = index <= reachedIndex();
        button.disabled = !reached;
        button.setAttribute('aria-current', index === currentStage ? 'step' : 'false');
        button.classList.toggle('is-complete', selected);
        const status = button.querySelector('small');
        if (status) status.textContent = selected ? 'Decided' : index === currentStage ? 'Current' : reached ? 'Available' : 'Locked';
      });
      const stage = URL_SHORTENER_LAB_STAGES[currentStage];
      const hasChoice = Boolean(choiceFor(stage.id));
      if (previous) previous.disabled = currentStage === 0;
      if (position) position.textContent = `Stage ${currentStage + 1} of ${URL_SHORTENER_LAB_STAGES.length}`;
      if (next) {
        next.disabled = !hasChoice;
        next.textContent = !hasChoice ? 'Choose an option to continue' : currentStage === URL_SHORTENER_LAB_STAGES.length - 1 ? 'Test failure scenarios' : 'Next stage';
      }
      renderProgress();
      renderArchitecture();
      if (focus) stagePanels[currentStage]?.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
    };

    root.querySelectorAll<HTMLInputElement>('[data-stage-decision]').forEach((input) => {
      const stageId = input.dataset.stageId || '';
      input.checked = choiceFor(stageId) === input.value;
      input.addEventListener('change', () => {
        if (!input.checked) return;
        saved[`stage:${stageId}`] = input.value;
        persist();
        const stageIndex = URL_SHORTENER_LAB_STAGES.findIndex((stage) => stage.id === stageId);
        if (stageIndex >= 0) renderImpact(stagePanels[stageIndex], stageIndex);
        if (stageId === 'scale') {
          const defaults = scaleDefaults[input.value];
          if (defaults) {
            estimateInputs.find((field) => field.dataset.estimateInput === 'writes')!.value = String(defaults[0]);
            estimateInputs.find((field) => field.dataset.estimateInput === 'ratio')!.value = String(defaults[1]);
            calculateEstimate();
          }
        }
        if (stageId === 'estimation') {
          const peak = estimateDefaults[input.value];
          const peakInput = estimateInputs.find((field) => field.dataset.estimateInput === 'peak');
          if (peak && peakInput) { peakInput.value = String(peak); calculateEstimate(); }
        }
        renderStage();
        const decision = URL_SHORTENER_LAB_STAGES[stageIndex]?.decisions.find((item) => item.id === input.value);
        announce(`${decision?.title || 'Decision'} selected. Its benefit, cost and architecture effect are now visible.`);
      });
    });

    stageButtons.forEach((button) => button.addEventListener('click', () => { currentStage = Number(button.dataset.stageIndex) || 0; renderStage(); }));
    previous?.addEventListener('click', () => { if (currentStage > 0) { currentStage--; renderStage(); } });
    next?.addEventListener('click', () => {
      if (!choiceFor(URL_SHORTENER_LAB_STAGES[currentStage].id)) return;
      if (currentStage < URL_SHORTENER_LAB_STAGES.length - 1) { currentStage++; renderStage(); stagePanels[currentStage]?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); }
      else root.querySelector<HTMLElement>('#failure-scenarios')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });

    const scaleDefaults: Record<string, [number, number]> = { startup: [100000, 20], growth: [10000000, 100], global: [100000000, 500] };
    const estimateDefaults: Record<string, number> = { average: 1, peak: 5, extreme: 20 };
    const estimateInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-estimate-input]'));
    const formatRate = (value: number) => `${Math.round(value).toLocaleString()}/sec`;
    const formatBytes = (bytes: number) => bytes >= 1099511627776 ? `${(bytes / 1099511627776).toFixed(2)} TiB` : `${(bytes / 1073741824).toFixed(2)} GiB`;
    const calculateEstimate = (shouldPersist = true) => {
      const values: Record<string, number> = {};
      estimateInputs.forEach((input) => values[input.dataset.estimateInput || ''] = Number(input.value));
      const error = root.querySelector<HTMLElement>('[data-estimator-error]');
      const invalid = !Number.isFinite(values.writes) || values.writes < 1 || values.writes > 1000000000 || !Number.isFinite(values.ratio) || values.ratio < 1 || values.ratio > 10000 || !Number.isFinite(values.bytes) || values.bytes < 100 || values.bytes > 10000 || !Number.isFinite(values.peak) || values.peak < 1 || values.peak > 50;
      if (error) { error.hidden = !invalid; error.textContent = invalid ? 'Use values inside the limits shown by each field so the estimate stays readable.' : ''; }
      if (invalid) return;
      if (shouldPersist) {
        estimateInputs.forEach((input) => saved[`estimate:${input.dataset.estimateInput}`] = Number(input.value));
        persist();
      }
      const writeRps = values.writes / 86400;
      const readRps = writeRps * values.ratio;
      const outputs: Record<string, string> = { 'write-rps': formatRate(writeRps), 'read-rps': formatRate(readRps), 'peak-rps': formatRate(readRps * values.peak), storage: formatBytes(values.writes * values.bytes * 365) };
      Object.entries(outputs).forEach(([name, value]) => { const target = root.querySelector<HTMLElement>(`[data-estimate-result="${name}"]`); if (target) target.textContent = value; });
    };
    const scaleChoice = choiceFor('scale');
    const estimateChoice = choiceFor('estimation');
    estimateInputs.forEach((input) => {
      const name = input.dataset.estimateInput || '';
      const fromStorage = Number(saved[`estimate:${name}`]);
      if (Number.isFinite(fromStorage) && fromStorage > 0) input.value = String(fromStorage);
      else if (name === 'writes' || name === 'ratio') input.value = String(scaleDefaults[scaleChoice]?.[name === 'writes' ? 0 : 1] ?? input.value);
      else if (name === 'peak') input.value = String(estimateDefaults[estimateChoice] ?? input.value);
      input.addEventListener('input', () => calculateEstimate());
    });
    calculateEstimate();

    const scenarioTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-scenario-tab]'));
    const scenarioPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-scenario-panel]'));
    const showScenario = (index: number, focus = false) => {
      scenarioTabs.forEach((tab, tabIndex) => { const active = index === tabIndex; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
      scenarioPanels.forEach((panel, panelIndex) => panel.hidden = panelIndex !== index);
      if (focus) scenarioTabs[index]?.focus();
    };
    scenarioTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => showScenario(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? scenarioTabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + scenarioTabs.length) % scenarioTabs.length;
        showScenario(nextIndex, true);
      });
    });

    const renderScenarioImpact = (scenarioId: string, responseId: string) => {
      const scenarioIndex = URL_SHORTENER_LAB_SCENARIOS.findIndex((item) => item.id === scenarioId);
      const scenario = URL_SHORTENER_LAB_SCENARIOS[scenarioIndex];
      const response = scenario?.responses.find((item) => item.id === responseId);
      const panel = scenarioPanels[scenarioIndex];
      const impact = panel?.querySelector<HTMLElement>('[data-scenario-impact]');
      if (!scenario || !response || !impact) return;
      impact.hidden = false;
      const values: Record<string, string> = { '[data-scenario-benefit]': response.benefit, '[data-scenario-cost]': response.cost, '[data-scenario-effect]': response.effect };
      Object.entries(values).forEach(([selector, value]) => { const target = impact.querySelector<HTMLElement>(selector); if (target) target.textContent = value; });
      root.querySelectorAll<HTMLElement>('[data-architecture-node]').forEach((node) => { node.classList.remove('is-affected', 'is-protected'); const status = node.querySelector('small'); const id = node.dataset.architectureNode || ''; if (scenario.affectedNodes.includes(id)) { node.classList.add(response.recommended ? 'is-protected' : 'is-affected'); if (status) status.textContent = response.recommended ? 'Protected response' : 'Risk remains'; } });
    };
    root.querySelectorAll<HTMLInputElement>('[data-scenario-response]').forEach((input) => {
      const scenarioId = input.dataset.scenarioId || '';
      input.checked = String(saved[`scenario:${scenarioId}`] || '') === input.value;
      if (input.checked) renderScenarioImpact(scenarioId, input.value);
      input.addEventListener('change', () => { if (!input.checked) return; saved[`scenario:${scenarioId}`] = input.value; persist(); renderScenarioImpact(scenarioId, input.value); announce('Failure response selected. Its tradeoffs and architecture effect are visible.'); });
    });

    root.querySelector<HTMLButtonElement>('[data-lab-reset]')?.addEventListener('click', () => {
      saved = {};
      writeRecord(KEYS.urlShortenerLab, saved);
      currentStage = 0;
      root.querySelectorAll<HTMLInputElement>('[data-stage-decision], [data-scenario-response]').forEach((input) => input.checked = false);
      root.querySelectorAll<HTMLElement>('[data-decision-impact], [data-scenario-impact]').forEach((impact) => impact.hidden = true);
      estimateInputs.forEach((input) => { const defaults: Record<string, string> = { writes: '10000000', ratio: '100', bytes: '500', peak: '5' }; input.value = defaults[input.dataset.estimateInput || ''] || input.value; });
      calculateEstimate(false); renderStage(); showScenario(0); announce('Lab progress has been cleared.');
      root.querySelector<HTMLDetailsElement>('.lab-footer details')?.removeAttribute('open');
    });

    renderStage();
  });
</script>

<style>
  .design-lab { margin-block: 2rem 5rem; }
  .lab-header, .failure-heading { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, .7fr); gap: 2rem; align-items: end; margin-bottom: 1.2rem; }
  .lab-header h2, .failure-heading h2 { margin: .35rem 0 .6rem; font-size: clamp(1.75rem, 4vw, 3rem); letter-spacing: -.045em; }
