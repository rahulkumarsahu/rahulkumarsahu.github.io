<section class="subset-lab" data-subset-lab aria-labelledby="subset-lab-title">
  <header class="subset-lab-heading">
    <div>
      <span>INTERACTIVE BACKTRACKING TRACE</span>
      <h3 id="subset-lab-title">Watch one subset grow and shrink</h3>
    </div>
    <p>Step through <code>buildSubsets(0, [])</code> for <code>[1, 2, 3]</code>.</p>
  </header>

  <div class="subset-workspace">
    <section class="subset-code-panel" aria-labelledby="subset-code-title">
      <div class="subset-panel-heading">
        <strong id="subset-code-title">Solution.java</strong>
        <span>Java</span>
      </div>

      <pre class="subset-code" aria-label="Backtracking code being executed"><code><span class="subset-code-line is-current" data-subset-line="1" aria-current="step"><i>1</i><b>→</b><span>buildSubsets(startIndex, currentSubset) &#123;</span></span>
<span class="subset-code-line" data-subset-line="2"><i>2</i><b> </b><span>  allSubsets.add(copy(currentSubset));</span></span>
<span class="subset-code-line" data-subset-line="3"><i>3</i><b> </b><span>  for (index = startIndex; index &lt; n; index++) &#123;</span></span>
<span class="subset-code-line" data-subset-line="4"><i>4</i><b> </b><span>    currentSubset.add(numbers.get(index));</span></span>
<span class="subset-code-line" data-subset-line="5"><i>5</i><b> </b><span>    buildSubsets(index + 1, currentSubset);</span></span>
<span class="subset-code-line" data-subset-line="6"><i>6</i><b> </b><span>    currentSubset.remove(last);</span></span>
<span class="subset-code-line" data-subset-line="7"><i>7</i><b> </b><span>  &#125;</span></span>
<span class="subset-code-line" data-subset-line="8"><i>8</i><b> </b><span>&#125;</span></span></code></pre>
    </section>

    <section class="subset-state-panel" aria-labelledby="subset-state-title">
      <div class="subset-panel-heading">
        <strong id="subset-state-title">Backtracking state</strong>
        <span data-subset-depth>0 frames</span>
      </div>

      <div class="subset-values" aria-label="Input values">
        <small>INPUT</small>
        <div>
          <span data-subset-value="1">1</span>
          <span data-subset-value="2">2</span>
          <span data-subset-value="3">3</span>
        </div>
      </div>

      <div class="subset-current">
        <small>CURRENT SUBSET</small>
        <div data-subset-current aria-live="polite"><i>empty</i></div>
      </div>

      <div class="subset-state-grid">
        <div class="subset-stack">
          <div><small>CALL STACK</small><span>newest first</span></div>
          <div data-subset-stack><i>No active calls</i></div>
        </div>

        <div class="subset-results">
          <div><small>SAVED COPIES</small><span data-subset-result-count>0 / 8</span></div>
          <div data-subset-results><i>No subsets saved</i></div>
        </div>
      </div>
    </section>
  </div>

  <div class="subset-explanation" aria-live="polite">
    <span data-subset-phase>READY</span>
    <div>
      <strong data-subset-action>Ready to explore</strong>
      <p data-subset-note>Press Next or Play. The code, path, stack and saved result will move together.</p>
    </div>
  </div>

  <div class="subset-controls" aria-label="Subset dry run controls">
    <button type="button" data-subset-reset>↺ Reset</button>
    <button type="button" data-subset-previous>← Previous</button>
    <button class="subset-play" type="button" data-subset-play>Play ▶</button>
    <button type="button" data-subset-next>Next →</button>
  </div>

  <div class="subset-progress">
    <div><i data-subset-progress></i></div>
    <span data-subset-counter>Step 0</span>
  </div>
</section>

<script>
  type FrameState = 'active' | 'waiting' | 'returning';
  type Frame = { start: number; path: number[]; state: FrameState };
  type Step = {
    phase: string;
    action: string;
    note: string;
    line: number;
    path: number[];
    frames: Frame[];
    results: number[][];
    focusValue?: number;
    focusAction?: 'choose' | 'remove';
  };

  const values = [1, 2, 3];

  const createSteps = (): Step[] => {
    const generated: Step[] = [{
      phase: 'READY',
      action: 'Ready to explore',
      note: 'Press Next or Play. The code, path, stack and saved result will move together.',
      line: 1,
      path: [],
      frames: [],
      results: [],
    }];
    const saved: number[][] = [];

    const addStep = (step: Omit<Step, 'results'>) => {
      generated.push({
        ...step,
        path: [...step.path],
        // Every frame points to the same mutable currentSubset list in Java.
        frames: step.frames.map((frame) => ({ ...frame, path: [...step.path] })),
        results: saved.map((subset) => [...subset]),
      });
    };

    const visit = (start: number, path: number[], parents: Frame[]) => {
      const active: Frame = { start, path: [...path], state: 'active' };
      const activeFrames = [...parents, active];

      addStep({
        phase: 'CALL',
        action: `Enter buildSubsets(${start}, ${formatSubset(path)})`,
        note: 'A new call owns the current path and the next index it is allowed to choose.',
        line: 1,
        path,
        frames: activeFrames,
      });

      saved.push([...path]);
      addStep({
        phase: 'SAVE',
        action: `Save ${formatSubset(path)}`,
        note: 'The current path is already a valid subset, so Java stores a separate copy.',
        line: 2,
        path,
        frames: activeFrames,
      });

      for (let index = start; index < values.length; index++) {
        const chosenValue = values[index];
        const chosenPath = [...path, chosenValue];

        addStep({
          phase: 'CHOOSE',
          action: `Choose ${chosenValue}`,
          note: `Add ${chosenValue} to the working list before exploring the branch below it.`,
          line: 4,
          path: chosenPath,
          frames: activeFrames,
          focusValue: chosenValue,
          focusAction: 'choose',
        });

        addStep({
          phase: 'RECURSE',
          action: `Explore from index ${index + 1}`,
          note: `The current call pauses while buildSubsets(${index + 1}, ${formatSubset(chosenPath)}) runs.`,
          line: 5,
          path: chosenPath,
          frames: activeFrames,
          focusValue: chosenValue,
          focusAction: 'choose',
        });

        const waitingParents = activeFrames.map((frame) => ({
          ...frame,
          path: [...frame.path],
          state: 'waiting' as FrameState,
        }));
        visit(index + 1, chosenPath, waitingParents);

        addStep({
          phase: 'UNDO',
          action: `Remove ${chosenValue}`,
          note: `The child branch is complete. Remove ${chosenValue} so the next sibling starts from ${formatSubset(path)}.`,
          line: 6,
          path,
          frames: activeFrames,
          focusValue: chosenValue,
          focusAction: 'remove',
        });
      }

      addStep({
        phase: 'RETURN',
        action: `Return from buildSubsets(${start}, ${formatSubset(path)})`,
        note: 'There are no more values available at this level, so its stack frame can return.',
        line: 8,
        path,
        frames: [...parents, { ...active, state: 'returning' }],
      });
    };

    visit(0, [], []);
    generated.push({
      phase: 'COMPLETE',
      action: 'All 8 subsets are saved',
      note: 'The root loop is finished, the call stack is empty and the power set is complete.',
      line: 8,
      path: [],
      frames: [],
      results: saved.map((subset) => [...subset]),
    });

    return generated;
  };

  function formatSubset(subset: number[]) {
    return `[${subset.join(', ')}]`;
  }

  const steps = createSteps();

  document.querySelectorAll<HTMLElement>('[data-subset-lab]').forEach((lab) => {
    const phase = lab.querySelector<HTMLElement>('[data-subset-phase]');
    const action = lab.querySelector<HTMLElement>('[data-subset-action]');
    const note = lab.querySelector<HTMLElement>('[data-subset-note]');
    const depth = lab.querySelector<HTMLElement>('[data-subset-depth]');
    const currentSubset = lab.querySelector<HTMLElement>('[data-subset-current]');
    const stack = lab.querySelector<HTMLElement>('[data-subset-stack]');
    const results = lab.querySelector<HTMLElement>('[data-subset-results]');
    const resultCount = lab.querySelector<HTMLElement>('[data-subset-result-count]');
    const counter = lab.querySelector<HTMLElement>('[data-subset-counter]');
    const progress = lab.querySelector<HTMLElement>('[data-subset-progress]');
    const previous = lab.querySelector<HTMLButtonElement>('[data-subset-previous]');
    const next = lab.querySelector<HTMLButtonElement>('[data-subset-next]');
    const play = lab.querySelector<HTMLButtonElement>('[data-subset-play]');
    const reset = lab.querySelector<HTMLButtonElement>('[data-subset-reset]');
    const codeLines = [...lab.querySelectorAll<HTMLElement>('[data-subset-line]')];
    const valueChips = [...lab.querySelectorAll<HTMLElement>('[data-subset-value]')];

    if (!phase || !action || !note || !depth || !currentSubset || !stack || !results || !resultCount || !counter || !progress || !previous || !next || !play || !reset) return;

    let current = 0;
    let timer: number | undefined;

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
      play.textContent = 'Play ▶';
      play.setAttribute('aria-label', 'Play the subset dry run');
    };

    const makeSubset = (subset: number[]) => {
      const element = document.createElement('span');
      element.className = 'subset-list-value';
      element.textContent = formatSubset(subset);
      return element;
    };

    const render = () => {
      const step = steps[current];
      phase.textContent = step.phase;
      phase.dataset.phase = step.phase.toLowerCase();
      action.textContent = step.action;
      note.textContent = step.note;
      depth.textContent = `${step.frames.length} ${step.frames.length === 1 ? 'frame' : 'frames'}`;
      resultCount.textContent = `${step.results.length} / 8`;
      counter.textContent = `Step ${current} of ${steps.length - 1}`;
      progress.style.transform = `scaleX(${current / (steps.length - 1)})`;
      previous.disabled = current === 0;
      next.disabled = current === steps.length - 1;

      codeLines.forEach((line) => {
        const isCurrent = Number(line.dataset.subsetLine) === step.line;
        line.classList.toggle('is-current', isCurrent);
        line.toggleAttribute('aria-current', isCurrent);
        const arrow = line.querySelector('b');
        if (arrow) arrow.textContent = isCurrent ? '→' : ' ';
      });

      valueChips.forEach((chip) => {
        const value = Number(chip.dataset.subsetValue);
        chip.classList.toggle('is-chosen', step.path.includes(value));
        chip.classList.toggle('is-focus', value === step.focusValue);
        chip.classList.toggle('is-removing', value === step.focusValue && step.focusAction === 'remove');
      });

      currentSubset.replaceChildren();
      if (step.path.length === 0) {
        const empty = document.createElement('i');
        empty.textContent = '[] empty subset';
        currentSubset.append(empty);
      } else {
        step.path.forEach((value) => {
          const chip = document.createElement('span');
          chip.textContent = String(value);
          currentSubset.append(chip);
        });
      }

      stack.replaceChildren();
      if (step.frames.length === 0) {
        const empty = document.createElement('i');
        empty.textContent = 'No active calls';
        stack.append(empty);
      } else {
        [...step.frames].reverse().forEach((frame, index) => {
          const element = document.createElement('div');
          element.className = `subset-frame is-${frame.state}`;

          const state = document.createElement('span');
          state.textContent = index === 0 ? frame.state.toUpperCase() : 'WAITING';

          const call = document.createElement('code');
          call.textContent = `buildSubsets(start=${frame.start}, current=${formatSubset(frame.path)})`;

          element.append(state, call);
          stack.append(element);
        });
      }

      results.replaceChildren();
      if (step.results.length === 0) {
        const empty = document.createElement('i');
        empty.textContent = 'No subsets saved';
        results.append(empty);
      } else {
        step.results.forEach((subset) => results.append(makeSubset(subset)));
      }
    };

    previous.addEventListener('click', () => {
      stop();
      current = Math.max(0, current - 1);
      render();
    });

    next.addEventListener('click', () => {
      stop();
      current = Math.min(steps.length - 1, current + 1);
      render();
    });

    reset.addEventListener('click', () => {
      stop();
      current = 0;
      render();
    });

    play.addEventListener('click', () => {
      if (timer !== undefined) {
        stop();
        return;
      }

      if (current === steps.length - 1) current = 0;
      play.textContent = 'Pause ❚❚';
      play.setAttribute('aria-label', 'Pause the subset dry run');
      render();

      timer = window.setInterval(() => {
        if (current >= steps.length - 1) {
          stop();
          return;
        }
        current += 1;
        render();
      }, 1050);
    });

    render();
  });
</script>

