      <g class="nodes">
        <g data-node="root" transform="translate(425 25)"><rect width="150" height="58" rx="12"/><text x="75" y="27">[]</text><text class="note" x="75" y="47">save root</text></g>
        <g data-node="1" transform="translate(145 145)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1]</text><text class="note" x="75" y="48">choose 1</text></g>
        <g data-node="2" transform="translate(425 145)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[2]</text><text class="note" x="75" y="48">choose 2</text></g>
        <g data-node="3" transform="translate(705 145)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[3]</text><text class="note" x="75" y="48">choose 3</text></g>
        <g data-node="12" transform="translate(55 270)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1, 2]</text><text class="note" x="75" y="48">add 2</text></g>
        <g data-node="13" transform="translate(245 270)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1, 3]</text><text class="note" x="75" y="48">add 3</text></g>
        <g data-node="23" transform="translate(495 270)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[2, 3]</text><text class="note" x="75" y="48">add 3</text></g>
        <g data-node="123" transform="translate(55 395)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1, 2, 3]</text><text class="note" x="75" y="48">add 3</text></g>
      </g>
      <g class="levels" aria-hidden="true"><text x="940" y="60">depth 0</text><text x="940" y="180">depth 1</text><text x="940" y="305">depth 2</text><text x="940" y="430">depth 3</text></g>
    </svg>
  </div>
  <div class="explanation" aria-live="polite">
    <div class="step-copy">
      <span data-phase>READY</span><h4 data-action>Begin with the empty path</h4><p data-note>Each node is a valid subset, so the algorithm saves it before choosing another value.</p>
      <dl><div><dt>Current path</dt><dd data-current>[]</dd></div><div><dt>Active source</dt><dd data-active-source>—</dd></div><div><dt>Saved output</dt><dd data-count>0 / 8</dd></div></dl>
    </div>
    <section class="call-stack" aria-label="Java call stack">
      <header><div><span>JAVA RUNTIME</span><h4>Call stack</h4></div><div><strong data-stack-event>READY</strong><small data-stack-count>0 frames</small></div></header>
      <div class="stack-visual" data-stack-visual data-motion="none">
        <div class="stack-operation push-operation" aria-hidden="true"><strong>Push</strong><svg viewBox="0 0 96 74"><path d="M5 8 C48 8 58 28 58 56"/><path d="m48 47 10 10 10-10"/></svg></div>
        <div class="stack-machine">
          <div class="stack-top"><span>LIFO</span><strong>TOP</strong></div>
          <div class="stack-vessel"><div class="stack-frames" data-stack-frames><p>The stack is empty. Press Next to call <code>build(0, [])</code>.</p></div></div>
          <div class="stack-base"><span>STACK BASE</span><strong>main()</strong></div>
        </div>
        <div class="stack-operation pop-operation" aria-hidden="true"><strong>Pop</strong><svg viewBox="0 0 96 74"><path d="M28 56 C28 28 40 8 88 8"/><path d="m78 0 10 8-10 10"/></svg></div>
