<section class="subset-lab" data-subset-lab aria-labelledby="subset-title">
  <header><div><span>BACKTRACKING SEARCH TREE</span><h3 id="subset-title">See every choice become one saved subset.</h3></div><p>The optimal Java solution for <code>[1, 2, 3]</code>. Orange moves forward; green returns.</p></header>
  <div class="tree-scroll" tabindex="0" role="region" aria-label="Scrollable subset recursion tree">
    <svg viewBox="0 0 1000 520" role="img" aria-labelledby="subset-svg-title subset-svg-desc">
      <title id="subset-svg-title">Backtracking tree for all subsets of one, two and three</title><desc id="subset-svg-desc">The empty subset branches to subsets beginning with one, two and three. Deeper nodes add one later value.</desc>
      <g class="edges"><path data-edge="1" d="M500 80 C500 115 230 105 220 145"/><path data-edge="2" d="M500 80 L500 145"/><path data-edge="3" d="M500 80 C500 115 770 105 780 145"/><path data-edge="12" d="M220 205 C220 235 135 235 130 270"/><path data-edge="13" d="M220 205 C220 235 315 235 320 270"/><path data-edge="23" d="M500 205 C500 235 565 235 570 270"/><path data-edge="123" d="M130 330 L130 395"/></g>
      <g class="nodes">
        <g data-node="root" transform="translate(425 25)"><rect width="150" height="58" rx="12"/><text x="75" y="27">[]</text><text class="note" x="75" y="47">save root</text></g>
        <g data-node="1" transform="translate(145 145)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1]</text><text class="note" x="75" y="48">choose 1</text></g>
        <g data-node="2" transform="translate(425 145)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[2]</text><text class="note" x="75" y="48">choose 2</text></g>
        <g data-node="3" transform="translate(705 145)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[3]</text><text class="note" x="75" y="48">choose 3</text></g>
        <g data-node="12" transform="translate(55 270)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1, 2]</text><text class="note" x="75" y="48">add 2</text></g>
        <g data-node="13" transform="translate(245 270)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1, 3]</text><text class="note" x="75" y="48">add 3</text></g>
        <g data-node="23" transform="translate(495 270)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[2, 3]</text><text class="note" x="75" y="48">add 3</text></g>
        <g data-node="123" transform="translate(55 395)"><rect width="150" height="60" rx="12"/><text x="75" y="28">[1, 2, 3]</text><text class="note" x="75" y="48">add 3</text></g>
      </g>
      <g class="levels" aria-hidden="true"><text x="940" y="60">depth 0</text><text x="940" y="180">depth 1</text><text x="940" y="305">depth 2</text><text x="940" y="430">depth 3</text></g>
    </svg>
  </div>
  <div class="explanation" aria-live="polite"><div><span data-phase>READY</span><h4 data-action>Begin with the empty path</h4><p data-note>Each node is a valid subset, so the algorithm saves it before choosing another value.</p></div><dl><div><dt>Current path</dt><dd data-current>[]</dd></div><div><dt>Call stack</dt><dd data-stack>—</dd></div><div><dt>Saved output</dt><dd data-count>0 / 8</dd></div></dl></div>
  <div class="results"><span>SAVED SUBSETS</span><div data-results><i>None yet</i></div></div>
  <footer><div class="progress" aria-hidden="true"><i data-progress></i></div><div><small data-counter>Step 0</small><b></b><button type="button" data-reset>Reset</button><button type="button" data-previous>← Previous</button><button class="primary" type="button" data-next>Next step →</button><button type="button" data-play>Play</button></div></footer>
</section>

<script>
  type E={phase:'save'|'choose'|'return'|'complete';node:string|null;visited:string[];path:number[];stack:string[];results:number[][];action:string;note:string};
  const nodes=[{id:'root',path:[] as number[],parent:''},{id:'1',path:[1],parent:'root'},{id:'12',path:[1,2],parent:'1'},{id:'123',path:[1,2,3],parent:'12'},{id:'13',path:[1,3],parent:'1'},{id:'2',path:[2],parent:'root'},{id:'23',path:[2,3],parent:'2'},{id:'3',path:[3],parent:'root'}];
  const events:E[]=[{phase:'save',node:null,visited:[],path:[],stack:[],results:[],action:'Begin with the empty path',note:'Each node is a valid subset, so the algorithm saves it before choosing another value.'}],saved:number[][]=[],seen:string[]=[];
  const stackFor=(path:number[])=>path.length?path.map((_,i)=>`build(${i+1}, [${path.slice(0,i+1).join(', ')}])`):['build(0, [])'];
  nodes.forEach((item,index)=>{seen.push(item.id);saved.push(item.path);events.push({phase:index?'choose':'save',node:item.id,visited:[...seen],path:item.path,stack:stackFor(item.path),results:saved.map(v=>[...v]),action:index?'Choose, recurse, then save':'Save [] before choosing',note:index?`Add ${item.path.at(-1)}, move startIndex forward, and save [${item.path.join(', ')}].`:'The empty path is the first result. The loop can now try 1, 2, and 3.'});const next=nodes[index+1];if(next&&next.parent!==item.id){const parent=next.parent==='root'?[]:nodes.find(v=>v.id===next.parent)?.path??[];events.push({phase:'return',node:next.parent,visited:[...seen],path:parent,stack:stackFor(parent),results:saved.map(v=>[...v]),action:'Undo the last choice',note:`The completed branch stays saved. Restore [${parent.join(', ')}] so the caller can try its next value.`});}});
  events.push({phase:'complete',node:null,visited:[...seen],path:[],stack:[],results:saved.map(v=>[...v]),action:'All eight subsets are saved',note:'Every increasing-index path was visited exactly once. The working list is empty again, but its saved copies remain.'});
  document.querySelectorAll<HTMLElement>('[data-subset-lab]').forEach(lab=>{const q=<T extends HTMLElement>(s:string)=>lab.querySelector<T>(s);const phase=q('[data-phase]'),action=q('[data-action]'),note=q('[data-note]'),path=q('[data-current]'),stack=q('[data-stack]'),count=q('[data-count]'),results=q('[data-results]'),counter=q('[data-counter]'),progress=q('[data-progress]'),previous=q<HTMLButtonElement>('[data-previous]'),next=q<HTMLButtonElement>('[data-next]'),reset=q<HTMLButtonElement>('[data-reset]'),play=q<HTMLButtonElement>('[data-play]');if(!phase||!action||!note||!path||!stack||!count||!results||!counter||!progress||!previous||!next||!reset||!play)return;let current=0,timer:number|undefined;const stop=()=>{if(timer!==undefined)clearInterval(timer);timer=undefined;play.textContent='Play'};const render=()=>{const e=events[current];phase.textContent=e.phase.toUpperCase();phase.dataset.phase=e.phase;action.textContent=e.action;note.textContent=e.note;path.textContent=`[${e.path.join(', ')}]`;stack.textContent=e.stack.length?e.stack.join(' → '):'—';count.textContent=`${e.results.length} / 8`;counter.textContent=`Step ${current} of ${events.length-1}`;progress.style.transform=`scaleX(${current/(events.length-1)})`;previous.disabled=!current;next.disabled=current===events.length-1;lab.querySelectorAll<SVGGElement>('[data-node]').forEach(n=>{const id=n.dataset.node||'';n.dataset.state=id===e.node?e.phase:e.visited.includes(id)?'saved':'unseen'});lab.querySelectorAll<SVGPathElement>('[data-edge]').forEach(edge=>edge.dataset.state=e.visited.includes(edge.dataset.edge||'')?'visited':'unseen');results.replaceChildren();if(!e.results.length){const i=document.createElement('i');i.textContent='None yet';results.append(i)}else e.results.forEach((value,index)=>{const chip=document.createElement('span');chip.textContent=`[${value.join(', ')}]`;if(index===e.results.length-1&&e.phase!=='return')chip.className='new';results.append(chip)});if(current===events.length-1)stop()};previous.addEventListener('click',()=>{stop();current=Math.max(0,current-1);render()});next.addEventListener('click',()=>{stop();current=Math.min(events.length-1,current+1);render()});reset.addEventListener('click',()=>{stop();current=0;render()});play.addEventListener('click',()=>{if(timer!==undefined){stop();return}if(current===events.length-1)current=0;play.textContent='Pause';render();timer=window.setInterval(()=>{current=Math.min(events.length-1,current+1);render()},1700)});render()});
</script>

<style>
  .subset-lab{color:var(--text);background:var(--surface)}.subset-lab>header{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:1.2rem 1.35rem;border-bottom:1px solid var(--line)}.subset-lab>header span,.explanation>div>span,.results>span{color:var(--amber);font:750 var(--type-technical) var(--font-mono);letter-spacing:.04em}.subset-lab>header h3{margin:.3rem 0 0;font-size:clamp(1.4rem,3vw,2rem);line-height:1.1}.subset-lab>header p{max-width:28rem;margin:0;color:var(--text-soft);font-size:.84rem;line-height:1.55;text-align:right}.subset-lab>header code{color:var(--green)}
  .tree-scroll{overflow-x:auto;padding:1rem;background:var(--bg);scrollbar-width:thin}.tree-scroll:focus-visible{outline:3px solid color-mix(in srgb,var(--orange) 35%,transparent);outline-offset:-4px}.tree-scroll svg{display:block;width:100%;min-width:50rem;height:auto}.edges path{fill:none;stroke:var(--line-strong);stroke-width:2;opacity:.3;transition:stroke 180ms ease,opacity 180ms ease}.edges path[data-state='visited']{stroke:var(--orange);opacity:.9}.nodes g{opacity:.26;transition:opacity 180ms ease}.nodes rect{fill:var(--surface);stroke:var(--line-strong);stroke-width:2}.nodes text{fill:var(--text);font:700 18px var(--font-mono);text-anchor:middle}.nodes .note{fill:var(--text-faint);font-size:14px;font-weight:600}.nodes g[data-state='saved']{opacity:.78}.nodes g[data-state='saved'] rect{stroke:var(--green)}.nodes g[data-state='choose'],.nodes g[data-state='save'],.nodes g[data-state='return']{opacity:1}.nodes g[data-state='choose'] rect,.nodes g[data-state='save'] rect{fill:color-mix(in srgb,var(--orange) 10%,var(--surface));stroke:var(--orange);stroke-width:3}.nodes g[data-state='return'] rect{fill:color-mix(in srgb,var(--green) 10%,var(--surface));stroke:var(--green);stroke-width:3}.levels text{fill:var(--text-faint);font:600 14px var(--font-mono);text-anchor:end}
  .explanation{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr);gap:1.25rem;padding:1.2rem 1.35rem;border-block:1px solid var(--line);background:var(--surface-strong)}.explanation h4{margin:.5rem 0 .35rem;font-size:1.2rem}.explanation p{max-width:62ch;margin:0;color:var(--text-soft);font-size:.84rem;line-height:1.6}.explanation dl{display:grid;gap:.35rem;margin:0}.explanation dl>div{display:grid;grid-template-columns:6rem 1fr;gap:.6rem;padding:.42rem 0;border-bottom:1px solid var(--line)}.explanation dt{color:var(--text-faint);font-size:.8rem}.explanation dd{overflow:hidden;margin:0;color:var(--green);font:650 .8rem/1.45 var(--font-mono);text-overflow:ellipsis}.explanation [data-phase='return']{color:var(--green)}
  .results{display:grid;grid-template-columns:8rem 1fr;gap:1rem;padding:1rem 1.35rem}.results>div{display:flex;flex-wrap:wrap;gap:.4rem}.results>div :global(span){padding:.35rem .45rem;border:1px solid var(--line);border-radius:.4rem;color:var(--green);font:.8rem var(--font-mono)}.results>div :global(span.new){border-color:var(--orange);color:var(--orange)}.results i{color:var(--text-faint);font-size:.8rem}.subset-lab>footer{display:grid;gap:.75rem;padding:1rem 1.35rem;border-top:1px solid var(--line)}.subset-lab>footer>div:last-child{display:flex;align-items:center;gap:.5rem}.subset-lab>footer b{flex:1}.subset-lab>footer small{color:var(--text-faint);font:600 var(--type-technical) var(--font-mono)}.subset-lab button{min-height:2.6rem;padding:.55rem .75rem;border:1px solid var(--line-strong);border-radius:.5rem;background:var(--surface);color:var(--text);font:700 .8rem var(--font-body);cursor:pointer}.subset-lab button.primary{border-color:var(--orange);background:var(--orange);color:#17130f}.subset-lab button:disabled{opacity:.38;cursor:not-allowed}.subset-lab button:focus-visible{outline:3px solid color-mix(in srgb,var(--orange) 35%,transparent);outline-offset:2px}.progress{height:.25rem;overflow:hidden;border-radius:999px;background:var(--line)}.progress i{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--orange),var(--green));transform:scaleX(0);transform-origin:left;transition:transform 180ms ease}
  @media(max-width:680px){.subset-lab>header{align-items:flex-start;flex-direction:column;gap:.5rem}.subset-lab>header p{text-align:left}.explanation{grid-template-columns:1fr}.results{grid-template-columns:1fr}.subset-lab>footer>div:last-child{display:grid;grid-template-columns:1fr 1fr}.subset-lab>footer b{display:none}}@media(prefers-reduced-motion:reduce){.edges path,.nodes g,.progress i{transition:none}}
</style>
