  .tree-scroll{overflow-x:auto;padding:1rem;background:var(--bg);scrollbar-width:thin}.tree-scroll:focus-visible{outline:3px solid color-mix(in srgb,var(--orange) 35%,transparent);outline-offset:-4px}.tree-scroll svg{display:block;width:100%;height:auto}.edges path{fill:none;stroke:var(--line-strong);stroke-width:2;opacity:.3;transition:stroke 180ms ease,opacity 180ms ease}.edges path[data-state='visited']{stroke:var(--orange);opacity:.9}.nodes g{opacity:.26;transition:opacity 180ms ease}.nodes rect{fill:var(--surface);stroke:var(--line-strong);stroke-width:2}.nodes text{fill:var(--text);font:700 18px var(--font-mono);text-anchor:middle}.nodes .note{fill:var(--text-faint);font-size:14px;font-weight:600}.nodes g[data-state='saved']{opacity:.78}.nodes g[data-state='saved'] rect{stroke:var(--green)}.nodes g[data-state='choose'],.nodes g[data-state='save'],.nodes g[data-state='return']{opacity:1}.nodes g[data-state='choose'] rect,.nodes g[data-state='save'] rect{fill:color-mix(in srgb,var(--orange) 10%,var(--surface));stroke:var(--orange);stroke-width:3}.nodes g[data-state='return'] rect{fill:color-mix(in srgb,var(--green) 10%,var(--surface));stroke:var(--green);stroke-width:3}.levels text{fill:var(--text-faint);font:600 14px var(--font-mono);text-anchor:end}
