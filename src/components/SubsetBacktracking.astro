</section>

<script>
  type Phase='ready'|'save'|'loop'|'choose'|'call'|'return'|'complete';
  type FrameState='running'|'waiting'|'returning';
  type Motion='none'|'push'|'step'|'pop'|'resume'|'done';
  type Frame={id:string;start:number;current:number[];i:number|null;state:FrameState;resume:string};
  type E={phase:Phase;motion:Motion;line:number|null;node:string|null;visited:string[];path:number[];stack:Frame[];results:number[][];action:string;note:string};
  const values=[1,2,3],saved:number[][]=[],seen:string[]=[],events:E[]=[];
  const idFor=(path:number[])=>path.length?path.join(''):'root';
  const copyStack=(frames:Frame[])=>frames.map(frame=>({...frame,current:[...frame.current]}));
  const snapshot=(phase:Phase,motion:Motion,line:number|null,node:string|null,path:number[],stack:Frame[],action:string,note:string)=>events.push({phase,motion,line,node,visited:[...seen],path:[...path],stack:copyStack(stack),results:saved.map(value=>[...value]),action,note});
  events.push({phase:'ready',motion:'none',line:null,node:null,visited:[],path:[],stack:[],results:[],action:'Call build(0, [])',note:'Press Next. A real Java frame will be pushed onto the stack, then execution begins at line 1.'});
  const walk=(start:number,path:number[],parents:Frame[])=>{
    const id=idFor(path),frame:Frame={id:`frame-${id}`,start,current:[...path],i:null,state:'running',resume:'line 2 · test loop'};
    let stack=[...copyStack(parents),frame];
    if(!seen.includes(id))seen.push(id);
    saved.push([...path]);
    snapshot('save','step',1,id,path,stack,`Save [${path.join(', ')}]`,'Line 1 copies current into result. The frame keeps its own start and loop index; current is shared and restored by backtracking.');
    for(let i=start;i<values.length;i++){
      frame.i=i;frame.state='running';frame.resume='line 3 · add nums[i]';stack=[...copyStack(parents),{...frame,current:[...path]}];
      snapshot('loop','step',2,id,path,stack,`Loop check: i = ${i}` ,`${i} is less than nums.length (3), so this frame can choose nums[${i}] = ${values[i]}.`);
      const nextPath=[...path,values[i]];
      frame.current=[...nextPath];frame.resume='line 4 · call build';stack=[...copyStack(parents),{...frame,current:[...nextPath]}];
      snapshot('choose','step',3,idFor(nextPath),nextPath,stack,`Add ${values[i]} to current`,`The active frame mutates current to [${nextPath.join(', ')}]. No new call exists yet.`);
      const waiting:Frame={...frame,current:[...nextPath],state:'waiting',resume:`line 5 · remove ${values[i]}`};
      const child:Frame={id:`frame-${idFor(nextPath)}`,start:i+1,current:[...nextPath],i:null,state:'running',resume:'line 1 · save current'};
      snapshot('call','push',4,idFor(nextPath),nextPath,[...copyStack(parents),waiting,child],`Push build(${i+1}, [${nextPath.join(', ')}])`,`Java pauses the caller at line 4 and pushes the callee above it. The new top frame starts executing at line 1.`);
      walk(i+1,nextPath,[...copyStack(parents),waiting]);
      frame.current=[...path];frame.i=i;frame.state='running';frame.resume='line 2 · continue loop';stack=[...copyStack(parents),{...frame,current:[...path]}];
      snapshot('return','pop',5,id,path,stack,`Pop child; remove ${values[i]}`,`The child returned, so its frame leaves the stack. The caller resumes at line 5 and restores current to [${path.join(', ')}].`);
    }
    frame.i=values.length;frame.current=[...path];frame.state='running';frame.resume='line 6 · return';stack=[...copyStack(parents),{...frame,current:[...path]}];
    snapshot('loop','step',2,id,path,stack,`Loop ends: i = ${values.length}`,`${values.length} is not less than nums.length (3), so this invocation has no choices left.`);
    frame.state='returning';frame.resume=parents.length?'caller resumes at line 5':'return to main()';
    snapshot('return','resume',6,id,path,[...copyStack(parents),{...frame,current:[...path]}],`Return build(${start}, [${path.join(', ')}])`,parents.length?'This frame is complete. It will pop, revealing the waiting caller underneath.':'The root frame is complete and returns to main().');
  };
  const root:Frame={id:'frame-root',start:0,current:[],i:null,state:'running',resume:'line 1 · save current'};
  snapshot('call','push',null,'root',[],[root],'Push build(0, [])','main() calls build. The root invocation becomes the first and only frame on the stack.');
  walk(0,[],[]);
  events.push({phase:'complete',motion:'done',line:null,node:null,visited:[...seen],path:[],stack:[],results:saved.map(value=>[...value]),action:'All eight subsets are complete',note:'The root frame returned to main(). Every invocation was pushed once, paused when it called a child, and popped when it finished.'});
  document.querySelectorAll<HTMLElement>('[data-subset-lab]').forEach(lab=>{
    const q=<T extends HTMLElement>(selector:string)=>lab.querySelector<T>(selector);
    const phase=q('[data-phase]'),action=q('[data-action]'),note=q('[data-note]'),path=q('[data-current]'),activeSource=q('[data-active-source]'),count=q('[data-count]'),results=q('[data-results]'),counter=q('[data-counter]'),progress=q('[data-progress]'),status=q('[data-code-status]'),stackVisual=q('[data-stack-visual]'),stackFrames=q('[data-stack-frames]'),stackEvent=q('[data-stack-event]'),stackCount=q('[data-stack-count]'),previous=q<HTMLButtonElement>('[data-previous]'),next=q<HTMLButtonElement>('[data-next]'),reset=q<HTMLButtonElement>('[data-reset]'),play=q<HTMLButtonElement>('[data-play]');
    if(!phase||!action||!note||!path||!activeSource||!count||!results||!counter||!progress||!status||!stackVisual||!stackFrames||!stackEvent||!stackCount||!previous||!next||!reset||!play)return;
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current=0,timer:number|undefined;
    const stop=()=>{if(timer!==undefined)clearInterval(timer);timer=undefined;play.textContent='Play'};
    const makeFrame=(frame:Frame,index:number)=>{
      const article=document.createElement('article');article.className='stack-frame';article.dataset.frame=frame.id;article.dataset.state=frame.state;
      const top=document.createElement('div');top.className='frame-title';
      const name=document.createElement('strong');name.textContent=`build(${frame.start}, current)`;
      const state=document.createElement('span');state.textContent=frame.state.toUpperCase();
      top.append(name,state);
      const locals=document.createElement('dl');
      const entries:[string,string][]=[['start',String(frame.start)],['current',`[${frame.current.join(', ')}]`],['i',frame.i===null?'not set':String(frame.i)],['resume',frame.resume]];
      entries.forEach(([label,value])=>{const row=document.createElement('div'),dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=label;dd.textContent=value;row.append(dt,dd);locals.append(row)});
      const depth=document.createElement('small');depth.textContent=index===0?'top frame':`depth ${index}`;
      article.append(top,locals,depth);return article;
    };
    const render=()=>{
      const e=events[current];phase.textContent=e.phase.toUpperCase();phase.dataset.phase=e.phase;action.textContent=e.action;note.textContent=e.note;path.textContent=`[${e.path.join(', ')}]`;activeSource.textContent=e.line?`line ${e.line}`:'—';count.textContent=`${e.results.length} / 8`;counter.textContent=`Step ${current} of ${events.length-1}`;status.textContent=e.line?`Executing line ${e.line}`:e.phase==='complete'?'Execution complete':e.phase==='call'?'Creating stack frame':'Ready to run';progress.style.transform=`scaleX(${current/(events.length-1)})`;previous.disabled=!current;next.disabled=current===events.length-1;
      stackEvent.textContent=e.motion==='push'?'PUSH':e.motion==='pop'?'POP':e.motion==='resume'?'RETURN':e.motion==='done'?'EMPTY':'EXECUTE';stackEvent.dataset.motion=e.motion;stackVisual.dataset.motion=e.motion;stackCount.textContent=`${e.stack.length} ${e.stack.length===1?'frame':'frames'}`;
      const oldTop=stackFrames.querySelector<HTMLElement>('.stack-frame'),departingRect=oldTop?.getBoundingClientRect();
      const departing=e.motion==='pop'&&!reduced?oldTop?.cloneNode(true) as HTMLElement|undefined:undefined;
      stackFrames.replaceChildren();
      if(!e.stack.length){const empty=document.createElement('p');empty.textContent=e.phase==='complete'?'All frames returned. Control is back in main().':'The stack is empty. Press Next to begin.';stackFrames.append(empty)}
      else [...e.stack].reverse().forEach((frame,index)=>stackFrames.append(makeFrame(frame,index)));
      const topFrame=stackFrames.querySelector<HTMLElement>('.stack-frame');
      if(departing&&departingRect){const stageRect=stackVisual.getBoundingClientRect();departing.classList.add('stack-ghost');departing.style.width=`${departingRect.width}px`;departing.style.left=`${departingRect.left-stageRect.left}px`;departing.style.top=`${departingRect.top-stageRect.top}px`;stackVisual.append(departing);const flight=departing.animate([{opacity:1,transform:'translate(0,0)'},{opacity:0,transform:'translate(5.5rem,-3.25rem) scale(.94)'}],{duration:220,easing:'cubic-bezier(.4,0,1,1)'});flight.finished.finally(()=>departing.remove())}
      if(topFrame&&!reduced){const keyframes=e.motion==='push'?[{opacity:0,transform:'translateY(-3.5rem) scale(.97)'},{opacity:1,transform:'translateY(0) scale(1)'}]:e.motion==='pop'?[{transform:'translateY(8px)',background:'color-mix(in srgb, var(--green) 18%, var(--surface))'},{transform:'translateY(0)',background:'var(--surface)'}]:e.motion==='resume'?[{transform:'translateY(-4px)',opacity:.72},{transform:'translateY(0)',opacity:1}]:[{opacity:.76},{opacity:1}];topFrame.animate(keyframes,{duration:e.motion==='push'?280:200,easing:'cubic-bezier(.16,1,.3,1)'});}
      lab.querySelectorAll<HTMLElement>('[data-code-line]').forEach(line=>line.dataset.active=String(Number(line.dataset.codeLine)===e.line));
      lab.querySelectorAll<SVGGElement>('[data-node]').forEach(node=>{const id=node.dataset.node||'';node.dataset.state=id===e.node?e.phase:e.visited.includes(id)?'saved':'unseen'});
      lab.querySelectorAll<SVGPathElement>('[data-edge]').forEach(edge=>edge.dataset.state=e.visited.includes(edge.dataset.edge||'')?'visited':'unseen');
      results.replaceChildren();if(!e.results.length){const empty=document.createElement('i');empty.textContent='None yet';results.append(empty)}else e.results.forEach((value,index)=>{const chip=document.createElement('span');chip.textContent=`[${value.join(', ')}]`;if(index===e.results.length-1&&e.phase==='save')chip.className='new';results.append(chip)});
      if(current===events.length-1)stop();
    };
    previous.addEventListener('click',()=>{stop();current=Math.max(0,current-1);render()});next.addEventListener('click',()=>{stop();current=Math.min(events.length-1,current+1);render()});reset.addEventListener('click',()=>{stop();current=0;render()});play.addEventListener('click',()=>{if(timer!==undefined){stop();return}if(current===events.length-1)current=0;play.textContent='Pause';render();timer=window.setInterval(()=>{current=Math.min(events.length-1,current+1);render()},1250)});render();
  });
</script>

