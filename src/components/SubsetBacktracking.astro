      <li data-code-line="2"><code>for (int i = start; i &lt; nums.length; i++) {'{'}</code></li>
      <li data-code-line="3"><code>&nbsp;&nbsp;current.add(nums[i]);</code></li>
      <li data-code-line="4"><code>&nbsp;&nbsp;build(i + 1, current, result);</code></li>
      <li data-code-line="5"><code>&nbsp;&nbsp;current.remove(current.size() - 1);</code></li>
      <li data-code-line="6"><code>{'}'}</code></li>
    </ol>
  </div>
