  .call-stack{min-width:0;border:1px solid var(--line-strong);border-radius:.65rem;background:#171714}.call-stack>header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem .8rem;border-bottom:1px solid var(--line)}.call-stack>header span,.stack-top span,.stack-base span{color:var(--text-faint);font:700 .68rem var(--font-mono);letter-spacing:.04em}.call-stack>header h4{margin:.15rem 0 0;font:750 .95rem var(--font-body)}.call-stack>header>div:last-child{display:grid;justify-items:end;gap:.1rem}.call-stack>header strong{color:var(--orange);font:800 .72rem var(--font-mono);letter-spacing:.04em}.call-stack>header strong[data-motion='pop'],.call-stack>header strong[data-motion='resume'],.call-stack>header strong[data-motion='done']{color:var(--green)}.call-stack>header small{color:var(--text-faint);font:.68rem var(--font-mono)}
