---
const jdoodleEmbedUrl = import.meta.env.PUBLIC_JDOODLE_SUBSETS_EMBED_URL?.trim() ?? '';
const hasEmbed = /^https:\/\/www\.jdoodle\.com\/embed\/v1\/[a-zA-Z0-9]+\/?$/.test(jdoodleEmbedUrl);

const starterCode = `import java.util.ArrayList;
import java.util.List;

public class Main {
