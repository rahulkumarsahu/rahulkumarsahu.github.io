---
import type { PracticeProblem } from '../data/practiceProblems';
import ProgressiveHints from './ProgressiveHints.astro';

const { problem } = Astro.props as { problem: PracticeProblem };
const configuredEmbed = problem.slug === 'subsets-in-java'
  ? import.meta.env.PUBLIC_JDOODLE_SUBSETS_EMBED_URL?.trim() ?? ''
  : '';
const hasEmbed = /^https:\/\/www\.jdoodle\.com\/embed\/v1\/[a-zA-Z0-9]+\/?$/.test(configuredEmbed);
---

<section
  class="jdoodle-practice"
  aria-labelledby={`practice-${problem.slug}`}
  data-practice-workspace
  data-problem-slug={problem.slug}
>
  <header class="jdoodle-heading">
    <div>
      <span>PRACTICE WORKSPACE</span>
      <h2 id={`practice-${problem.slug}`}>Read the problem, then build your solution</h2>
    </div>
    <p>Your saved draft stays in this browser. The completed solution remains closed until you reveal it.</p>
  </header>

  <section class="jdoodle-problem" aria-labelledby={`problem-${problem.slug}`}>
    <div class="jdoodle-side-label"><span>01</span> PROBLEM STATEMENT</div>
    <h3 id={`problem-${problem.slug}`}>{problem.title}</h3>
    <p>{problem.instruction}</p>

    <div class="jdoodle-rules">
      {problem.rules.map((rule) => (
        <div><span>{rule.label}</span><strong>{rule.value}</strong></div>
      ))}
    </div>

    <div class="jdoodle-example" aria-label="Practice example">
      <span>EXAMPLE</span>
      <pre class="jdoodle-example-code">{`Input:    ${problem.input}\nExpected: ${problem.expected}`}</pre>
    </div>

    {problem.officialUrl && (
      <a href={problem.officialUrl} target="_blank" rel="noopener noreferrer">Open the official problem ↗</a>
    )}
  </section>

  <section class="jdoodle-build" aria-labelledby={`build-${problem.slug}`}>
    <div class="jdoodle-build-heading">
      <div>
        <div class="jdoodle-side-label"><span>02</span> BUILD YOUR OWN</div>
        <h3 id={`build-${problem.slug}`}>Complete the Java method</h3>
      </div>
      <span class="draft-state" data-draft-state aria-live="polite">Starter code</span>
    </div>

    {hasEmbed ? (
      <div class="jdoodle-embed" aria-label="JDoodle Java playground">
        <div data-pym-src={configuredEmbed}></div>
      </div>
    ) : (
      <form
        class="jdoodle-editor"
        action="https://www.jdoodle.com/api/redirect-to-post/online-java-compiler"
        method="post"
        target="_blank"
      >
        <div class="jdoodle-editor-bar">
          <label for={`starter-code-${problem.slug}`}>Main.java</label>
          <span>JAVA</span>
        </div>
        <textarea
          id={`starter-code-${problem.slug}`}
          name="initScript"
          spellcheck="false"
          aria-describedby={`draft-help-${problem.slug}`}
          data-code-editor
          data-starter-code={problem.starterCode}
        >{problem.starterCode}</textarea>
        <div class="jdoodle-actions">
          <p id={`draft-help-${problem.slug}`}>Run opens JDoodle in a new tab. Save keeps this draft only on this device.</p>
          <div>
            <button class="editor-button editor-button-secondary" type="button" data-restore-draft>Restore saved</button>
            <button class="editor-button editor-button-secondary" type="button" data-clear-draft>Clear saved</button>
            <button class="editor-button editor-button-secondary" type="button" data-save-draft>Save draft</button>
            <button class="editor-button editor-button-primary" type="submit">Run code ↗</button>
          </div>
        </div>
      </form>
    )}
  </section>

  <ProgressiveHints hints={problem.hints} problemSlug={problem.slug} />
</section>

{hasEmbed && (
  <script is:inline src="https://www.jdoodle.com/assets/jdoodle-pym.min.js" type="text/javascript"></script>
)}

<script>
  const CODE_STORAGE_KEY = 'atlas-code-drafts:v1';

  const readDrafts = (): Record<string, string> => {
    try {
      return JSON.parse(window.localStorage.getItem(CODE_STORAGE_KEY) || '{}');
    } catch {
      return {};
    }
  };

  const writeDrafts = (drafts: Record<string, string>) => {
    try {
      window.localStorage.setItem(CODE_STORAGE_KEY, JSON.stringify(drafts));
      return true;
    } catch {
      return false;
    }
  };

  document.querySelectorAll<HTMLElement>('[data-practice-workspace]').forEach((workspace) => {
    const slug = workspace.dataset.problemSlug;
    const editor = workspace.querySelector<HTMLTextAreaElement>('[data-code-editor]');
    const save = workspace.querySelector<HTMLButtonElement>('[data-save-draft]');
    const restore = workspace.querySelector<HTMLButtonElement>('[data-restore-draft]');
    const clear = workspace.querySelector<HTMLButtonElement>('[data-clear-draft]');
    const state = workspace.querySelector<HTMLElement>('[data-draft-state]');
    if (!slug || !editor) return;

    const saved = readDrafts()[slug];
    if (typeof saved === 'string') {
      editor.value = saved;
      if (state) state.textContent = 'Saved draft restored';
    }

    editor.addEventListener('input', () => {
      if (state) state.textContent = 'Unsaved changes';
    });

    save?.addEventListener('click', () => {
      const drafts = readDrafts();
      drafts[slug] = editor.value;
      const savedSuccessfully = writeDrafts(drafts);
      if (state) state.textContent = savedSuccessfully ? 'Draft saved' : 'Browser storage unavailable';
    });

    restore?.addEventListener('click', () => {
      const savedDraft = readDrafts()[slug];
      if (typeof savedDraft === 'string') {
        editor.value = savedDraft;
        if (state) state.textContent = 'Saved draft restored';
      } else if (state) {
        state.textContent = 'No saved draft yet';
      }
      editor.focus();
    });

    clear?.addEventListener('click', () => {
      const drafts = readDrafts();
      delete drafts[slug];
      writeDrafts(drafts);
      editor.value = editor.dataset.starterCode || '';
      if (state) state.textContent = 'Saved draft cleared';
      editor.focus();
    });
  });
</script>

<style>
  .jdoodle-practice {
    container: jdoodle-practice / inline-size;
    margin-bottom: 2.6rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    box-shadow: var(--shadow);
  }

  .jdoodle-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.2rem 1.3rem;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--indigo) 11%, transparent), transparent 52%),
      var(--surface-strong);
  }

  .jdoodle-heading span,
  .jdoodle-problem span,
  .jdoodle-editor-bar span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: .58rem;
    font-weight: 600;
    letter-spacing: .12em;
  }

  .jdoodle-heading h2 {
    margin: .25rem 0 0;
    padding: 0;
    border: 0;
    font-size: 1.45rem;
  }

  .jdoodle-heading > p {
    max-width: 22rem;
    margin: 0;
    color: var(--text-soft);
    font-size: .78rem;
    line-height: 1.55;
    text-align: right;
  }

  .jdoodle-problem {
    min-width: 0;
    padding: 1.35rem 1.3rem 1.45rem;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--amber) 6%, transparent), transparent 46%),
      color-mix(in srgb, var(--surface) 92%, transparent);
  }

  .jdoodle-problem p {
    max-width: 58rem;
    margin: .8rem 0 0;
    color: var(--text-soft);
    font-size: .88rem;
    line-height: 1.65;
  }

  .jdoodle-side-label {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .57rem;
    font-weight: 600;
    letter-spacing: .1em;
  }

  .jdoodle-side-label span {
    display: inline-grid;
    width: 1.55rem;
    height: 1.55rem;
    place-content: center;
    border: 1px solid var(--line-strong);
    border-radius: .4rem;
    color: var(--amber);
    letter-spacing: 0;
  }

  .jdoodle-problem h3,
  .jdoodle-build-heading h3 {
    margin: .65rem 0 0;
    color: var(--text);
    font-size: 1.15rem;
  }

  .jdoodle-rules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .7rem;
    margin-top: 1.15rem;
  }

  .jdoodle-rules > div {
    display: grid;
    gap: .34rem;
    padding: .8rem;
    border: 1px solid var(--line);
    border-radius: .6rem;
    background: color-mix(in srgb, var(--surface-strong) 75%, transparent);
  }

  .jdoodle-rules span,
  .jdoodle-example > span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: .54rem;
    font-weight: 600;
    letter-spacing: .1em;
  }

  .jdoodle-rules strong {
    color: var(--text);
    font-size: .75rem;
    font-weight: 500;
  }

  .jdoodle-example {
    margin-top: 1rem;
  }

  .jdoodle-example pre {
    overflow-x: auto;
    margin: .5rem 0 0;
    padding: .75rem;
    border: 1px solid var(--line);
    border-radius: .55rem;
    background: var(--surface-strong);
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: .72rem;
    line-height: 1.65;
    white-space: pre;
  }

  .jdoodle-problem > a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--indigo);
    font-size: .74rem;
    font-weight: 600;
  }

  .jdoodle-build {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: #0b1020;
  }

  .jdoodle-build-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    background: #151d31;
  }

  .jdoodle-build-heading .jdoodle-side-label,
  .draft-state {
    color: #97a7c0;
  }

  .jdoodle-build-heading h3 {
    color: #eef3ff;
    font-size: .92rem;
  }

  .draft-state {
    font-family: var(--font-mono);
    font-size: .6rem;
  }

  .jdoodle-editor {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
  }

  .jdoodle-editor-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .68rem 1.3rem;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    background: #11182a;
  }

  .jdoodle-editor-bar label {
    color: #e7ecf7;
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 600;
  }

  .jdoodle-editor textarea {
    display: block;
    width: 100%;
    min-height: 34rem;
    flex: 1;
    resize: vertical;
    padding: 1.15rem 1.3rem;
    border: 0;
    border-radius: 0;
    outline-offset: -3px;
    background: #0b1020;
    color: #d9e2f2;
    font-family: var(--font-mono);
    font-size: .82rem;
    line-height: 1.8;
    tab-size: 4;
  }

  .jdoodle-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .9rem 1.3rem;
    border-top: 1px solid rgba(255, 255, 255, .1);
    background: #11182a;
  }

  .jdoodle-actions p {
    max-width: 28rem;
    margin: 0;
    color: #aebbd1;
    font-size: .68rem;
    line-height: 1.5;
  }

  .jdoodle-actions > div {
    display: flex;
    flex: 0 0 auto;
    gap: .45rem;
  }

  .editor-button {
    min-height: 2.55rem;
    padding: .55rem .8rem;
    border-radius: .6rem;
    color: white;
    font-size: .72rem;
    font-weight: 600;
    cursor: pointer;
  }

  .editor-button-primary {
    border: 1px solid #8b8dff;
    background: #7375f5;
  }

  .editor-button-secondary {
    border: 1px solid rgba(255, 255, 255, .18);
    background: #1b263d;
  }

  .jdoodle-embed {
    flex: 1;
    min-height: 34rem;
    padding: .75rem;
    background: var(--surface-strong);
  }

  @media (max-width: 720px) {
    .jdoodle-heading,
    .jdoodle-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .jdoodle-heading > p {
      max-width: none;
      text-align: left;
    }

    .jdoodle-rules {
      grid-template-columns: 1fr;
    }

    .jdoodle-actions > div {
      width: 100%;
      flex-wrap: wrap;
    }

    .editor-button {
      flex: 1 1 auto;
    }

    .jdoodle-editor textarea {
      min-height: 30rem;
      font-size: .72rem;
    }
  }

  @media (max-width: 440px) {
    .jdoodle-heading,
    .jdoodle-problem,
    .jdoodle-build-heading,
    .jdoodle-actions {
      padding-inline: .9rem;
    }

    .jdoodle-build-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .editor-button-primary {
      flex-basis: 100%;
    }
  }
</style>
