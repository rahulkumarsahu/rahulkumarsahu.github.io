        ArrayList<Integer> numbers = new ArrayList<>(List.of(1, 2, 3));
        System.out.println(new Solution().subsets(numbers));
    }
}

class Solution {
    public ArrayList<ArrayList<Integer>> subsets(ArrayList<Integer> numbers) {
        ArrayList<ArrayList<Integer>> allSubsets = new ArrayList<>();

        // Your backtracking solution goes here.

        return allSubsets;
    }
}`;
---

<section class="jdoodle-practice" aria-labelledby="jdoodle-practice-title">
  <header class="jdoodle-heading">
    <div>
      <span>PRACTICE WORKSPACE</span>
      <h2 id="jdoodle-practice-title">Understand the task, then write the code</h2>
    </div>
    <p>The explanation and completed solutions stay hidden until you choose to open them.</p>
  </header>

  <div class="jdoodle-split">
    <section class="jdoodle-problem" aria-labelledby="jdoodle-problem-title">
      <div class="jdoodle-side-label"><span>01</span> PROBLEM STATEMENT</div>
      <h3 id="jdoodle-problem-title">Generate every subset</h3>
      <p>You are given a set of distinct positive integers. Return every subset that can be formed from those values.</p>
      <p>A valid result must include the empty subset, every single value, every possible combination and the complete set.</p>

      <div class="jdoodle-rules">
        <div><span>INPUT</span><strong>A set of positive integers</strong></div>
        <div><span>RETURN</span><strong>All possible subsets</strong></div>
        <div><span>COUNT</span><strong><code>2^n</code> subsets</strong></div>
      </div>

      <div class="jdoodle-example" aria-label="Practice example">
        <span>EXAMPLE</span>
        <pre class="jdoodle-example-code">Input:  [1, 2, 3]
Output: [[], [1], [1, 2], [1, 2, 3],
         [1, 3], [2], [2, 3], [3]]</pre>
      </div>

      <a
        href="https://www.geeksforgeeks.org/problems/subsets-1613027340/1?itm_source=geeksforgeeks&itm_medium=article&itm_campaign=practice_card"
        target="_blank"
        rel="noopener noreferrer"
      >Open the official problem ↗</a>
    </section>

    <section class="jdoodle-build" aria-labelledby="jdoodle-build-title">
      <div class="jdoodle-build-heading">
        <div class="jdoodle-side-label"><span>02</span> BUILD YOUR OWN</div>
        <h3 id="jdoodle-build-title">Complete the backtracking method</h3>
      </div>

      {hasEmbed ? (
        <div class="jdoodle-embed" aria-label="JDoodle Java playground">
          <div data-pym-src={jdoodleEmbedUrl}></div>
        </div>
      ) : (
        <form
          class="jdoodle-editor"
          action="https://www.jdoodle.com/api/redirect-to-post/online-java-compiler"
          method="post"
          target="_blank"
        >
          <div class="jdoodle-editor-bar">
            <label for="subsets-starter-code">Main.java</label>
            <span>Java</span>
          </div>
          <textarea id="subsets-starter-code" name="initScript" spellcheck="false">{starterCode}</textarea>
          <div class="jdoodle-actions">
            <p>Edit the starter here, then compile and run it in JDoodle.</p>
            <button type="submit">Run code ↗</button>
          </div>
        </form>
      )}
    </section>
  </div>
</section>

{hasEmbed && (
  <script is:inline src="https://www.jdoodle.com/assets/jdoodle-pym.min.js" type="text/javascript"></script>
)}

<style>
  .jdoodle-practice {
    container: jdoodle-practice / inline-size;
    margin-bottom: 2.4rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    box-shadow: var(--shadow);
  }

  .jdoodle-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.2rem 1.3rem;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--indigo) 11%, transparent), transparent 52%),
      var(--surface-strong);
  }

  .jdoodle-heading span,
  .jdoodle-problem span,
  .jdoodle-editor-bar span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: .58rem;
    font-weight: 600;
    letter-spacing: .12em;
  }

  .jdoodle-heading h2 {
    margin: .25rem 0 0;
    padding: 0;
    border: 0;
    font-size: 1.45rem;
  }

  .jdoodle-heading > p {
    max-width: 18rem;
    margin: 0;
    color: var(--text-soft);
    font-size: .78rem;
    line-height: 1.55;
    text-align: right;
  }

  .jdoodle-split {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
  }

  .jdoodle-problem {
    min-width: 0;
    padding: 1.25rem 1.3rem 1.4rem;
    border-right: 1px solid var(--line);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--amber) 6%, transparent), transparent 46%),
      color-mix(in srgb, var(--surface) 92%, transparent);
  }

  .jdoodle-problem p {
    margin: .8rem 0 0;
    color: var(--text-soft);
    font-size: .88rem;
    line-height: 1.65;
  }

  .jdoodle-side-label {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .57rem;
    font-weight: 600;
    letter-spacing: .1em;
  }

  .jdoodle-side-label span {
    display: inline-grid;
    width: 1.55rem;
    height: 1.55rem;
    place-content: center;
    border: 1px solid var(--line-strong);
    border-radius: .4rem;
    color: var(--amber);
    letter-spacing: 0;
  }

  .jdoodle-problem h3,
  .jdoodle-build-heading h3 {
    margin: .65rem 0 0;
    color: var(--text);
    font-size: 1.15rem;
  }

  .jdoodle-rules {
    display: grid;
    gap: .55rem;
    margin-top: 1.15rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .jdoodle-rules > div {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    align-items: baseline;
    gap: .5rem;
  }

  .jdoodle-rules span,
  .jdoodle-example > span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: .54rem;
    font-weight: 600;
    letter-spacing: .1em;
  }

  .jdoodle-rules strong {
    color: var(--text);
    font-size: .75rem;
    font-weight: 500;
  }

  .jdoodle-rules code {
    color: var(--cyan);
    font-family: var(--font-mono);
  }

  .jdoodle-example {
    margin-top: 1rem;
  }

  .jdoodle-example pre {
    overflow-x: auto;
    margin: .5rem 0 0;
    padding: .75rem;
    border: 1px solid var(--line);
    border-radius: .55rem;
    background: var(--surface-strong);
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: .62rem;
    line-height: 1.65;
    white-space: pre;
  }

  .jdoodle-problem > a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--indigo);
    font-size: .74rem;
    font-weight: 600;
  }

  .jdoodle-build {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: #0b1020;
  }

  .jdoodle-build-heading {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    background: #151d31;
  }

  .jdoodle-build-heading .jdoodle-side-label {
    color: #97a7c0;
  }

  .jdoodle-build-heading h3 {
    color: #eef3ff;
    font-size: .92rem;
  }

  .jdoodle-editor {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
  }

  .jdoodle-editor-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .68rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    background: #11182a;
  }

  .jdoodle-editor-bar label {
    color: #e7ecf7;
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 600;
  }

  .jdoodle-editor textarea {
    display: block;
    width: 100%;
    min-height: 28rem;
    flex: 1;
    resize: vertical;
    padding: 1rem 1.15rem;
    border: 0;
    border-radius: 0;
    outline-offset: -3px;
    background: #0b1020;
    color: #d9e2f2;
    font-family: var(--font-mono);
    font-size: .72rem;
    line-height: 1.75;
    tab-size: 4;
  }

  .jdoodle-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .9rem 1rem;
    border-top: 1px solid rgba(255, 255, 255, .1);
    background: #11182a;
  }

  .jdoodle-actions p {
    margin: 0;
    color: #aebbd1;
    font-size: .72rem;
    line-height: 1.5;
  }

  .jdoodle-actions button {
    min-height: 2.55rem;
    flex: 0 0 auto;
    padding: .55rem .85rem;
    border: 1px solid #8b8dff;
    border-radius: .6rem;
    background: #7375f5;
    color: white;
    font-size: .76rem;
    font-weight: 600;
    cursor: pointer;
  }

  .jdoodle-embed {
    flex: 1;
    min-height: 34rem;
    padding: .75rem;
    background: var(--surface-strong);
  }

  @container jdoodle-practice (max-width: 720px) {
    .jdoodle-split {
      grid-template-columns: 1fr;
    }

    .jdoodle-problem {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 620px) {
    .jdoodle-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .jdoodle-heading > p {
      max-width: none;
      text-align: left;
    }

    .jdoodle-editor textarea {
      min-height: 31rem;
      font-size: .68rem;
    }

    .jdoodle-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .jdoodle-actions button {
      width: 100%;
    }
  }
</style>
