---
import { MASTER_PROBLEMS, MASTER_TOPICS } from '../data/dsaMasterSheet';

const difficultyOrder = ['easy', 'medium', 'hard'] as const;
const counts = {
  easy: MASTER_PROBLEMS.filter((problem) => problem.difficulty === 'easy').length,
  medium: MASTER_PROBLEMS.filter((problem) => problem.difficulty === 'medium').length,
  hard: MASTER_PROBLEMS.filter((problem) => problem.difficulty === 'hard').length,
};
const groupedTopics = MASTER_TOPICS.map((topic) => ({
  ...topic,
  counts: Object.fromEntries(difficultyOrder.map((difficulty) => [
    difficulty,
    MASTER_PROBLEMS.filter((problem) => problem.topic === topic.id && problem.difficulty === difficulty).length,
  ])),
  total: MASTER_PROBLEMS.filter((problem) => problem.topic === topic.id).length,
}));
const platforms = [...new Set(MASTER_PROBLEMS.map((problem) => problem.platform))].sort();
---

<section class="master-sheet" data-master-sheet>
  <header class="master-heading">
    <div>
      <p class="section-index">DSA practice directory</p>
      <h1>DSA Master Sheet</h1>
      <p>Find a problem by topic, difficulty, pattern, or platform. Each link opens the original practice source.</p>
    </div>
    <div class="master-heading-actions">
      <a class="button button-secondary" href="/posts/solving-dsa-independently/">DSA roadmap</a>
      <a class="button button-secondary" href="/dsa/companies/">Company practice</a>
      <button type="button" class="button button-secondary" data-reset-filters>Reset filters</button>
    </div>
  </header>

  <div class="master-stats" aria-label="Master sheet summary">
    <article><span>Questions</span><strong>{MASTER_PROBLEMS.length}</strong></article>
    <article><span>Topics</span><strong>{MASTER_TOPICS.length}</strong></article>
    <article><span>Easy</span><strong>{counts.easy}</strong></article>
    <article><span>Medium</span><strong>{counts.medium}</strong></article>
    <article><span>Hard</span><strong>{counts.hard}</strong></article>
  </div>

  <section class="master-filters" aria-labelledby="master-filter-title">
    <h2 id="master-filter-title">Filter the question list</h2>
    <label class="master-search"><span>Search</span><input type="search" placeholder="Title, topic, or pattern" data-master-search /></label>
    <label><span>Topic</span><select data-topic-filter><option value="all">All topics</option>{MASTER_TOPICS.map((topic) => <option value={topic.id}>{topic.title}</option>)}</select></label>
    <label><span>Difficulty</span><select data-difficulty-filter><option value="all">All difficulties</option><option value="easy">Easy</option><option value="medium">Medium</option><option value="hard">Hard</option></select></label>
    <label><span>Platform</span><select data-platform-filter><option value="all">All platforms</option>{platforms.map((platform) => <option value={platform.toLowerCase()}>{platform}</option>)}</select></label>
    <button type="button" aria-pressed="false" data-important-filter>Important only</button>
  </section>

  <p class="master-result-bar" role="status" aria-live="polite"><strong data-visible-count>{MASTER_PROBLEMS.length}</strong> questions shown</p>

  <div class="master-topics" data-master-topics>
    {groupedTopics.map((topic, topicIndex) => (
      <details class="master-topic" data-topic-group={topic.id} open={topicIndex === 0}>
        <summary>
          <span class="topic-chevron" aria-hidden="true">›</span>
          <div><strong>{topic.title}</strong><small>{topic.description}</small></div>
          <span class="topic-question-count" data-topic-visible>{topic.total} questions</span>
        </summary>
        <div class="master-difficulties">
          {difficultyOrder.map((difficulty) => {
            const problemCount = Number(topic.counts[difficulty] ?? 0);
            return problemCount > 0 && (
              <details class="master-difficulty" data-difficulty-group={difficulty} open={difficulty === 'easy'}>
                <summary>
                  <span class="difficulty-chevron" aria-hidden="true">›</span>
                  <strong>{difficulty}</strong>
                  <i data-difficulty-visible>{problemCount}</i>
                </summary>
                <div class="problem-list" data-problem-list data-topic={topic.id} data-difficulty={difficulty}></div>
                <button type="button" class="load-more-problems" data-load-more hidden>Show more questions</button>
              </details>
            );
          })}
        </div>
      </details>
    ))}
  </div>

  <div class="master-empty" data-master-empty hidden>
    <strong>No questions match these filters.</strong>
    <p>Try a shorter search or reset one of the filters.</p>
    <button type="button" class="button button-secondary" data-empty-reset>Reset filters</button>
  </div>

  <script type="application/json" data-master-data set:html={JSON.stringify(MASTER_PROBLEMS)} />
  <noscript><p class="master-noscript">Enable JavaScript to browse this question directory.</p></noscript>
</section>

<script>
  const PAGE_SIZE = 30;
  type MasterProblem = {
    id: string;
    title: string;
    topic: string;
    difficulty: string;
    patterns: string[];
    platform: string;
    url: string;
    linkType: 'direct' | 'search';
    important: boolean;
  };

  const escapeMarkup = (value: string) => value.replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
  })[character] || character);

  document.querySelectorAll<HTMLElement>('[data-master-sheet]').forEach((sheet) => {
    const dataElement = sheet.querySelector<HTMLScriptElement>('[data-master-data]');
    let problems: MasterProblem[] = [];
    try { problems = JSON.parse(dataElement?.textContent || '[]'); } catch { problems = []; }

    const search = sheet.querySelector<HTMLInputElement>('[data-master-search]');
    const topicFilter = sheet.querySelector<HTMLSelectElement>('[data-topic-filter]');
    const difficultyFilter = sheet.querySelector<HTMLSelectElement>('[data-difficulty-filter]');
    const platformFilter = sheet.querySelector<HTMLSelectElement>('[data-platform-filter]');
    const importantFilter = sheet.querySelector<HTMLButtonElement>('[data-important-filter]');
    const topicTitles = new Map<string, string>();
    sheet.querySelectorAll<HTMLDetailsElement>('[data-topic-group]').forEach((group) => {
      topicTitles.set(group.dataset.topicGroup || '', group.querySelector('summary strong')?.textContent?.trim() || '');
    });
    let filteredProblems = problems;

    const problemMarkup = (problem: MasterProblem, index: number) => {
      const action = problem.linkType === 'direct' ? 'Open' : 'Find';
      const tags = problem.patterns.slice(0, 3)
        .map((pattern) => `<span>${escapeMarkup(pattern.replaceAll('-', ' '))}</span>`)
        .join('');
      return `<article class="master-problem">
        <span class="problem-number">${String(index + 1).padStart(2, '0')}</span>
        <div class="problem-copy"><h3>${escapeMarkup(problem.title)}</h3><div>${tags}</div></div>
        <span class="difficulty-chip difficulty-${escapeMarkup(problem.difficulty)}">${escapeMarkup(problem.difficulty)}</span>
        <span class="platform-chip">${escapeMarkup(problem.platform)}</span>
        ${problem.important ? '<span class="important-chip"><span aria-hidden="true">★</span> Important</span>' : '<span></span>'}
        <a href="${escapeMarkup(problem.url)}" target="_blank" rel="noopener noreferrer" class="open-problem" aria-label="${action} ${escapeMarkup(problem.title)} on ${escapeMarkup(problem.platform)}">${action} <span aria-hidden="true">↗</span></a>
      </article>`;
    };

    const renderDifficulty = (group: HTMLDetailsElement, reset = false) => {
      const topicGroup = group.closest<HTMLDetailsElement>('[data-topic-group]');
      if (!group.open || !topicGroup?.open || topicGroup.hidden || group.hidden) return;
      const list = group.querySelector<HTMLElement>('[data-problem-list]');
      const more = group.querySelector<HTMLButtonElement>('[data-load-more]');
      if (!list || !more) return;
      const matches = filteredProblems.filter((problem) => problem.topic === list.dataset.topic && problem.difficulty === list.dataset.difficulty);
      const previousLimit = reset ? 0 : Number(list.dataset.renderedCount || 0);
      const limit = Math.min(matches.length, previousLimit || PAGE_SIZE);
      list.dataset.renderedCount = String(limit);
      list.innerHTML = matches.slice(0, limit).map((problem, index) => problemMarkup(problem, index)).join('');
      more.hidden = limit >= matches.length;
      more.textContent = `Show ${Math.min(PAGE_SIZE, matches.length - limit)} more of ${matches.length}`;
    };

    const applyFilters = () => {
      const term = search?.value.trim().toLowerCase() || '';
      filteredProblems = problems.filter((problem) => {
        const searchable = `${problem.title} ${topicTitles.get(problem.topic) || ''} ${problem.patterns.join(' ')}`.toLowerCase();
        return (!term || searchable.includes(term))
          && (!topicFilter || topicFilter.value === 'all' || problem.topic === topicFilter.value)
          && (!difficultyFilter || difficultyFilter.value === 'all' || problem.difficulty === difficultyFilter.value)
          && (!platformFilter || platformFilter.value === 'all' || problem.platform.toLowerCase() === platformFilter.value)
          && (importantFilter?.getAttribute('aria-pressed') !== 'true' || problem.important);
      });

      const output = sheet.querySelector<HTMLElement>('[data-visible-count]');
      if (output) output.textContent = String(filteredProblems.length);
      sheet.querySelectorAll<HTMLDetailsElement>('[data-topic-group]').forEach((topicGroup) => {
        const topicMatches = filteredProblems.filter((problem) => problem.topic === topicGroup.dataset.topicGroup);
        topicGroup.hidden = topicMatches.length === 0;
        const topicCount = topicGroup.querySelector<HTMLElement>('[data-topic-visible]');
        if (topicCount) topicCount.textContent = `${topicMatches.length} ${topicMatches.length === 1 ? 'question' : 'questions'}`;
        topicGroup.querySelectorAll<HTMLDetailsElement>('[data-difficulty-group]').forEach((difficultyGroup) => {
          const count = topicMatches.filter((problem) => problem.difficulty === difficultyGroup.dataset.difficultyGroup).length;
          difficultyGroup.hidden = count === 0;
          const difficultyCount = difficultyGroup.querySelector<HTMLElement>('[data-difficulty-visible]');
          if (difficultyCount) difficultyCount.textContent = String(count);
        });
      });

      if (!sheet.querySelector<HTMLDetailsElement>('[data-topic-group][open]:not([hidden])')) {
        sheet.querySelector<HTMLDetailsElement>('[data-topic-group]:not([hidden])')?.setAttribute('open', '');
      }
      sheet.querySelectorAll<HTMLDetailsElement>('[data-difficulty-group]').forEach((group) => renderDifficulty(group, true));
      const empty = sheet.querySelector<HTMLElement>('[data-master-empty]');
      if (empty) empty.hidden = filteredProblems.length !== 0;
    };

    const resetFilters = () => {
      if (search) search.value = '';
      if (topicFilter) topicFilter.value = 'all';
      if (difficultyFilter) difficultyFilter.value = 'all';
      if (platformFilter) platformFilter.value = 'all';
      importantFilter?.setAttribute('aria-pressed', 'false');
      applyFilters();
    };

    sheet.querySelectorAll<HTMLDetailsElement>('[data-topic-group], [data-difficulty-group]').forEach((details) => {
      details.addEventListener('toggle', () => {
        if (details.matches('[data-topic-group]') && details.open) {
          details.querySelectorAll<HTMLDetailsElement>('[data-difficulty-group]').forEach((group) => renderDifficulty(group));
        } else if (details.matches('[data-difficulty-group]')) {
          renderDifficulty(details);
        }
      });
    });

    sheet.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const more = target?.closest<HTMLButtonElement>('[data-load-more]');
      if (!more) return;
      const group = more.closest<HTMLDetailsElement>('[data-difficulty-group]');
      const list = group?.querySelector<HTMLElement>('[data-problem-list]');
      if (group && list) {
        list.dataset.renderedCount = String(Number(list.dataset.renderedCount || 0) + PAGE_SIZE);
        renderDifficulty(group);
      }
    });

    search?.addEventListener('input', applyFilters);
    [topicFilter, difficultyFilter, platformFilter].forEach((control) => control?.addEventListener('change', applyFilters));
    importantFilter?.addEventListener('click', () => {
      importantFilter.setAttribute('aria-pressed', String(importantFilter.getAttribute('aria-pressed') !== 'true'));
      applyFilters();
    });
    sheet.querySelector('[data-reset-filters]')?.addEventListener('click', resetFilters);
    sheet.querySelector('[data-empty-reset]')?.addEventListener('click', resetFilters);
    applyFilters();
  });
</script>

<style>
  .master-sheet { padding: clamp(1.5rem, 3vw, 3rem) 0 5rem; }
  .master-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .master-heading h1 { margin: .35rem 0 .5rem; font-size: clamp(2.2rem, 5vw, 4.5rem); letter-spacing: -.04em; }
  .master-heading p:last-child { max-width: 48rem; margin: 0; color: var(--text-soft); line-height: 1.65; }
  .master-heading-actions { display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: .6rem; }
  .master-stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 1px solid var(--line); background: var(--surface); }
  .master-stats article { display: grid; gap: .35rem; min-width: 0; padding: 1rem; }
  .master-stats article + article { border-left: 1px solid var(--line); }
  .master-stats span { color: var(--text-faint); font: var(--type-technical) var(--font-mono); }
  .master-stats strong { font-size: 1.55rem; }
  .master-filters { display: grid; grid-template-columns: minmax(15rem, 1.5fr) repeat(3, minmax(9rem, .75fr)) auto; gap: .65rem; margin-top: 1rem; padding: 1rem; border: 1px solid var(--line); background: var(--surface-strong); }
  .master-filters h2 { grid-column: 1 / -1; margin: 0 0 .2rem; font-size: 1.05rem; }
  .master-filters label { display: grid; gap: .35rem; min-width: 0; }
  .master-filters label > span { color: var(--text-faint); font-size: var(--type-metadata); }
  .master-filters input, .master-filters select, .master-filters button { width: 100%; min-height: var(--control-min); border: 1px solid var(--line-strong); border-radius: var(--radius-control); background: var(--surface); color: var(--text); font: inherit; font-size: var(--type-small); }
  .master-filters input { padding: 0 .8rem; }
  .master-filters select { padding: 0 2rem 0 .75rem; }
  .master-filters button { align-self: end; padding: .6rem .8rem; white-space: nowrap; cursor: pointer; }
  .master-filters button[aria-pressed='true'] { border-color: var(--amber); color: var(--amber); }
  .master-result-bar { margin: 0; padding: .8rem .15rem; color: var(--text-faint); font: var(--type-technical) var(--font-mono); }
  .master-result-bar strong { color: var(--text); }
  .master-topics { border: 1px solid var(--line); }
  .master-topic + .master-topic { border-top: 1px solid var(--line); }
  .master-topic > summary { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .8rem; min-height: 5rem; padding: .9rem 1rem; background: var(--surface); cursor: pointer; list-style: none; }
  .master-topic > summary::-webkit-details-marker, .master-difficulty > summary::-webkit-details-marker { display: none; }
  .topic-chevron, .difficulty-chevron { color: var(--amber); font-size: 1.6rem; transition: transform .2s ease; }
  .master-topic[open] > summary .topic-chevron, .master-difficulty[open] > summary .difficulty-chevron { transform: rotate(90deg); }
  .master-topic summary strong { display: block; font-family: var(--font-display); font-size: 1.2rem; }
  .master-topic summary small { display: block; max-width: 48rem; margin-top: .2rem; color: var(--text-faint); font-size: var(--type-metadata); line-height: 1.45; }
  .topic-question-count { color: var(--text-faint); font: var(--type-technical) var(--font-mono); white-space: nowrap; }
  .master-difficulties { display: grid; gap: .5rem; padding: .8rem; border-top: 1px solid var(--line); background: var(--bg); }
  .master-difficulty > summary { display: flex; align-items: center; gap: .5rem; min-height: var(--control-min); padding: .35rem .45rem; cursor: pointer; list-style: none; }
  .master-difficulty > summary strong { font-size: var(--type-small); text-transform: capitalize; }
  .master-difficulty > summary i { display: grid; min-width: 1.75rem; min-height: 1.75rem; place-items: center; background: var(--surface); color: var(--text-faint); font-size: var(--type-technical); font-style: normal; }
  .problem-list { border: 1px solid var(--line); }
  .master-problem { display: grid; grid-template-columns: 2.25rem minmax(12rem, 1fr) auto auto auto auto; align-items: center; gap: .75rem; min-height: 4rem; padding: .65rem .8rem; background: var(--surface-strong); }
  .master-problem + .master-problem { border-top: 1px solid var(--line); }
  .problem-number { color: var(--text-faint); font: var(--type-technical) var(--font-mono); }
  .problem-copy { min-width: 0; }
  .problem-copy h3 { margin: 0 0 .3rem; font-size: var(--type-small); }
  .problem-copy > div { display: flex; flex-wrap: wrap; gap: .25rem; }
  .problem-copy > div span { color: var(--text-faint); font-size: var(--type-metadata); }
  .problem-copy > div span + span::before { content: '·'; margin-right: .25rem; }
  .difficulty-chip, .platform-chip, .important-chip { font: var(--type-technical) var(--font-mono); text-transform: capitalize; white-space: nowrap; }
  .difficulty-chip { color: var(--text-soft); }
  .difficulty-easy { color: var(--green); }
  .difficulty-medium { color: var(--amber); }
  .difficulty-hard { color: #df756e; }
  .platform-chip { color: var(--text-faint); }
  .important-chip { color: var(--amber); }
  .open-problem, .load-more-problems { min-height: var(--control-min); display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--line-strong); border-radius: var(--radius-control); background: var(--surface); color: var(--text); font-size: var(--type-small); text-decoration: none; }
  .open-problem { padding: .45rem .7rem; }
  .load-more-problems { width: 100%; margin-top: .5rem; cursor: pointer; }
  .load-more-problems[hidden] { display: none; }
  .master-empty { padding: 3rem 1rem; border: 1px solid var(--line); text-align: center; }
  .master-empty p { color: var(--text-faint); }
  .master-noscript { padding: 1rem; border: 1px solid var(--line); }
  .master-filters :is(input, select, button):focus-visible, .master-sheet :is(summary, a, button):focus-visible { outline: 3px solid color-mix(in srgb, var(--indigo) 45%, transparent); outline-offset: 2px; }
  @media (max-width: 980px) {
    .master-heading { align-items: start; flex-direction: column; }
    .master-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .master-filters h2 { grid-column: 1 / -1; }
    .master-search { grid-column: 1 / -1; }
    .master-problem { grid-template-columns: 2.25rem minmax(0, 1fr) auto auto; }
    .platform-chip, .master-problem > .important-chip, .master-problem > span:empty { display: none; }
  }
  @media (max-width: 640px) {
    .master-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .master-stats article + article { border-left: 0; }
    .master-stats article:nth-child(even) { border-left: 1px solid var(--line); }
    .master-stats article:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .master-filters { grid-template-columns: 1fr; }
    .master-filters h2, .master-search { grid-column: auto; }
    .master-topic > summary { grid-template-columns: auto minmax(0, 1fr); }
    .topic-question-count { grid-column: 2; }
    .master-problem { grid-template-columns: 1.75rem minmax(0, 1fr) auto; align-items: start; }
    .difficulty-chip { grid-column: 2; justify-self: start; }
    .open-problem { grid-column: 3; grid-row: 1 / span 2; }
  }
  @media (prefers-reduced-motion: reduce) { .topic-chevron, .difficulty-chevron { transition: none; } }
</style>
