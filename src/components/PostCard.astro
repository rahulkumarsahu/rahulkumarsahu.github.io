---
import type { Post } from '../lib/posts';
import { estimateReadTime, formatDate, getPostSlug, getTopicForPost } from '../lib/posts';
import PostBanner from './PostBanner.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const topic = getTopicForPost(post);
const slug = getPostSlug(post);
---

<article
  class:list={['post-card', `post-card-${topic.accent}`, { 'post-card-featured': featured }]}
  data-post-slug={slug}
  data-filter-difficulty={post.data.difficulty ?? 'basics'}
  data-filter-content-type={post.data.contentType ?? 'concept'}
>
  <a class="post-card-link" href={`/posts/${slug}/`} aria-label={`Read ${post.data.title}`}></a>
  <PostBanner {post} />
  <div class="post-card-body">
    <div class="post-card-meta">
      <span>{formatDate(post.data.date)}</span>
      <span>{estimateReadTime(post)} min read</span>
    </div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description || `Explore ${post.data.title} through practical examples and engineering trade-offs.`}</p>
    <div class="post-card-footer">
      <span>{topic.title}</span>
      <span aria-hidden="true">Read note ↗</span>
    </div>
  </div>
</article>
