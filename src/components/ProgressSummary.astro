---
interface Props {
  postSlugs: string[];
  label?: string;
}

const { postSlugs, label = 'Your progress in this section' } = Astro.props;
---

<aside class="progress-summary" data-progress-summary data-post-slugs={JSON.stringify(postSlugs)} aria-label={label}>
  <div>
    <span>LOCAL PROGRESS</span>
    <strong>{label}</strong>
  </div>
  <dl>
    <div><dt data-summary-solved>0/{postSlugs.length}</dt><dd>Solved</dd></div>
    <div><dt data-summary-attempted>0</dt><dd>Attempted</dd></div>
    <div><dt data-summary-revisit>0</dt><dd>Revisit</dd></div>
    <div><dt data-summary-bookmarks>0</dt><dd>Bookmarked</dd></div>
  </dl>
  <small>Saved only in this browser</small>
  <a href="/learning/">My learning ↗</a>
</aside>

<script>
  import { KEYS, readRecord } from '../lib/learningStorage';

  const updateProgressSummaries = () => {
    const progress = readRecord<string>(KEYS.progress);
    const bookmarks = readRecord<boolean>(KEYS.bookmarks);

    document.querySelectorAll<HTMLElement>('[data-progress-summary]').forEach((summary) => {
      let slugs: string[] = [];
      try {
        slugs = JSON.parse(summary.dataset.postSlugs || '[]');
      } catch {
        slugs = [];
      }

      const count = (state: string) => slugs.filter((slug) => progress[slug] === state).length;
      const setText = (selector: string, value: string) => {
        const target = summary.querySelector<HTMLElement>(selector);
        if (target) target.textContent = value;
      };

      setText('[data-summary-solved]', `${count('solved')}/${slugs.length}`);
      setText('[data-summary-attempted]', String(count('attempted')));
      setText('[data-summary-revisit]', String(count('revisit')));
      setText('[data-summary-bookmarks]', String(slugs.filter((slug) => bookmarks[slug] === true).length));
    });
  };

  updateProgressSummaries();
  window.addEventListener('storage', updateProgressSummaries);
  window.addEventListener('pageshow', updateProgressSummaries);
  window.addEventListener('atlas-learning-state-changed', updateProgressSummaries);
</script>

<style>
  .progress-summary {
    display: grid;
    grid-template-columns: minmax(12rem, 1.4fr) minmax(18rem, 2fr) auto auto;
    align-items: center;
    gap: 1rem;
    margin-top: 1.1rem;
    padding: .95rem 1rem;
    border: 1px solid var(--line);
    border-radius: .8rem;
    background: color-mix(in srgb, var(--surface-strong) 86%, transparent);
  }

  .progress-summary > div:first-child {
    display: grid;
    gap: .2rem;
  }

  .progress-summary > div:first-child span,
  .progress-summary > small {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: .55rem;
    letter-spacing: .08em;
  }

  .progress-summary > div:first-child span { color: var(--cyan); }
  .progress-summary > div:first-child strong { font-size: .78rem; }
  .progress-summary > a { font-size: .62rem; text-decoration: underline; text-underline-offset: .18em; }

  .progress-summary dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
  }

  .progress-summary dl div {
    padding-inline: .75rem;
    border-left: 1px solid var(--line);
  }

  .progress-summary dt {
    color: var(--text);
    font-size: .8rem;
    font-weight: 700;
  }

  .progress-summary dd {
    margin: .12rem 0 0;
    color: var(--text-faint);
    font-size: .57rem;
  }

  @media (max-width: 760px) {
    .progress-summary { grid-template-columns: 1fr; }
    .progress-summary dl div:first-child { border-left: 0; padding-left: 0; }
  }

  @media (max-width: 440px) {
    .progress-summary dl { grid-template-columns: repeat(2, 1fr); gap: .7rem 0; }
    .progress-summary dl div:nth-child(3) { border-left: 0; padding-left: 0; }
  }
</style>
