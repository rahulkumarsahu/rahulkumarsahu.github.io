---
interface Hint {
  title: string;
  text: string;
}

const { hints, problemSlug } = Astro.props as { hints: Hint[]; problemSlug: string };
---

<section class="progressive-hints" aria-labelledby={`hints-${problemSlug}`}>
  <div class="hint-heading">
    <div>
      <span>NEED A NUDGE?</span>
      <h3 id={`hints-${problemSlug}`}>Reveal only the help you need</h3>
    </div>
    <small>Hints become more specific one step at a time.</small>
  </div>
  <div class="hint-list">
    {hints.map((hint, index) => (
      <details class="hint-card">
        <summary>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{hint.title}</strong>
        </summary>
        <p>{hint.text}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .progressive-hints {
    padding: 1.15rem 1.3rem 1.3rem;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-strong) 82%, transparent);
  }

  .hint-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .hint-heading span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: .56rem;
    font-weight: 600;
    letter-spacing: .12em;
  }

  .hint-heading h3 {
    margin: .32rem 0 0;
    font-size: 1rem;
  }

  .hint-heading small {
    max-width: 16rem;
    color: var(--text-faint);
    font-size: .68rem;
    line-height: 1.5;
    text-align: right;
  }

  .hint-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
    margin-top: .9rem;
  }

  .hint-card {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: .65rem;
    background: color-mix(in srgb, var(--surface) 84%, transparent);
  }

  .hint-card summary {
    display: grid;
    grid-template-columns: 1.55rem 1fr;
    align-items: center;
    gap: .55rem;
    min-height: 4rem;
    padding: .7rem;
    cursor: pointer;
    list-style: none;
  }

  .hint-card summary::-webkit-details-marker {
    display: none;
  }

  .hint-card summary span {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--indigo) 42%, var(--line));
    border-radius: 50%;
    color: var(--indigo);
    font-family: var(--font-mono);
    font-size: .57rem;
  }

  .hint-card summary strong {
    color: var(--text);
    font-size: .72rem;
    line-height: 1.4;
  }

  .hint-card p {
    margin: 0;
    padding: 0 .8rem .85rem;
    color: var(--text-soft);
    font-size: .73rem;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .hint-heading {
      align-items: start;
      flex-direction: column;
    }

    .hint-heading small {
      max-width: none;
      text-align: left;
    }

    .hint-list {
      grid-template-columns: 1fr;
    }

    .hint-card summary {
      min-height: 3.4rem;
    }
  }
</style>
