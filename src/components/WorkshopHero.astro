---
import type { Post } from '../lib/posts';
import { estimateReadTime, getPostSlug, getTopicForPost } from '../lib/posts';
import HorizontalRailControls from './HorizontalRailControls.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const recentPosts = posts.slice(0, 4);
const chapterLinks = [
  { number: '01', title: 'DSA\u00a0from the\u00a0beginning', href: '/topics/dsa/' },
  { number: '02', title: 'Java\u00a0backend engineering', href: '/topics/java/' },
  { number: '03', title: 'System\u00a0design interviews', href: '/topics/system-design/' },
  { number: '04', title: 'Production URL\u00a0shortener', href: '/projects/production-url-shortener/' },
];
---

<section class="workshop-opening" aria-labelledby="workshop-title">
  <img class="workshop-paper" src="/assets/plates/paper-grain.webp" alt="" width="1254" height="1254" aria-hidden="true" />

  <nav class="workshop-chapters" aria-label="Start with a learning goal">
    <HorizontalRailControls targetId="workshop-chapter-list" label="Learning paths" mobileOnly />
    <ol id="workshop-chapter-list" tabindex="0" aria-label="Learning paths. Scroll horizontally for more.">
      {chapterLinks.map((chapter, index) => (
        <li class:list={{ 'is-current': index === 0 }}>
          <a href={chapter.href}>
            <span>{chapter.number}</span>
            <strong>{chapter.title}</strong>
            {index === 0 && <i aria-hidden="true">→</i>}
          </a>
        </li>
      ))}
    </ol>
    <p>Four paths.<br />A deeper you.</p>
    <small>Version 1.0.0<br />Build · learn · ship</small>
  </nav>

  <div class="workshop-statement">
    <p class="workshop-kicker">An engineering learning workshop</p>
    <h1 id="workshop-title"><span>The System</span><span>Design Atlas</span></h1>
    <h2>Learn the code. Understand the system.</h2>
    <p class="workshop-intro">Practical guides for DSA, Java, application design and distributed systems.</p>
    <a class="workshop-action" href="#learning-paths">
      Explore the Atlas <span aria-hidden="true">→</span>
    </a>
    <p class="workshop-motto">Same curiosity.<br />Bigger systems.</p>
    <p class="workshop-credit"><strong>Rahul Kumar</strong><span>Engineer</span><span>Writer</span><span>Lifelong learner</span></p>
  </div>

  <div class="workshop-portrait">
    <img
      src="/assets/plates/rahul-system-portrait.webp"
      alt="Illustration of Rahul Kumar arranging backend system components on a technical drawing"
      width="1570"
      height="1650"
      fetchpriority="high"
    />
  </div>

  <aside class="workshop-margin" aria-label="How to use the Atlas">
    <p class="workshop-folio">Knowledge in systems <span>/ 001</span></p>
    <div class="architecture-note" aria-label="Users connect through a load balancer to application servers and a database">
      <span class="architecture-users">Users</span>
      <span class="architecture-balancer">Load balancer</span>
      <span class="architecture-app app-one">App</span>
      <span class="architecture-app app-two">App</span>
      <span class="architecture-app app-three">App</span>
      <span class="architecture-database">Database</span>
    </div>
    <p class="architecture-caption">Scale · reliability · learning</p>
    <blockquote>“Systems thinking today. A better tomorrow.”<cite>Rahul</cite></blockquote>
    <div class="workshop-compass" aria-hidden="true"><span>N</span><i></i><b></b><small>W</small><em>E</em><strong>S</strong></div>
    <p class="workshop-method">Explore<br />Learn<br />Build<br />Repeat</p>
  </aside>
</section>

<section class="workshop-recent" id="recent-writing" aria-labelledby="workshop-recent-title">
  <header>
    <p><strong id="workshop-recent-title">Recently published</strong></p>
    <div class="workshop-recent-actions">
      <small>Fresh writing for practical engineers</small>
      <HorizontalRailControls targetId="workshop-recent-list" label="Recently published articles" />
    </div>
  </header>
  <div class="workshop-recent-list" id="workshop-recent-list" tabindex="0" aria-label="Recently published articles. Scroll horizontally for more.">
    {recentPosts.map((post) => {
      const postTopic = getTopicForPost(post);
      return (
        <article>
          <div>
            <p>{postTopic.shortTitle} · {estimateReadTime(post)} min read</p>
            <h3><a href={`/posts/${getPostSlug(post)}/`}>{post.data.title}</a></h3>
            <span>{post.data.description}</span>
          </div>
        </article>
      );
    })}
  </div>
</section>
