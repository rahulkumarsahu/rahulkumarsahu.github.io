---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<aside class="engineering-connection" aria-labelledby={`engineering-${title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`}>
  <span>Where this appears in real systems</span>
  <h2 id={`engineering-${title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`}>{title}</h2>
  <p>{text}</p>
</aside>

<style>
  .engineering-connection {
    margin: 2rem 0;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--cyan) 34%, var(--line));
    border-radius: 2px;
    background: color-mix(in srgb, var(--cyan) 6%, var(--surface));
  }
  .engineering-connection span { color: var(--cyan); font-family: var(--font-mono); font-size: .56rem; font-weight: 650; letter-spacing: .1em; }
  .engineering-connection h2 { margin: .38rem 0 0; padding: 0; border: 0; font-size: 1rem; }
  .engineering-connection p { margin: .55rem 0 0; color: var(--text-soft); font-size: .78rem; line-height: 1.65; }
</style>
