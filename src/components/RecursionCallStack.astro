<section class="recursion-tree-lab" data-recursion-lab aria-labelledby="recursion-tree-title">
  <header class="recursion-tree-heading">
    <div><span>RECURSION, FRAME BY FRAME</span><h3 id="recursion-tree-title">Watch the call tree grow, stop, and unwind.</h3></div>
    <p>Follow <code>printNTimes(3)</code>. Every step explains what Java is doing and why.</p>
  </header>

  <div class="recursion-stage">
    <section class="recursion-tree-panel" aria-labelledby="call-tree-label">
      <div class="recursion-panel-title"><div><span>01</span><strong id="call-tree-label">Call tree</strong></div><small>calls travel down · returns travel up</small></div>
      <div class="recursion-tree" aria-label="Recursion tree from n equals 3 to the n equals 0 base case">
        <div class="tree-node" data-tree-node="3"><small>CALL 1</small><strong>printNTimes(3)</strong><span>prints once</span></div>
        <div class="tree-edge" data-tree-edge="3" aria-hidden="true"><span>calls n − 1</span></div>
        <div class="tree-node" data-tree-node="2"><small>CALL 2</small><strong>printNTimes(2)</strong><span>prints once</span></div>
        <div class="tree-edge" data-tree-edge="2" aria-hidden="true"><span>calls n − 1</span></div>
        <div class="tree-node" data-tree-node="1"><small>CALL 3</small><strong>printNTimes(1)</strong><span>prints once</span></div>
        <div class="tree-edge" data-tree-edge="1" aria-hidden="true"><span>calls n − 1</span></div>
        <div class="tree-node tree-base" data-tree-node="0"><small>BASE CASE</small><strong>printNTimes(0)</strong><span>returns immediately</span></div>
      </div>
      <div class="recursion-tree-legend" aria-label="Tree state legend"><span><i></i> Not reached</span><span><i class="is-active"></i> Running</span><span><i class="is-waiting"></i> Waiting</span><span><i class="is-done"></i> Returned</span></div>
    </section>

    <aside class="recursion-explain-panel" aria-labelledby="step-explanation-label">
      <div class="recursion-panel-title"><div><span>02</span><strong id="step-explanation-label">What happens now</strong></div><small data-recursion-counter>Step 0 of 8</small></div>
      <div class="recursion-narration" aria-live="polite"><span data-recursion-phase>READY</span><h4 data-recursion-action>Start with one question</h4><p data-recursion-note>Press Next. Follow calls down to the base case, then every return back to main.</p></div>
      <div class="recursion-rule"><span>THE RULE</span><code>print once → solve n − 1</code><p>The current call pauses while the smaller call runs. Its frame stays alive so Java knows where to return.</p></div>
      <div class="recursion-stack"><div><span>CALL STACK</span><small data-recursion-depth>0 frames</small></div><div data-recursion-stack><p>No recursive calls yet.</p></div></div>
      <div class="recursion-output"><div><span>OUTPUT</span><small data-recursion-output-count>0 lines</small></div><pre data-recursion-output>Nothing printed yet</pre></div>
    </aside>
  </div>

  <footer class="recursion-controls">
    <div class="recursion-progress" aria-hidden="true"><i data-recursion-progress></i></div>
    <div><button type="button" data-recursion-reset>Reset</button><button type="button" data-recursion-previous>← Previous</button><button class="is-primary" type="button" data-recursion-next>Next step →</button><button type="button" data-recursion-play>Play</button></div>
  </footer>
</section>

<script>
  type Phase = 'ready' | 'call' | 'base' | 'return' | 'complete';
  type Step = { phase: Phase; active: number | null; reached: number[]; returned: number[]; stack: number[]; output: number; action: string; note: string };
  const steps: Step[] = [
    { phase: 'ready', active: null, reached: [], returned: [], stack: [], output: 0, action: 'Start with one question', note: 'Press Next. Follow calls down to the base case, then every return back to main.' },
    { phase: 'call', active: 3, reached: [3], returned: [], stack: [3], output: 1, action: 'Create the n = 3 frame', note: 'The base condition is false. This call prints once, then pauses while printNTimes(2) starts.' },
    { phase: 'call', active: 2, reached: [3, 2], returned: [], stack: [3, 2], output: 2, action: 'Create the n = 2 frame', note: 'A second frame gets its own n value. The n = 3 frame remains below it, waiting to resume.' },
    { phase: 'call', active: 1, reached: [3, 2, 1], returned: [], stack: [3, 2, 1], output: 3, action: 'Create the n = 1 frame', note: 'The same rule repeats: print once, reduce the input, and delegate the smaller problem.' },
    { phase: 'base', active: 0, reached: [3, 2, 1, 0], returned: [], stack: [3, 2, 1, 0], output: 3, action: 'Stop at the base case', note: 'n <= 0 is true. No child is created. This is the exact point where the tree stops growing.' },
    { phase: 'return', active: 1, reached: [3, 2, 1, 0], returned: [0], stack: [3, 2, 1], output: 3, action: 'Return to n = 1', note: 'The n = 0 frame disappears. Java resumes the newest waiting caller, which now finishes.' },
    { phase: 'return', active: 2, reached: [3, 2, 1, 0], returned: [0, 1], stack: [3, 2], output: 3, action: 'Return to n = 2', note: 'The stack unwinds in reverse order. n = 2 resumes only after n = 1 has completed.' },
    { phase: 'return', active: 3, reached: [3, 2, 1, 0], returned: [0, 1, 2], stack: [3], output: 3, action: 'Return to the first call', note: 'The original n = 3 frame becomes active again. Its recursive line is finished, so it returns.' },
    { phase: 'complete', active: null, reached: [3, 2, 1, 0], returned: [0, 1, 2, 3], stack: [], output: 3, action: 'All recursive work is complete', note: 'The tree records which calls existed. The empty stack confirms that every call returned.' },
  ];

  document.querySelectorAll<HTMLElement>('[data-recursion-lab]').forEach((lab) => {
    const q = <T extends HTMLElement>(selector: string) => lab.querySelector<T>(selector);
    const phase = q<HTMLElement>('[data-recursion-phase]'), action = q<HTMLElement>('[data-recursion-action]'), note = q<HTMLElement>('[data-recursion-note]');
    const stack = q<HTMLElement>('[data-recursion-stack]'), depth = q<HTMLElement>('[data-recursion-depth]'), output = q<HTMLElement>('[data-recursion-output]');
    const outputCount = q<HTMLElement>('[data-recursion-output-count]'), counter = q<HTMLElement>('[data-recursion-counter]'), progress = q<HTMLElement>('[data-recursion-progress]');
    const previous = q<HTMLButtonElement>('[data-recursion-previous]'), next = q<HTMLButtonElement>('[data-recursion-next]'), reset = q<HTMLButtonElement>('[data-recursion-reset]'), play = q<HTMLButtonElement>('[data-recursion-play]');
    if (!phase || !action || !note || !stack || !depth || !output || !outputCount || !counter || !progress || !previous || !next || !reset || !play) return;
    let current = 0, timer: number | undefined;
    const stop = () => { if (timer !== undefined) window.clearInterval(timer); timer = undefined; play.textContent = 'Play'; };
    const render = () => {
      const step = steps[current]; phase.textContent = step.phase.toUpperCase(); phase.dataset.phase = step.phase; action.textContent = step.action; note.textContent = step.note;
      counter.textContent = `Step ${current} of ${steps.length - 1}`; depth.textContent = `${step.stack.length} ${step.stack.length === 1 ? 'frame' : 'frames'}`;
      outputCount.textContent = `${step.output} ${step.output === 1 ? 'line' : 'lines'}`; output.textContent = step.output ? Array.from({ length: step.output }, (_, i) => `${i + 1}  Learning recursion`).join('\n') : 'Nothing printed yet';
      progress.style.transform = `scaleX(${current / (steps.length - 1)})`; previous.disabled = current === 0; next.disabled = current === steps.length - 1;
      lab.querySelectorAll<HTMLElement>('[data-tree-node]').forEach((node) => { const value = Number(node.dataset.treeNode); node.dataset.state = step.returned.includes(value) ? 'done' : step.active === value ? step.phase : step.reached.includes(value) ? 'waiting' : 'unseen'; });
      lab.querySelectorAll<HTMLElement>('[data-tree-edge]').forEach((edge) => { const value = Number(edge.dataset.treeEdge); edge.dataset.state = step.reached.includes(value - 1) ? (step.returned.includes(value - 1) ? 'done' : 'reached') : 'unseen'; });
      stack.replaceChildren();
      if (!step.stack.length) { const empty = document.createElement('p'); empty.textContent = current === steps.length - 1 ? 'Stack empty — back in main.' : 'No recursive calls yet.'; stack.append(empty); }
      else [...step.stack].reverse().forEach((value, index) => { const frame = document.createElement('div'); frame.className = index === 0 ? 'is-active' : 'is-waiting'; const label = document.createElement('span'); label.textContent = index === 0 ? 'RUNNING' : 'WAITING'; const code = document.createElement('code'); code.textContent = `printNTimes(${value})`; frame.append(label, code); stack.append(frame); });
      if (current === steps.length - 1) stop();
    };
    previous.addEventListener('click', () => { stop(); current = Math.max(0, current - 1); render(); }); next.addEventListener('click', () => { stop(); current = Math.min(steps.length - 1, current + 1); render(); }); reset.addEventListener('click', () => { stop(); current = 0; render(); });
    play.addEventListener('click', () => { if (timer !== undefined) { stop(); return; } if (current === steps.length - 1) current = 0; play.textContent = 'Pause'; render(); timer = window.setInterval(() => { current = Math.min(steps.length - 1, current + 1); render(); }, 1800); }); render();
  });
</script>

<style>
  .recursion-tree-lab { color: var(--text); background: var(--surface); }
  .recursion-tree-heading { display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:1.35rem 1.5rem;border-bottom:1px solid var(--line) }
  .recursion-tree-heading span,.recursion-panel-title span,.recursion-narration>span,.recursion-rule>span,.recursion-stack>div:first-child span,.recursion-output>div span { color:var(--amber);font:750 var(--type-technical) var(--font-mono);letter-spacing:.04em }
  .recursion-tree-heading h3 { margin:.3rem 0 0;font-size:clamp(1.45rem,3vw,2.25rem);line-height:1.08 }.recursion-tree-heading p{max-width:31rem;margin:0;color:var(--text-soft);font-size:.88rem;line-height:1.55;text-align:right}.recursion-tree-heading code{color:var(--green)}
  .recursion-stage{display:grid;grid-template-columns:minmax(31rem,1.25fr) minmax(21rem,.75fr);min-height:42rem}.recursion-tree-panel,.recursion-explain-panel{min-width:0;padding:1.2rem}.recursion-tree-panel{overflow-x:auto;background:color-mix(in srgb,var(--surface) 90%,var(--bg))}.recursion-explain-panel{border-left:1px solid var(--line);background:var(--surface-strong)}
  .recursion-panel-title,.recursion-panel-title>div,.recursion-stack>div:first-child,.recursion-output>div{display:flex;align-items:center;justify-content:space-between;gap:.65rem}.recursion-panel-title>div{justify-content:flex-start}.recursion-panel-title strong{font-size:.9rem}.recursion-panel-title small,.recursion-stack small,.recursion-output small{color:var(--text-faint);font:600 var(--type-technical) var(--font-mono)}
  .recursion-tree{display:grid;grid-template-columns:repeat(7,minmax(2.5rem,1fr));align-items:center;gap:.65rem;min-width:43rem;min-height:31rem;margin-top:1rem;padding:1.5rem;border:1px solid var(--line);border-radius:.75rem;background:var(--bg)}
  .tree-node{z-index:2;display:grid;gap:.2rem;min-width:8.5rem;padding:.85rem;border:1px solid var(--line-strong);border-radius:.65rem;background:var(--surface);opacity:.34;transform:scale(.96);transition:opacity 180ms ease,transform 180ms ease,border-color 180ms ease,background 180ms ease}.tree-node small{color:var(--text-faint);font:700 var(--type-technical) var(--font-mono)}.tree-node strong{font:750 .82rem var(--font-mono)}.tree-node span{color:var(--text-soft);font-size:.8rem}
  [data-tree-node='3']{grid-column:1/span 2;grid-row:1}[data-tree-edge='3']{grid-column:3;grid-row:1}[data-tree-node='2']{grid-column:4/span 2;grid-row:2}[data-tree-edge='2']{grid-column:3;grid-row:3}[data-tree-node='1']{grid-column:1/span 2;grid-row:4}[data-tree-edge='1']{grid-column:3;grid-row:4}[data-tree-node='0']{grid-column:4/span 2;grid-row:5}
  .tree-edge{display:grid;place-items:center;height:3.5rem;color:var(--text-faint);font:650 var(--type-technical) var(--font-mono);opacity:.25;transition:opacity 180ms ease,color 180ms ease}.tree-edge::before{position:absolute;width:3.3rem;border-top:1px solid currentColor;content:'';transform:rotate(24deg)}.tree-edge span{z-index:1;padding:.15rem .3rem;background:var(--bg)}
  .tree-node[data-state='waiting']{opacity:.78;transform:none}.tree-node[data-state='call'],.tree-node[data-state='base'],.tree-node[data-state='return']{border-color:var(--orange);background:color-mix(in srgb,var(--orange) 9%,var(--surface));opacity:1;transform:none}.tree-node[data-state='base']{border-color:var(--amber);background:color-mix(in srgb,var(--amber) 10%,var(--surface))}.tree-node[data-state='done']{border-color:var(--green);background:color-mix(in srgb,var(--green) 8%,var(--surface));opacity:.88;transform:none}.tree-edge[data-state='reached']{color:var(--orange);opacity:1}.tree-edge[data-state='done']{color:var(--green);opacity:.8}
  .recursion-tree-legend{display:flex;flex-wrap:wrap;gap:.65rem 1rem;margin-top:1rem}.recursion-tree-legend span{display:flex;align-items:center;gap:.35rem;color:var(--text-soft);font-size:.8rem}.recursion-tree-legend i{width:.55rem;height:.55rem;border:1px solid var(--line-strong);border-radius:50%}.recursion-tree-legend i.is-active{background:var(--orange)}.recursion-tree-legend i.is-waiting{background:var(--text-faint)}.recursion-tree-legend i.is-done{background:var(--green)}
  .recursion-narration{min-height:12.8rem;padding:1.5rem 0;border-bottom:1px solid var(--line)}.recursion-narration>span{display:inline-flex;padding:.3rem .48rem;border-radius:.35rem;background:color-mix(in srgb,var(--amber) 10%,transparent)}.recursion-narration>span[data-phase='call']{color:var(--orange)}.recursion-narration>span[data-phase='return'],.recursion-narration>span[data-phase='complete']{color:var(--green)}.recursion-narration h4{margin:.75rem 0 .5rem;font-size:1.35rem}.recursion-narration p,.recursion-rule p{margin:0;color:var(--text-soft);font-size:.86rem;line-height:1.65}
  .recursion-rule{padding:1.15rem 0;border-bottom:1px solid var(--line)}.recursion-rule code{display:block;margin:.55rem 0;color:var(--green);font-size:.86rem}.recursion-stack{padding:1.15rem 0;border-bottom:1px solid var(--line)}.recursion-stack>div:last-child{display:grid;gap:.4rem;margin-top:.75rem}.recursion-stack :global(div.is-active),.recursion-stack :global(div.is-waiting){display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.5rem .6rem;border:1px solid var(--line);border-radius:.45rem;background:var(--surface)}.recursion-stack :global(div.is-active){border-color:var(--orange)}.recursion-stack :global(div span){color:var(--text-faint);font:700 var(--type-technical) var(--font-mono)}.recursion-stack :global(div.is-active span){color:var(--orange)}.recursion-stack :global(code){color:var(--text);font-size:.8rem}.recursion-stack :global(p){margin:0;color:var(--text-faint);font-size:.82rem}
  .recursion-output{padding-top:1.1rem}.recursion-output pre{min-height:5rem;margin:.65rem 0 0!important;padding:.65rem!important;border-radius:.45rem!important;background:var(--bg)!important;color:var(--green);font-size:.8rem!important;line-height:1.65!important;box-shadow:none!important}.recursion-controls{display:grid;gap:.8rem;padding:1rem 1.2rem 1.1rem;border-top:1px solid var(--line)}.recursion-controls>div:last-child{display:flex;justify-content:flex-end;gap:.5rem}.recursion-controls button{min-height:2.65rem;padding:.55rem .8rem;border:1px solid var(--line-strong);border-radius:.5rem;background:var(--surface);color:var(--text);font:700 .8rem var(--font-body);cursor:pointer}.recursion-controls button.is-primary{border-color:var(--orange);background:var(--orange);color:#17130f}.recursion-controls button:disabled{opacity:.38;cursor:not-allowed}.recursion-controls button:focus-visible{outline:3px solid color-mix(in srgb,var(--orange) 38%,transparent);outline-offset:2px}.recursion-progress{height:.25rem;overflow:hidden;border-radius:999px;background:var(--line)}.recursion-progress i{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--orange),var(--green));transform:scaleX(0);transform-origin:left;transition:transform 180ms ease}
  @media(max-width:900px){.recursion-tree-heading{align-items:flex-start;flex-direction:column;gap:.5rem}.recursion-tree-heading p{text-align:left}.recursion-stage{grid-template-columns:1fr}.recursion-explain-panel{border-top:1px solid var(--line);border-left:0}}@media(max-width:560px){.recursion-tree-heading,.recursion-tree-panel,.recursion-explain-panel{padding:1rem}.recursion-controls>div:last-child{display:grid;grid-template-columns:1fr 1fr}.recursion-tree{min-height:28rem}}@media(prefers-reduced-motion:reduce){.tree-node,.tree-edge,.recursion-progress i{transition:none}}
</style>
