---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LearningDashboard from '../../components/LearningDashboard.astro';
---

<BaseLayout title="My Learning" description="Continue your saved learning path, articles, code drafts, bookmarks, revision topics and connected project progress." noindex>
  <section class="page-hero section-wrap">
    <Breadcrumbs items={[{ label: 'Atlas', href: '/' }, { label: 'My learning' }]} />
    <p class="section-index">LOCAL LEARNING DASHBOARD</p>
    <h1>Pick up where you stopped.</h1>
    <p>Your progress stays on this device. No account is required, and the rest of the Atlas works even when browser storage is unavailable.</p>
    <div class="learning-page-actions">
      <a class="button button-primary" href="/study-plan/">Create a personal study plan</a>
      <a class="button button-secondary" href="/revision/">Open revision centre</a>
    </div>
  </section>
  <LearningDashboard />
</BaseLayout>

<style>
  .learning-page-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.2rem; }
</style>
