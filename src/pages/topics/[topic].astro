---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConnectedProjectCard from '../../components/ConnectedProjectCard.astro';
import LearningEstimate from '../../components/LearningEstimate.astro';
import LearningGoals from '../../components/LearningGoals.astro';
import PostCard from '../../components/PostCard.astro';
import ProgressSummary from '../../components/ProgressSummary.astro';
import SectionSearch from '../../components/SectionSearch.astro';
import TopicBanner from '../../components/TopicBanner.astro';
import TopicCard from '../../components/TopicCard.astro';
import { DSA_SECTIONS, getLearningPath } from '../../data/learningPaths';
import { DSA_STARTER_SLUGS, LEARNING_GOALS } from '../../data/learningGoals';
import { TOPICS } from '../../data/site';
import { getPostSlug, getPostsForLearningSection, getPostsForSeries, getPostsForTopic } from '../../lib/posts';

export function getStaticPaths() {
  return TOPICS.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const allPosts = await getCollection('posts');
const posts = getPostsForTopic(allPosts, topic.slug);
const isDsa = topic.slug === 'dsa';
const isNotes = topic.slug === 'engineering-notes';
const curriculum = getLearningPath(topic.slug);
const difficultyLevels = ['basics', 'easy', 'medium', 'hard'] as const;
const hasGoal = LEARNING_GOALS.some((goal) => goal.topics.includes(topic.slug));
const startHerePosts = DSA_STARTER_SLUGS
  .map((slug) => allPosts.find((post) => !post.data.draft && getPostSlug(post) === slug))
  .filter((post) => Boolean(post));
const dsaDirectory = DSA_SECTIONS.map((section) => ({
  section,
  posts: getPostsForSeries(allPosts, section.slug),
}));
const unpublishedDsaSections = dsaDirectory.filter((item) => item.posts.length === 0);
// Keep each existing group anchor, but present all published subsections before the plan.
const curriculumGroups = curriculum?.groups.map((group) => ({
  group,
  sections: group.sections.map((section) => ({ section, posts: getPostsForLearningSection(allPosts, section.slug) })),
})) ?? [];
const curriculumBands = [
  { available: true, label: 'PUBLISHED AND AVAILABLE', description: 'Open a section with lessons you can read now.' },
  { available: false, label: 'PLANNED FOR LATER', description: 'These sections outline future coverage. Articles have not been published yet.' },
].map((band) => ({ ...band, groups: curriculumGroups.map(({ group, sections }) => ({
  group,
  id: !band.available && sections.some((item) => item.posts.length > 0) ? `${group.slug}-planned` : group.slug,
  sections: sections.filter((item) => (item.posts.length > 0) === band.available),
})).filter((item) => item.sections.length > 0) }));
const dsaDirectoryGroups = [
  {
    key: 'available',
    eyebrow: 'PUBLISHED AND AVAILABLE',
    title: 'Learn from articles you can open now',
    description: 'These sections already contain complete lessons or practice problems.',
    items: dsaDirectory.filter((item) => item.posts.length > 0),
  },
  {
    key: 'coming',
    eyebrow: 'COMING NEXT',
    title: 'The next sections being prepared',
    description: 'These topics are closest to the front of the publishing queue.',
    items: unpublishedDsaSections.slice(0, 3),
  },
  {
    key: 'planned',
    eyebrow: 'PLANNED FOR LATER',
    title: 'The complete DSA map',
    description: 'These sections remain visible so you can understand where the learning path is going.',
    items: unpublishedDsaSections.slice(3),
  },
];
---

<BaseLayout title={topic.title} description={topic.description}>
  <section class={`page-hero topic-hero banner-page-hero section-wrap track-${topic.accent}`}>
    <Breadcrumbs
      items={[
        { label: 'Atlas', href: '/' },
        { label: 'Learning tracks', href: '/topics/' },
        { label: topic.shortTitle },
      ]}
    />
    <TopicBanner
      topic={topic.slug}
      title={topic.title}
      label={`TRACK ${topic.number} / ${topic.meta}`}
      size="hero"
      heading="h1"
      eager
    />
    <div class="banner-page-intro">
      <p>{topic.description}</p>
      <a class="button button-primary" href={hasGoal ? '#choose-your-goal' : '#curriculum'}>
        {hasGoal ? 'Find your first lesson' : isNotes ? 'Browse note collections' : 'Browse sections'}
      </a>
    </div>
    <LearningEstimate {posts} label={`Time for available ${topic.shortTitle} lessons`} />
  </section>

  <LearningGoals posts={allPosts} topic={topic.slug} />

  {isDsa ? (
    <>
      <section class="dsa-start-here section-wrap" id="start-here">
        <div class="section-heading section-heading-notes">
          <div>
            <p class="section-index">START HERE / BEGINNER PATH</p>
            <h2>Six lessons that build on each other.</h2>
          </div>
          <p>This path begins with array mechanics, adds a few small problems, then introduces recursion before your first backtracking problem.</p>
        </div>
        <ol class="dsa-start-list">
          {startHerePosts.map((post, index) => post && (
            <li data-start-here-item data-post-slug={getPostSlug(post)}>
              <a href={`/posts/${getPostSlug(post)}/`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><strong>{post.data.title}</strong><small>{post.data.difficulty ?? 'basics'} · {post.data.contentType ?? 'concept'}</small></div>
                <i data-start-status>Not started</i>
              </a>
            </li>
          ))}
        </ol>
        <ProgressSummary postSlugs={startHerePosts.map((post) => post ? getPostSlug(post) : '').filter(Boolean)} label="Your progress on the beginner path" />
      </section>

      <nav class="dsa-learning-tools section-wrap" aria-label="DSA learning tools">
        <a href="/dsa/patterns/"><span>RECOGNIZE</span><strong>DSA Patterns</strong><small>Signals, invariants and linked practice</small></a>
        <a href="/dsa/revision/"><span>REVISE</span><strong>Revision Cards</strong><small>Print-friendly interview cheat sheets</small></a>
        <a href="/projects/production-url-shortener/"><span>CONNECT</span><strong>Connected Project</strong><small>Carry ideas from code into a production system</small></a>
      </nav>

      <section class="dsa-topic-tabs section-wrap" id="dsa-sections">
        <div class="section-heading section-heading-notes">
          <div>
            <p class="section-index">DSA TOPICS / {String(DSA_SECTIONS.length).padStart(2, '0')}</p>
            <h2>Choose a topic, then practice by difficulty.</h2>
          </div>
          <p>Published sections come first. Every section opens into separate Basics, Easy, Medium and Hard article lists.</p>
        </div>

        <SectionSearch
          placeholder="Search DSA topics, patterns, or data structures"
          scopeSelector="#dsa-topic-list"
          itemSelector=".topic-cover-card"
          itemLabel="topics"
        />

        <div class="dsa-directory-groups" id="dsa-topic-list">
          {dsaDirectoryGroups.map((directoryGroup) => directoryGroup.items.length > 0 && (
            <section class:list={['dsa-directory-group', `dsa-directory-${directoryGroup.key}`]} data-filter-group>
              <div class="dsa-directory-heading">
                <div><span>{directoryGroup.eyebrow}</span><h3>{directoryGroup.title}</h3></div>
                <p>{directoryGroup.description}</p>
              </div>
              <div class="topic-cover-grid">
                {directoryGroup.items.map(({ section, posts: sectionPosts }) => (
                  <TopicCard
                    topic="dsa"
                    section={section.slug}
                    title={section.title}
                    description={section.description}
                    href={`/dsa/${section.slug}/`}
                    label={`DSA / ${section.number}`}
                    count={sectionPosts.length}
                    keywords={section.topics}
                    levels={difficultyLevels.map((level) => ({
                      name: level,
                      count: sectionPosts.filter((post) => (post.data.difficulty ?? 'basics') === level).length,
                    }))}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    </>
  ) : curriculum ? (
    <>
      {['java', 'lld', 'system-design', 'cloud-native'].includes(topic.slug) && (
        <section class="topic-connected-project section-wrap"><ConnectedProjectCard compact /></section>
      )}
      {posts.length > 0 && (
        <section class="topic-posts topic-posts-curriculum section-wrap">
          <div class="section-heading section-heading-notes">
            <div><p class="section-index">AVAILABLE NOW / {String(posts.length).padStart(2, '0')}</p><h2>Articles you can read today.</h2></div>
          </div>
          <div class="post-grid">{posts.map((post) => <PostCard {post} />)}</div>
        </section>
      )}
      <section class={`curriculum-directory section-wrap track-${topic.accent}`} id="curriculum">
        <div class="section-heading">
          <div>
            <p class="section-index">{isNotes ? 'COLLECTIONS' : 'CURRICULUM'} / {String(curriculum.groups.length).padStart(2, '0')} SECTIONS</p>
            <h2>{isNotes ? 'Browse by engineering theme.' : 'Choose a section, then narrow the topic.'}</h2>
          </div>
          <p>{isNotes
            ? 'These collections give independent articles a predictable home without forcing them into a strict learning sequence. Every collection has its own article list and search.'
            : 'The curriculum is grouped so you can learn in order or jump directly to the concept you need. Every subsection has its own article list and search.'}</p>
        </div>

        <SectionSearch
          placeholder={`Search ${topic.title} ${isNotes ? 'collections and ideas' : 'sections and concepts'}`}
          scopeSelector="#curriculum-directory"
          itemSelector=".topic-cover-card"
          itemLabel="subsections"
        />

        <div class="curriculum-groups" id="curriculum-directory">
          {curriculumBands.map((band) => band.groups.length > 0 && (
            <section class:list={['curriculum-availability-band', { 'curriculum-future-band': !band.available }]} data-filter-group>
              <div class="curriculum-band-heading"><h3>{band.label}</h3><p>{band.description}</p></div>
              {band.groups.map(({ group, id, sections }) => (
            <section class="curriculum-group" id={id} data-filter-group>
              <div class="curriculum-group-heading">
                <span>{group.number}</span>
                <div><p>{group.title}</p><small>{group.description}</small></div>
                <i>{String(sections.length).padStart(2, '0')} SUBSECTIONS</i>
              </div>
              <div class="topic-cover-grid banner-subsection-grid">
                {sections.map(({ section, posts: sectionPosts }) => {
                  return (
                    <TopicCard
                      topic={topic.slug}
                      section={section.slug}
                      group={group.slug}
                      title={section.title}
                      description={section.description}
                      href={`/topics/${topic.slug}/${section.slug}/`}
                      label={`${group.number}.${section.number} / ${group.title}`}
                      count={sectionPosts.length}
                      keywords={section.topics}
                    />
                  );
                })}
              </div>
            </section>
              ))}
            </section>
          ))}
        </div>
      </section>

    </>
  ) : null}

  {isDsa && (
    <script>
    const START_PROGRESS_KEY = 'atlas-progress:v1';
    const progressLabels: Record<string, string> = {
      'not-started': 'Not started',
      attempted: 'Attempted',
      solved: 'Solved',
      revisit: 'Revisit',
    };

    const updateStartHere = () => {
      let progress: Record<string, string> = {};
      try {
        progress = JSON.parse(window.localStorage.getItem(START_PROGRESS_KEY) || '{}');
      } catch {
        progress = {};
      }
      document.querySelectorAll<HTMLElement>('[data-start-here-item]').forEach((item) => {
        const state = progress[item.dataset.postSlug || ''] || 'not-started';
        const status = item.querySelector<HTMLElement>('[data-start-status]');
        if (status) status.textContent = progressLabels[state] || 'Not started';
        item.dataset.learningState = state;
      });
    };

    updateStartHere();
    window.addEventListener('storage', updateStartHere);
    window.addEventListener('atlas-learning-state-changed', updateStartHere);
    </script>
  )}
</BaseLayout>

<style>
  .curriculum-availability-band { display: grid; gap: 2rem; }
  .curriculum-band-heading h3 { margin: 0; color: var(--amber); font-family: var(--font-mono); font-size: .8rem; letter-spacing: .06em; }
  .curriculum-band-heading p { margin: .4rem 0 0; color: var(--text-soft); font-size: .9rem; }
  .curriculum-future-band { border-top: 1px solid var(--line); padding-top: 2rem; }
  .curriculum-future-band :global(.topic-cover-card) { background: var(--bg-soft); }
  .dsa-start-here { padding-top: 4.5rem; }
  .dsa-learning-tools { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; padding-top: 1rem; }
  .dsa-learning-tools a { display: grid; gap: .3rem; padding: .85rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--surface); color: var(--text); }
  .dsa-learning-tools a:hover { border-color: var(--indigo); transform: translateY(-2px); }
  .dsa-learning-tools span { color: var(--amber); font-family: var(--font-mono); font-size: .5rem; letter-spacing: .08em; }
  .dsa-learning-tools strong { font-size: .78rem; }
  .dsa-learning-tools small { color: var(--text-faint); font-size: .58rem; line-height: 1.45; }
  .topic-connected-project { padding-top: 3rem; }
  .dsa-start-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dsa-start-list li { min-width: 0; }
  .dsa-start-list a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: .7rem;
    min-height: 5.2rem;
    padding: .8rem;
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .dsa-start-list a:hover { border-color: color-mix(in srgb, var(--indigo) 52%, var(--line)); transform: translateY(-2px); }
  .dsa-start-list a > span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--indigo) 12%, transparent); color: var(--indigo); font-family: var(--font-mono); font-size: .62rem; }
  .dsa-start-list div { display: grid; gap: .28rem; min-width: 0; }
  .dsa-start-list strong { font-size: .74rem; line-height: 1.35; }
  .dsa-start-list small { color: var(--text-faint); font-size: .58rem; text-transform: capitalize; }
  .dsa-start-list i { color: var(--text-faint); font-family: var(--font-mono); font-size: .52rem; font-style: normal; white-space: nowrap; }
  .dsa-start-list [data-learning-state='solved'] i { color: #21835f; }
  .dsa-directory-groups { display: grid; gap: 3rem; margin-top: 1.5rem; }
  .dsa-directory-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .dsa-directory-heading span { color: var(--amber); font-family: var(--font-mono); font-size: .57rem; font-weight: 650; letter-spacing: .1em; }
  .dsa-directory-heading h3 { margin: .3rem 0 0; font-size: 1.15rem; }
  .dsa-directory-heading p { max-width: 28rem; margin: 0; color: var(--text-faint); font-size: .72rem; line-height: 1.55; text-align: right; }
  .dsa-directory-coming,
  .dsa-directory-planned { opacity: .84; }
  .dsa-directory-planned { opacity: .68; }
  @media (max-width: 900px) { .dsa-start-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .dsa-start-here { padding-top: 3rem; }
    .dsa-start-list { grid-template-columns: 1fr; }
    .dsa-learning-tools { grid-template-columns: 1fr; }
    .dsa-directory-heading { align-items: start; flex-direction: column; }
    .dsa-directory-heading p { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .dsa-start-list a, .dsa-learning-tools a { transition: none; } .dsa-start-list a:hover, .dsa-learning-tools a:hover { transform: none; } }
</style>
