---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TopicCard from '../../components/TopicCard.astro';
import { TOPICS } from '../../data/site';
import { getPostsForTopic } from '../../lib/posts';

const posts = await getCollection('posts');
---

<BaseLayout
  title="Topics and Learning Paths"
  description="Explore structured paths across DSA, Java, low level design, system design, cloud native engineering and AI, plus independent engineering notes."
>
  <section class="page-hero section-wrap">
    <Breadcrumbs items={[{ label: 'Atlas', href: '/' }, { label: 'Topics' }]} />
    <p class="section-index">ATLAS / ALL ROUTES</p>
    <h1>Choose your route through software engineering.</h1>
    <p>
      Each track connects code-level decisions to system-level consequences. Start with the
      foundations or jump to the map you need today.
    </p>
  </section>

  <section class="topic-cover-directory section-wrap">
    <div class="topic-cover-grid topic-cover-grid--major">
    {TOPICS.map((topic) => {
      const topicPosts = getPostsForTopic(posts, topic.slug);
      return (
        <TopicCard
          topic={topic.slug}
          title={topic.title}
          description={topic.description}
          href={`/topics/${topic.slug}/`}
          label={`${topic.number} / ${topic.meta}`}
          count={topicPosts.length}
          heading="h2"
        />
      );
    })}
    </div>
  </section>
</BaseLayout>
