---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostCard from '../../../components/PostCard.astro';
import ProgressSummary from '../../../components/ProgressSummary.astro';
import SectionSearch from '../../../components/SectionSearch.astro';
import TopicBanner from '../../../components/TopicBanner.astro';
import { LEARNING_PATHS } from '../../../data/learningPaths';
import { getPostSlug, getPostsForLearningSection } from '../../../lib/posts';

export function getStaticPaths() {
  return LEARNING_PATHS.flatMap((path) =>
    path.groups.flatMap((group) =>
      group.sections.map((section) => ({
        params: { topic: path.slug, section: section.slug },
        props: { path, group, section },
      })),
    ),
  );
}

const { path, group, section } = Astro.props;
const allPosts = await getCollection('posts');
const posts = getPostsForLearningSection(allPosts, section.slug);
const isNotes = path.slug === 'engineering-notes';
const allSections = path.groups.flatMap((pathGroup) =>
  pathGroup.sections.map((pathSection) => ({ group: pathGroup, section: pathSection })),
);
const currentIndex = allSections.findIndex((item) => item.section.slug === section.slug);
const previous = currentIndex > 0 ? allSections[currentIndex - 1] : undefined;
const next = currentIndex < allSections.length - 1 ? allSections[currentIndex + 1] : undefined;
---

<BaseLayout title={`${section.title} — ${path.title}`} description={section.description}>
  <section class="page-hero curriculum-section-hero banner-page-hero section-wrap">
    <Breadcrumbs
      items={[
        { label: 'Atlas', href: '/' },
        { label: 'Learning paths', href: '/topics/' },
        { label: path.title, href: `/topics/${path.slug}/` },
        { label: group.title, href: `/topics/${path.slug}/#${group.slug}` },
        { label: section.title },
      ]}
    />
    <TopicBanner
      topic={path.slug}
      section={section.slug}
      group={group.slug}
      title={section.title}
      label={`${path.title} / ${group.title}`}
      size="hero"
      heading="h1"
      eager
    />
    <div class="banner-page-intro"><p>{section.description}</p></div>
    <div class="curriculum-section-summary">
      <span>{String(section.topics.length).padStart(2, '0')} planned {isNotes ? 'ideas' : 'concepts'}</span>
      <span>{String(posts.length).padStart(2, '0')} articles available</span>
      <a href={`/topics/${path.slug}/#${group.slug}`}>Back to {group.title} ↑</a>
    </div>
    {posts.length > 0 && <ProgressSummary postSlugs={posts.map(getPostSlug)} label={`Your progress in ${section.title}`} />}
  </section>

  <nav class="curriculum-local-nav section-wrap" aria-label={`${group.title} subsections`}>
    <span>{group.title}</span>
    <div>
      {group.sections.map((item) => (
        <a href={`/topics/${path.slug}/${item.slug}/`} aria-current={item.slug === section.slug ? 'page' : undefined}>{item.title}</a>
      ))}
    </div>
  </nav>

  <div class="section-search-wrap section-wrap">
    <SectionSearch
      placeholder={`Search inside ${section.title}`}
      scopeSelector="#curriculum-section-content"
      itemSelector="[data-curriculum-item]"
      itemLabel="results"
      showDifficulty
      showContentType
      showCompletion
    />
  </div>

  <div class="curriculum-section-content section-wrap" id="curriculum-section-content">
    {posts.length > 0 && (
      <section class="curriculum-available" data-filter-group>
        <div class="curriculum-content-heading">
          <div><p class="section-index">PUBLISHED AND AVAILABLE</p><h2>Start with articles you can read now</h2></div>
          <p>Published material appears first so you never have to search through placeholders before finding a lesson.</p>
        </div>
        <div class="post-grid">
          {posts.map((post) => (
            <div
              data-curriculum-item
              data-post-slug={getPostSlug(post)}
              data-filter-difficulty={post.data.difficulty ?? 'basics'}
              data-filter-content-type={post.data.contentType ?? 'concept'}
            ><PostCard {post} /></div>
          ))}
        </div>
      </section>
    )}

    <section class="curriculum-planned" data-filter-group>
      <div class="curriculum-content-heading">
        <div><p class="section-index">{isNotes ? 'PLANNED NOTES' : 'PLANNED FOR LATER'}</p><h2>Topics in this {isNotes ? 'collection' : 'subsection'}</h2></div>
        <p>{isNotes
          ? 'Each idea can become an independent deep dive. The collection keeps related investigations easy to find as the library grows.'
          : 'These concepts remain visible as a preview of the learning path, but they stay quieter than published articles.'}</p>
      </div>
      <div class="curriculum-concept-grid">
        {section.topics.map((topic, index) => (
          <article data-curriculum-item data-filter-content-type="planned">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><small>{isNotes ? 'PLANNED NOTE' : 'PLANNED CONCEPT'}</small><h3>{topic}</h3></div>
            <i aria-hidden="true">○</i>
          </article>
        ))}
      </div>
    </section>
  </div>

  <nav class="curriculum-pagination section-wrap" aria-label="Previous and next subsection">
    {previous ? (
      <a href={`/topics/${path.slug}/${previous.section.slug}/`}>
        <span>← PREVIOUS</span><strong>{previous.section.title}</strong><small>{previous.group.title}</small>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={`/topics/${path.slug}/${next.section.slug}/`}>
        <span>NEXT →</span><strong>{next.section.title}</strong><small>{next.group.title}</small>
      </a>
    ) : <span></span>}
  </nav>
</BaseLayout>
