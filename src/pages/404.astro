---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Map Not Found" description="This route does not exist in The System Design Atlas." noindex>
  <section class="not-found section-wrap">
    <div class="not-found-code">404</div>
    <p class="section-index">UNMAPPED TERRITORY</p>
    <h1>This route is not in the atlas.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <div>
      <a class="button button-primary" href="/">Return home</a>
      <a class="button button-secondary" href="/topics/">Browse learning topics</a>
    </div>
  </section>
</BaseLayout>
