---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LearningEstimate from '../../components/LearningEstimate.astro';
import TopicCard from '../../components/TopicCard.astro';
import { DSA_SECTIONS } from '../../data/learningPaths';
import { getPostsForSeries, getPostsForTopic } from '../../lib/posts';

const posts = await getCollection('posts');
const sections = DSA_SECTIONS.map((section) => ({ section, count: getPostsForSeries(posts, section.slug).length }));
const groups = [
  { title: 'Published and available', sections: sections.filter((item) => item.count > 0) },
  { title: 'Planned for later', sections: sections.filter((item) => item.count === 0) },
];
---

<BaseLayout title="DSA Topics" description="Explore the complete Java first DSA curriculum by data structure, pattern, and difficulty.">
  <section class="page-hero section-wrap">
    <Breadcrumbs items={[{ label: 'Atlas', href: '/' }, { label: 'DSA', href: '/topics/dsa/' }, { label: 'Topic directory' }]} />
    <p class="section-index">DSA / TOPIC DIRECTORY</p>
    <h1>Learn one pattern at a time.</h1>
    <p>Each section starts with the basic idea, then moves through patterns and practice problems grouped by difficulty.</p>
    <a class="button button-primary" href="/topics/dsa/#choose-your-goal">Find your first lesson</a>
    <LearningEstimate posts={getPostsForTopic(posts, 'dsa')} />
  </section>

  <section class="topic-cover-directory section-wrap">
    {groups.map((group) => group.sections.length > 0 && (
    <section class="directory-band" aria-label={group.title}>
    <h2>{group.title}</h2>
    <div class="topic-cover-grid">
    {group.sections.map(({ section, count }) => {
      return (
        <TopicCard
          topic="dsa"
          section={section.slug}
          title={section.title}
          description={section.description}
          href={`/dsa/${section.slug}/`}
          label={`DSA / ${section.number}`}
          {count}
          keywords={section.topics}
          heading="h3"
        />
      );
    })}
    </div>
    </section>
    ))}
  </section>
</BaseLayout>

<style>
  .directory-band + .directory-band { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .directory-band > h2 { font-size: 1.3rem; }
</style>
