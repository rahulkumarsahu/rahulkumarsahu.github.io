---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DsaArticleCard from '../../components/DsaArticleCard.astro';
import GraphTraversalSimulator from '../../components/GraphTraversalSimulator.astro';
import LearningEstimate from '../../components/LearningEstimate.astro';
import ProgressSummary from '../../components/ProgressSummary.astro';
import SectionSearch from '../../components/SectionSearch.astro';
import TopicBanner from '../../components/TopicBanner.astro';
import TreeTraversalSimulator from '../../components/TreeTraversalSimulator.astro';
import { DSA_SECTIONS } from '../../data/learningPaths';
import { getDsaPattern } from '../../data/dsaPatterns';
import { getPostSlug, getPostsForSeries } from '../../lib/posts';

export function getStaticPaths() {
  return DSA_SECTIONS.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const posts = getPostsForSeries(await getCollection('posts'), section.slug);
const availablePatterns = Array.from(new Set(posts.flatMap((post) => post.data.patterns ?? [])))
  .map((slug) => ({ value: slug, label: getDsaPattern(slug)?.name ?? slug }))
  .sort((a, b) => a.label.localeCompare(b.label));
const difficultyOrder = ['basics', 'easy', 'medium', 'hard'] as const;
const groups = difficultyOrder.map((difficulty) => ({
  difficulty,
  articles: posts.filter((post) => (post.data.difficulty ?? 'basics') === difficulty),
})).sort((a, b) => Number(b.articles.length > 0) - Number(a.articles.length > 0));
const groupCopy = {
  basics: ['01', 'Learn the idea', 'Build the mental model and learn the reusable implementation pattern.'],
  easy: ['02', 'Easy practice', 'Use the core idea in a direct problem with one main decision.'],
  medium: ['03', 'Medium practice', 'Combine the pattern with boundaries, state, or another technique.'],
  hard: ['04', 'Hard practice', 'Work through problems with less obvious invariants and tighter constraints.'],
};
---

<BaseLayout title={section.title} description={section.description}>
  <section class="page-hero dsa-section-hero banner-page-hero section-wrap">
    <Breadcrumbs items={[{ label: 'Atlas', href: '/' }, { label: 'DSA', href: '/topics/dsa/' }, { label: section.title }]} />
    <TopicBanner
      topic="dsa"
      section={section.slug}
      title={section.title}
      label={`DSA / SECTION ${section.number}`}
      size="hero"
      heading="h1"
      eager
    />
    <div class="banner-page-intro"><p>{section.description}</p></div>
    <div class="dsa-topic-pills">
      {section.topics.map((topic) => <span>{topic}</span>)}
    </div>
    <LearningEstimate {posts} />
    <ProgressSummary postSlugs={posts.map(getPostSlug)} label={`Your progress in ${section.title}`} />
    <div class="dsa-tool-links">
      <a href="/dsa/patterns/">Browse DSA patterns</a>
      <a href="/dsa/revision/">Open revision cards</a>
    </div>
  </section>

  {section.slug === 'trees' && <div class="section-wrap dsa-section-simulator"><TreeTraversalSimulator /></div>}
  {section.slug === 'graphs' && <div class="section-wrap dsa-section-simulator"><GraphTraversalSimulator /></div>}

  <div class="section-search-wrap section-wrap">
    <SectionSearch
      placeholder={`Search ${section.title} questions and concepts`}
      scopeSelector="#difficulty-list"
      itemSelector=".dsa-article-card"
      itemLabel="articles"
      showDifficulty
      showContentType
      showCompletion
      showPattern
      patterns={availablePatterns}
    />
  </div>

  <div class="difficulty-sections section-wrap" id="difficulty-list">
    {groups.map(({ difficulty, articles: matching }, index) => {
      const [, title, description] = groupCopy[difficulty];
      return (
        <section class="difficulty-section" data-filter-group>
          <div class="difficulty-heading">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h2>{title}</h2><p>{description}</p></div>
            <small>{String(matching.length).padStart(2, '0')} ARTICLES</small>
          </div>
          {matching.length ? (
            <div class="dsa-article-grid">{matching.map((post) => <DsaArticleCard {post} />)}</div>
          ) : (
            <div class="difficulty-empty">Starter articles for this level are in the publishing plan.</div>
          )}
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  .dsa-tool-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .dsa-tool-links a { padding: .48rem .65rem; border: 1px solid var(--line-strong); border-radius: .5rem; background: var(--surface); color: var(--text-soft); font-size: .64rem; font-weight: 650; }
  .dsa-tool-links a:hover { border-color: var(--indigo); color: var(--indigo); }
  .dsa-tool-links a:focus-visible { outline: 3px solid color-mix(in srgb, var(--indigo) 45%, transparent); outline-offset: 2px; }
  .dsa-section-simulator { padding-top: 2rem; }
</style>
