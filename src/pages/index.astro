---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TopicCard from '../components/TopicCard.astro';
import { SITE, TOPICS } from '../data/site';
import { getPostsForTopic, getSortedPosts } from '../lib/posts';

const posts = getSortedPosts(await getCollection('posts'));
const topicCounts = new Map(TOPICS.map((topic) => [topic.slug, getPostsForTopic(posts, topic.slug).length]));

const roadmap = [
  ['01', 'Complexity and foundations', 'Start here', '/dsa/complexity/'],
  ['02', 'Arrays', 'Core patterns', '/dsa/arrays/'],
  ['03', 'Hashing', 'Fast lookups', '/dsa/hashing/'],
  ['04', 'Binary search', 'Search space', '/dsa/binary-search/'],
  ['05', 'Recursion and trees', 'Relationships', '/dsa/recursion-backtracking/'],
  ['06', 'Graphs and dynamic programming', 'Optimization', '/dsa/graphs/'],
];
---

<BaseLayout title={SITE.name} description={SITE.description} image="/og.png">
  <section class="home-hero section-wrap">
    <div class="home-hero-copy">
      <div class="eyebrow-pill">
        <span class="status-dot"></span>
        Rahul's field notes for backend engineers
      </div>
      <p class="home-hero-kicker">FROM YOUR FIRST ARRAY TO PRODUCTION SYSTEMS</p>
      <h1>Learn the code. See the <span>system</span> behind it.</h1>
      <p class="home-hero-intro">
        I write practical guides on DSA, Java, system design, cloud native engineering and AI, along with deeper notes from real engineering work. We start with the basic idea, work through the implementation, and finish with the decisions that matter in a real system.
      </p>
      <div class="home-hero-actions">
        <a class="button button-primary" href="/topics/dsa/">
          Start with DSA
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-secondary" href="#learning-paths">See all topics</a>
      </div>
      <nav class="home-starting-points" aria-label="Popular starting points">
        <span>Popular starting points</span>
        <a href="/dsa/arrays/">Arrays</a>
        <a href="/dsa/binary-search/">Binary search</a>
        <a href="/posts/system-design-foundations/">System design basics</a>
      </nav>
      <dl class="home-hero-proof" aria-label="What the Atlas contains">
        <div><dt>{String(posts.length).padStart(2, '0')}</dt><dd>practical notes</dd></div>
        <div><dt>{String(TOPICS.length).padStart(2, '0')}</dt><dd>connected paths</dd></div>
        <div><dt>Java</dt><dd>first examples</dd></div>
      </dl>
    </div>

    <div class="atlas-hero-visual" aria-label="Rahul mapping the learning paths inside The System Design Atlas">
      <div class="atlas-board">
        <div class="atlas-board-bar">
          <span><i class="live-dot"></i> SYSTEM CARTOGRAPHER</span>
          <span>MAP 001</span>
        </div>
        <div class="atlas-board-stage">
          <div class="atlas-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="atlas-portrait-wrap">
            <img
              src="/images/rahul-system-cartographer.png"
              alt="An illustrated Rahul Kumar mapping a backend system on a blueprint"
              width="1047"
              height="1100"
              fetchpriority="high"
            />
            <div class="atlas-portrait-caption">
              <span>YOUR GUIDE</span>
              <strong>Rahul Kumar</strong>
              <small>Backend engineer · 8+ years</small>
            </div>
          </div>
          <nav class="atlas-route-list" aria-label="Topics and learning paths">
            {TOPICS.map((topic, index) => (
              <a href={`/topics/${topic.slug}/`} class={`atlas-route atlas-route-${topic.accent}`} style={`--route-delay: ${index * 100}ms`}>
                <span>{topic.number}</span>
                <strong>{topic.shortTitle}</strong>
                <i aria-hidden="true">↗</i>
              </a>
            ))}
          </nav>
          <div class="atlas-method-note">
            <span>THE ROUTE</span>
            <strong>idea → code → tradeoffs</strong>
          </div>
        </div>
        <div class="atlas-board-footer">
          <span>JAVA FIRST</span>
          <span>FROM FIRST PRINCIPLES</span>
          <span>BUILT FOR PRACTICE</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Topics covered">
    <div class="trust-track">
      <div class="trust-group">
        <span>DATA STRUCTURES</span><i>◆</i><span>JAVA</span><i>◆</i><span>LOW LEVEL DESIGN</span><i>◆</i><span>DISTRIBUTED SYSTEMS</span><i>◆</i><span>CLOUD NATIVE</span><i>◆</i><span>AI ENGINEERING</span><i>◆</i><span>ENGINEERING NOTES</span><i>◆</i>
      </div>
      <div class="trust-group" aria-hidden="true">
        <span>DATA STRUCTURES</span><i>◆</i><span>JAVA</span><i>◆</i><span>LOW LEVEL DESIGN</span><i>◆</i><span>DISTRIBUTED SYSTEMS</span><i>◆</i><span>CLOUD NATIVE</span><i>◆</i><span>AI ENGINEERING</span><i>◆</i><span>ENGINEERING NOTES</span><i>◆</i>
      </div>
    </div>
  </section>

  <section class="learning-method section-wrap" data-reveal>
    <div class="section-heading">
      <div><p class="section-index">01 / WHAT YOU WILL GET</p><h2>More than an answer that happens to pass.</h2></div>
      <p>The useful part is understanding why a solution works, when it stops working, and how the same idea appears again in larger systems.</p>
    </div>
    <div class="learning-method-grid">
      <article data-reveal style="--reveal-delay: 0ms">
        <span>01 / UNDERSTAND</span>
        <strong>Start with the idea</strong>
        <p>Plain explanations, visual dry runs and the pattern hiding underneath the problem.</p>
        <small>intuition · examples · edge cases</small>
      </article>
      <article data-reveal style="--reveal-delay: 90ms">
        <span>02 / BUILD</span>
        <strong>Write readable Java</strong>
        <p>Code you can follow line by line, with complexity analysis and common mistakes called out.</p>
        <small>java · complexity · alternatives</small>
      </article>
      <article data-reveal style="--reveal-delay: 180ms">
        <span>03 / CONNECT</span>
        <strong>Carry it into systems</strong>
        <p>See how small code choices turn into performance, reliability and scaling decisions.</p>
        <small>tradeoffs · failure · production</small>
      </article>
    </div>
  </section>

  <section class="tracks section-wrap" id="learning-paths" data-reveal>
    <div class="section-heading">
      <div><p class="section-index">02 / PATHS &amp; COLLECTIONS</p><h2>Pick the route you need today.</h2></div>
      <p>Follow a structured path or open a collection that matches the problem in front of you. You can always move between topics as your questions change.</p>
    </div>
    <div class="topic-cover-grid topic-cover-grid--major">
      {TOPICS.map((topic) => (
        <TopicCard
          topic={topic.slug}
          title={topic.title}
          description={topic.description}
          href={`/topics/${topic.slug}/`}
          label={`${topic.number} / ${topic.meta}`}
          count={topicCounts.get(topic.slug) ?? 0}
        />
      ))}
    </div>
  </section>

  <section class="roadmap section-wrap" id="roadmap" data-reveal>
    <div class="roadmap-panel">
      <div class="roadmap-copy">
        <p class="section-index">03 / A GOOD FIRST ROUTE</p>
        <div class="roadmap-chip">DSA · JAVA · STEP BY STEP</div>
        <h2>Build the instincts that make system design easier.</h2>
        <p>Start with how data is stored and accessed. Move through search, recursion and relationships. Those same instincts show up later in databases, caches and distributed systems.</p>
        <a class="text-link" href="/topics/dsa/">Open the complete DSA path <span>→</span></a>
      </div>
      <ol class="roadmap-list">
        {roadmap.map(([number, title, label, href], index) => (
          <li class={index === 0 ? 'is-active' : ''}>
            <a href={href}>
              <span class="roadmap-number">{number}</span>
              <div><strong>{title}</strong><small>{label}</small></div>
              <span class="roadmap-state">{index === 0 ? 'Begin' : '→'}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="notes section-wrap" id="notes" data-reveal>
    <div class="section-heading section-heading-notes">
      <div><p class="section-index">04 / LATEST FIELD NOTES</p><h2>Fresh notes from the Atlas.</h2></div>
      <a class="text-link" href="/topics/">Explore all topics <span>→</span></a>
    </div>
    <div class="post-grid home-post-grid">
      {posts.slice(0, 3).map((post) => <PostCard {post} />)}
    </div>
  </section>

  <section class="about section-wrap" id="about" data-reveal>
    <div class="about-card">
      <a class="about-photo" href="/about/" aria-label="About Rahul Kumar">
        <img src="/images/rahul-kumar.jpg" alt="Rahul Kumar" width="160" height="160" />
        <i aria-hidden="true"></i>
      </a>
      <div class="about-copy">
        <p class="section-index">05 / ABOUT ME</p>
        <h2>Hi, I’m Rahul. I build backend systems and write about what I learn along the way.</h2>
        <p>I’m a Senior Backend Engineer at JPMorgan Chase with more than eight years of experience. Most of my work has been around Java, Go, distributed systems, cloud platforms, and developer tooling. This blog is where I slow down and explain the ideas that have helped me in real projects.</p>
        <div class="about-links"><a href="/about/">About me ↗</a><a href={SITE.github}>GitHub ↗</a><a href={SITE.linkedin}>LinkedIn ↗</a></div>
      </div>
      <blockquote>“Writing helps me test whether I really understand something. This blog keeps that learning honest.”</blockquote>
    </div>
  </section>
</BaseLayout>
