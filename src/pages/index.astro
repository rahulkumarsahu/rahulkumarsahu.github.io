---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConnectedProjectCard from '../components/ConnectedProjectCard.astro';
import LearningGoals from '../components/LearningGoals.astro';
import LearningDashboard from '../components/LearningDashboard.astro';
import TopicCard from '../components/TopicCard.astro';
import WorkshopHero from '../components/WorkshopHero.astro';
import HorizontalRailControls from '../components/HorizontalRailControls.astro';
import { SITE, TOPICS } from '../data/site';
import { getPostSlug, getPostsForTopic, getSortedPosts } from '../lib/posts';

const posts = getSortedPosts(await getCollection('posts'));
const topicCounts = new Map(TOPICS.map((topic) => [topic.slug, getPostsForTopic(posts, topic.slug).length]));
---

<BaseLayout title={SITE.name} description={SITE.description} image="/og.png" bodyClass="home-page">
  <WorkshopHero {posts} />

  <LearningDashboard compact />

  <LearningGoals {posts} />

  <section class="tracks section-wrap" id="learning-paths" data-reveal aria-labelledby="learning-paths-title">
    <div class="section-heading section-heading-notes">
      <div>
        <p class="section-label">Explore by topic</p>
        <h2 id="learning-paths-title">Choose the engineering map you need.</h2>
      </div>
      <div class="section-heading-actions">
        <p>Each topic has its own learning structure, published articles and visual guides.</p>
        <HorizontalRailControls targetId="home-topic-rail" label="Engineering topics" />
      </div>
    </div>
    <div class="topic-cover-grid topic-cover-grid--major home-topic-rail" id="home-topic-rail" tabindex="0" aria-label="Engineering topics. Scroll horizontally for more.">
      {TOPICS.map((topic) => (
        <TopicCard
          topic={topic.slug}
          title={topic.title}
          description={topic.description}
          href={`/topics/${topic.slug}/`}
          label={`${topic.number} / ${topic.meta}`}
          count={topicCounts.get(topic.slug) ?? 0}
          postSlugs={getPostsForTopic(posts, topic.slug).map(getPostSlug)}
        />
      ))}
    </div>
  </section>

  <section class="home-connected-project section-wrap" data-reveal>
    <ConnectedProjectCard />
  </section>
</BaseLayout>
