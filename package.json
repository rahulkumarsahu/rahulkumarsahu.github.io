{
  "name": "the-system-design-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check:content": "node scripts/check-content-quality.mjs",
    "check:master-sheet": "node --experimental-strip-types scripts/check-master-sheet.mjs",
    "check:java": "node scripts/check-java-solutions.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:banners": "node scripts/check-article-banners.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "prebuild": "npm run check:content && npm run check:master-sheet && npm run check:java",
    "build": "astro build",
    "postbuild": "npm run check:seo && npm run check:banners && npm run check:links && npm run check:accessibility",
    "validate": "npm run build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.4"
  }
}
